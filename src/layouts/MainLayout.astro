---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import { getLocaleFromPath } from "../lib/i18n";
const {
  title,
  description,
  pathname = Astro.url.pathname,
  noindex = false,
  jsonLd = [] as unknown[],
} = Astro.props;
const locale = getLocaleFromPath(pathname);
---

<!doctype html>
<html lang={locale === "sl" ? "sl-SI" : "en-GB"}>
  <head><SeoHead {title} {description} {pathname} {noindex} jsonLd={jsonLd} /><slot name="head" /></head><body
    ><a class="skip-link" href="#main"
      >{locale === "sl" ? "Preskoči na vsebino" : "Skip to content"}</a
    ><Header {locale} pathname={pathname} /><main id="main">
      <slot />
    </main><Footer {locale} /></body>
</html>
