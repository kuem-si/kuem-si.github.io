---
import { Font } from "astro:assets";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { SITE, type Locale } from "../config/site";
import { getNavItems, type RouteId } from "../config/routes";
import {
  toAbsoluteUrl,
  generateBreadcrumbLd,
  generateWebsiteLd,
  generateOrganizationLd,
  generateWebPageLd,
  generateServiceLd,
} from "../lib/seo";
import "../styles/global.css";

interface Props {
  locale: Locale;
  routeId: RouteId;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePaths: Record<Locale, string>;
}

const { locale, routeId, title, description, canonicalPath, alternatePaths } =
  Astro.props;
const navItems = getNavItems(locale);
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const ogLocale = locale === "sl" ? "sl_SI" : "en_US";
const ogImageUrl = toAbsoluteUrl("/og-image.png");

const webPageLd = generateWebPageLd(
  routeId,
  locale,
  title,
  description,
  canonicalUrl,
);
const serviceLd = generateServiceLd(routeId, locale, canonicalUrl);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f3f7ff" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("kuem-theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <meta name="view-transition" content="same-origin" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />
    <link
      rel="llms"
      type="text/plain"
      title="LLMs content guide"
      href={toAbsoluteUrl("/llms.txt")}
    />
    <link
      rel="llms-full"
      type="text/plain"
      title="LLMs full content"
      href={toAbsoluteUrl("/llms-full.txt")}
    />
    {
      (Object.entries(alternatePaths) as [Locale, string][]).map(
        ([localeCode, path]) => (
          <link
            rel="alternate"
            hreflang={localeCode}
            href={toAbsoluteUrl(path)}
          />
        ),
      )
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={toAbsoluteUrl(alternatePaths.sl)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <Font cssVariable="--font-space-grotesk" preload />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(generateOrganizationLd())}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(generateWebsiteLd(locale))}
    />
    <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(generateBreadcrumbLd(routeId, locale))}
    />
    {
      serviceLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(serviceLd)}
        />
      )
    }
  </head>
  <body>
    <div class="background-glow" aria-hidden="true"></div>
    <header class="site-header">
      <a
        class="brand"
        href={locale === "sl" ? "/" : "/en/"}
        data-astro-prefetch="hover">KUEM</a
      >
      <nav class="desktop-nav" aria-label="Main navigation">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-active={item.id === routeId}
                  data-astro-prefetch="hover"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <details class="mobile-nav">
        <summary
          aria-label={locale === "sl" ? "Odpri glavni meni" : "Open main menu"}
        >
          <span class="hamburger-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </summary>
        <nav aria-label={locale === "sl" ? "Mobilna navigacija" : "Mobile navigation"}>
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-active={item.id === routeId}
                    data-astro-prefetch="hover"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
      <button
        class="theme-toggle"
        type="button"
        aria-label={locale === "sl" ? "Vklopi temni način" : "Switch to dark mode"}
        aria-pressed="false"
      >
        <span class="theme-toggle-track" aria-hidden="true">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
          </svg>
          <span class="theme-toggle-thumb"></span>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24">
            <path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z"></path>
          </svg>
        </span>
        <span class="sr-only">{locale === "sl" ? "Tema" : "Theme"}</span>
      </button>
      <LanguageSwitcher locale={locale} routeId={routeId} />
    </header>

    <script>
      const mobileMenu = document.querySelector(".mobile-nav");
      const themeToggle = document.querySelector(".theme-toggle");
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const applyTheme = (theme) => {
        const isDark = theme === "dark";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        themeColor?.setAttribute("content", isDark ? "#071225" : "#f3f7ff");
        if (themeToggle instanceof HTMLButtonElement) {
          themeToggle.setAttribute("aria-pressed", String(isDark));
          themeToggle.setAttribute(
            "aria-label",
            isDark
              ? themeToggle.dataset.lightLabel || "Switch to light mode"
              : themeToggle.dataset.darkLabel || "Switch to dark mode",
          );
        }
      };

      if (themeToggle instanceof HTMLButtonElement) {
        themeToggle.dataset.darkLabel = document.documentElement.lang === "sl" ? "Vklopi temni način" : "Switch to dark mode";
        themeToggle.dataset.lightLabel = document.documentElement.lang === "sl" ? "Vklopi svetli način" : "Switch to light mode";
        applyTheme(document.documentElement.dataset.theme || "light");
        themeToggle.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          localStorage.setItem("kuem-theme", next);
          applyTheme(next);
        });
      }

      document.addEventListener("click", (event) => {
        if (
          mobileMenu instanceof HTMLDetailsElement &&
          mobileMenu.open &&
          event.target instanceof Node &&
          !mobileMenu.contains(event.target)
        ) {
          mobileMenu.open = false;
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && mobileMenu instanceof HTMLDetailsElement) {
          mobileMenu.open = false;
        }
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.legalName}</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </footer>
  </body>
</html>
