---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import { getLocaleFromPath, localeTags } from "../lib/i18n";
const {
  title,
  description,
  pathname = Astro.url.pathname,
  noindex = false,
  jsonLd = [] as unknown[],
  bodyClass,
} = Astro.props;
const locale = getLocaleFromPath(pathname);
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head><SeoHead {title} {description} {pathname} {noindex} jsonLd={jsonLd} /><slot name="head" /></head><body
    class={bodyClass}
    ><a class="skip-link" href="#main"
      >{
        {
          sl: "Preskoči na vsebino",
          en: "Skip to content",
          de: "Zum Inhalt springen",
        }[locale]
      }</a
    ><Header {locale} pathname={pathname} /><main id="main">
      <slot />
    </main><Footer {locale} /><slot name="after" /></body>
</html>
