---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="404 – Stran ni najdena / Page not found"
  description="Zahtevana stran ne obstaja. The requested page does not exist."
  noindex={true}
  ><section class="hero">
    <div class="container">
      <p class="eyebrow">404</p><h1>
        Pot se tu prekine.<br />The path ends here.
      </h1><p class="lead">
        Stran ne obstaja ali je bila premaknjena. The page does not exist or has
        moved.
      </p><div class="actions">
        <a class="btn btn-primary" href="/">Slovensko</a><a
          class="btn btn-secondary"
          href="/en/">English</a>
      </div>
    </div>
  </section></MainLayout
>
