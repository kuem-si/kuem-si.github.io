---
import MainLayout from "../layouts/MainLayout.astro";
import FeatureList from "../components/FeatureList.astro";
---

<MainLayout
  title="About KUEM"
  description="KUEM digitalizes infrastructure, field data, remote reading, monitoring and integrations with its own Nexavia platform."
>
  <section class="hero">
    <div class="container split">
      <div>
        <p class="eyebrow">Company</p>
        <h1>About KUEM</h1>
        <p>
          KUEM is a company for digitalization of infrastructure, field data,
          remote reading, monitoring and integrations. The company develops and
          implements solutions for municipalities, public utilities, industry,
          energy and public buildings.
        </p>
      </div>
      <article class="panel">
        <h2>How KUEM works</h2>
        <FeatureList
          items={[
            "Own Nexavia platform",
            "Field implementation and communication infrastructure",
            "Integrations with existing systems",
            "Work from concept to production",
          ]}
        />
      </article>
    </div>
  </section>
</MainLayout>
