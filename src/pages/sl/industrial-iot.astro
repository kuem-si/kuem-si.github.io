---
import MainLayout from "../../layouts/MainLayout.astro";
import CTASection from "../../components/CTASection.astro";
---

<MainLayout
  title="Industrijski IoT | KUEM"
  description="Industrijske IoT rešitve za operativno učinkovitost, zanesljivost in merljive rezultate."
>
  <section class="hero">
    <div class="container split">
      <div>
        <p class="eyebrow">Rastoči segment</p>
        <h1>Industrijski IoT osredotočen na operativno učinkovitost.</h1>
        <p>
          KUEM izvaja pragmatične IoT projekte za industrijska okolja, kjer so
          zanesljivost, izkoristek virov in skladnost ključni.
        </p>
      </div>
      <div class="panel">
        <h2>Obseg, usmerjen v rezultate</h2>
        <ul>
          <li>Zmanjšanje energetske potrate in obratovalnih stroškov</li>
          <li>Zgodnejše zaznavanje neobičajnih stanj</li>
          <li>Izboljšano planiranje vzdrževanja</li>
          <li>Podpora poročanju za skladnost</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="container grid-3">
      <article class="card">
        <h2>Nadzor temperature</h2>
        <p>
          Sledenje kritičnim temperaturnim razponom v objektih, procesnih
          linijah in skladiščih.
        </p>
      </article>
      <article class="card">
        <h2>Nadzor energije</h2>
        <p>
          Zajem porabe energije v realnem času za prepoznavo neučinkovitosti in
          odstopanj obremenitev.
        </p>
      </article>
      <article class="card">
        <h2>Okoljski senzorji</h2>
        <p>
          Nadzor vlage, kakovosti zraka in sorodnih metrik za operativne in
          regulatorne zahteve.
        </p>
      </article>
      <article class="card">
        <h2>Sledenje sredstvom</h2>
        <p>
          Lokacija mobilne opreme in orodij za boljši izkoristek ter manj
          iskanja in nadomeščanj.
        </p>
      </article>
      <article class="card">
        <h2>Prilagojeni IoT projekti</h2>
        <p>
          Priprava telemetrije in analitike po meri za specializirane operativne
          scenarije.
        </p>
      </article>
      <article class="card">
        <h2>Integracija in poročanje</h2>
        <p>
          Povezava podatkov v BI sisteme, vzdrževalno programsko opremo in
          poslovne procese.
        </p>
      </article>
    </div>
  </section>

  <CTASection
    title="Ocenite industrijski primer uporabe"
    description="Delite omejitve lokacije in KPI-je. KUEM bo predlagal fazni načrt izvedbe."
    ctaHref="/sl/contact#contact-form"
    ctaText="Kontaktirajte nas"
  />
</MainLayout>
