---
import MainLayout from "../../layouts/MainLayout.astro";
import CTASection from "../../components/CTASection.astro";
---

<MainLayout
  title="Platforma Nexavia | KUEM"
  description="Nexavia je KUEM platforma za upravljanje naprav, analitiko, integracije in varne možnosti uvedbe."
>
  <section class="hero">
    <div class="container split">
      <div>
        <p class="eyebrow">Pozicioniranje platforme</p>
        <h1>
          Nexavia: ena platforma za komunalne in infrastrukturne IoT operacije.
        </h1>
        <p>
          Nexavia predstavlja tehnično jedro za zanesljiv zajem telemetrije,
          operativno analitiko in integracijo v poslovne sisteme.
        </p>
      </div>
      <aside class="panel">
        <h2>Možnosti namestitve</h2>
        <ul>
          <li>KUEM upravljana oblačna izvedba</li>
          <li>Lokalna namestitev za regulirana okolja</li>
          <li>Hibridna arhitektura z razmejenimi obremenitvami</li>
        </ul>
      </aside>
    </div>
  </section>

  <section>
    <div class="container grid-2">
      <article class="card">
        <h2>Upravljanje naprav</h2>
        <p>
          Vključevanje, konfiguracija, spremljanje zdravja in upravljanje
          življenjskega cikla velikih flot naprav.
        </p>
      </article>
      <article class="card">
        <h2>Podpora več tehnologijam</h2>
        <p>
          NB-IoT, LoRaWAN in gateway naprave upravljane prek enotnega
          platformnega vmesnika.
        </p>
      </article>
      <article class="card">
        <h2>Analitika</h2>
        <p>
          Obdelava dogodkov, pragovi, trendna analiza in KPI pogledi za
          komunalne in operativne ekipe.
        </p>
      </article>
      <article class="card">
        <h2>API integracije</h2>
        <p>
          REST API-ji in izvozni poteki za SCADA, obračun, ERP, vzdrževanje in
          BI sisteme.
        </p>
      </article>
    </div>
  </section>

  <CTASection
    title="Preverite Nexavio v svoji arhitekturi"
    description="KUEM lahko preslika Nexavio na vaše podatkovne, varnostne in integracijske zahteve."
    ctaHref="/sl/contact#contact-form"
    ctaText="Kontaktirajte nas"
  />
</MainLayout>
