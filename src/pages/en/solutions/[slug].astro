---
import SolutionPage from "../../../components/SolutionPage.astro";
import SolutionDetailPage from "../../../components/SolutionDetailPage.astro";
import { solutions } from "../../../data/site";
import {
  solutionDetailSlugs,
  type SolutionDetailKey,
} from "../../../data/solutionDetails";

interface Props {
  kind: "category" | "detail";
  solution?: (typeof solutions.en)[number];
  solutionKey?: SolutionDetailKey;
}

export function getStaticPaths() {
  return [
    ...solutions.en.map((solution) => ({
      params: { slug: solution.slug },
      props: { kind: "category", solution } satisfies Props,
    })),
    ...solutionDetailSlugs.map(({ key, en }) => ({
      params: { slug: en },
      props: { kind: "detail", solutionKey: key } satisfies Props,
    })),
  ];
}

const { kind, solution, solutionKey } = Astro.props as Props;
---

{
  kind === "detail" ? (
    <SolutionDetailPage locale="en" solutionKey={solutionKey} />
  ) : (
    <SolutionPage locale="en" solution={solution!} />
  )
}
