---
import LegacyRedirect from "../../components/LegacyRedirect.astro";
import { legacyEnglishRedirects } from "../../data/legacyEnglishRedirects";
// LegacyRedirect supplies the document; no automatically injected page scripts.
export const partial = true;
export function getStaticPaths() {
  return Object.entries(legacyEnglishRedirects).map(([legacy, target]) => ({
    params: { legacy },
    props: { target },
  }));
}
const { target } = Astro.props;
---

<LegacyRedirect {target} locale="en" />
