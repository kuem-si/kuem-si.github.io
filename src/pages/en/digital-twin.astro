---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/digital-twin.css";

const buildings = [
  {
    id: "BLDG_01",
    name: "City hall",
    x: 180,
    y: 238,
    w: 150,
    h: 112,
    depth: 35,
    tone: "civic",
  },
  {
    id: "BLDG_02",
    name: "Office building",
    x: 440,
    y: 192,
    w: 150,
    h: 158,
    depth: 35,
    tone: "office",
  },
  {
    id: "BLDG_03",
    name: "Apartment building",
    x: 700,
    y: 226,
    w: 150,
    h: 124,
    depth: 35,
    tone: "home",
  },
];
---

<MainLayout
  title="City digital twin | KUEM"
  description="Interactive concept of a mini city connected to a Nexavia dashboard."
  noindex
>
  <div class="twin-page" data-twin-root>
    <div class="twin-intro">
      <div>
        <p class="twin-path">
          <a href="/en/nexavia/">Nexavia</a> <span aria-hidden="true">/</span>{" "}
          Digital twin concept
        </p>
        <h1>A city that shows what is happening in its data.</h1>
        <p class="twin-lead">
          A conceptual model connects three buildings, a light sensor and a
          gateway to a dashboard. When lighting changes, the same event appears
          in Nexavia.
        </p>
      </div>
      <div class="twin-intro-note">
        <strong>Interactive concept</strong>
        <span>Simulated data · no connected devices</span>
      </div>
    </div>

    <section class="twin-workspace" aria-label="Digital twin and dashboard">
      <div class="twin-city-panel">
        <div class="twin-panel-head">
          <div>
            <h2>Mini city</h2>
            <p>Isometric view · select a building to change it manually</p>
          </div>
          <span class="twin-live">
            <span></span> Simulation running
          </span>
        </div>
        <div class="twin-scene-wrap">
          <svg
            class="twin-scene"
            viewBox="0 0 1040 575"
            role="img"
            aria-labelledby="city-title city-desc"
          >
            <title id="city-title">Conceptual mini city with three buildings</title>
            <desc id="city-desc">
              Three buildings beside a road. Illuminated windows change with the
              data on the dashboard.
            </desc>
            <defs>
              <pattern
                id="ground-dots"
                width="24"
                height="24"
                patternUnits="userSpaceOnUse"
              >
                <circle cx="2" cy="2" r="1" fill="#d2dde8" />
              </pattern>
              <filter
                id="window-glow"
                x="-120%"
                y="-120%"
                width="340%"
                height="340%"
              >
                <feGaussianBlur stdDeviation="6" />
              </filter>
            </defs>
            <rect width="1040" height="575" fill="#eaf1f6" />
            <rect width="1040" height="575" fill="url(#ground-dots)" />
            <path d="M0 385 L1040 385 L1040 492 L0 492 Z" fill="#c3d1dd" />
            <path
              d="M0 396 H1040 M0 482 H1040"
              stroke="#aebfce"
              stroke-width="2"
            />
            <path
              d="M25 440 H1015"
              stroke="#f8fbfd"
              stroke-width="3"
              stroke-dasharray="24 18"
            />
            <path
              d="M100 395 L100 483 M365 395 L365 483 M625 395 L625 483 M895 395 L895 483"
              stroke="#e8f0f5"
              stroke-width="2"
            />
            <path
              class="twin-telemetry-path"
              d="M90 150 C185 128 302 126 400 115 S610 117 715 95 S894 105 958 150"
              fill="none"
              stroke="#55a6d7"
              stroke-width="2"
              stroke-dasharray="6 8"
            />
            <circle class="twin-packet" r="5" fill="#1685c2">
              <animateMotion
                dur="6s"
                repeatCount="indefinite"
                path="M90 150 C185 128 302 126 400 115 S610 117 715 95 S894 105 958 150"
              />
            </circle>
            {buildings.map((b) => (
              <g
                class="twin-building"
                data-building={b.id}
                tabindex="0"
                role="button"
                aria-label={`${b.name}: change lighting`}
              >
                <path
                  d={`M${b.x} ${b.y} l${b.depth} -22 h${b.w} l-${b.depth} 22 Z`}
                  class="twin-roof"
                />
                <path
                  d={`M${b.x + b.w} ${b.y} l${b.depth} -22 v${b.h} l-${b.depth} 22 Z`}
                  class="twin-side"
                />
                <rect
                  x={b.x}
                  y={b.y}
                  width={b.w}
                  height={b.h}
                  rx="2"
                  class={`twin-front twin-${b.tone}`}
                />
                {[0, 1, 2].map((row) =>
                  [0, 1, 2, 3].map((col) => (
                    <rect
                      class="twin-window"
                      x={b.x + 17 + col * 31}
                      y={b.y + 17 + row * 28}
                      width="18"
                      height="14"
                      rx="2"
                    />
                  )),
                )}
                <rect
                  x={b.x + 63}
                  y={b.y + b.h - 30}
                  width="26"
                  height="30"
                  fill="#536b80"
                />
                <path
                  d={`M${b.x - 8} ${b.y + b.h + 2} h${b.w + 44}`}
                  stroke="#b9c9d7"
                  stroke-width="5"
                />
                <text
                  x={b.x + b.w / 2}
                  y={b.y + b.h + 31}
                  text-anchor="middle"
                  class="twin-svg-label"
                >
                  {b.name}
                </text>
                <circle
                  cx={b.x + b.w - 6}
                  cy={b.y - 10}
                  r="7"
                  class="twin-building-indicator"
                />
              </g>
            ))}
            <g class="twin-sensor">
              <path d="M95 362 v-83" stroke="#536e81" stroke-width="6" />
              <circle cx="95" cy="275" r="13" fill="#1685c2" />
              <circle cx="95" cy="275" r="5" fill="white" />
              <text x="95" y="258" text-anchor="middle" class="twin-svg-label">
                Light sensor
              </text>
            </g>
            <g>
              <path d="M958 361 v-82" stroke="#536e81" stroke-width="6" />
              <rect
                x="941"
                y="258"
                width="34"
                height="29"
                rx="5"
                fill="#264963"
              />
              <circle cx="958" cy="273" r="5" fill="#56c59b" />
              <text x="958" y="248" text-anchor="middle" class="twin-svg-label">
                Gateway GW_01
              </text>
            </g>
            <path d="M0 528 H1040" stroke="#d2dfe8" />
            <text x="28" y="552" class="twin-svg-caption">
              CONCEPTUAL LAYOUT · NOT A PHYSICAL MODEL
            </text>
          </svg>
        </div>
        <div class="twin-controls">
          <button type="button" id="twin-pause" aria-pressed="false">
            Pause
          </button>
          <button type="button" id="twin-next">
            Next event
          </button>
          <span id="twin-step" aria-live="polite">
            Sensor is reading ambient light
          </span>
        </div>
      </div>
      <aside class="twin-dashboard" aria-label="Nexavia dashboard simulation">
        <div class="twin-dashboard-top">
          <div class="twin-brand">
            NEXAVIA <span>by KUEM</span>
          </div>
          <span class="twin-demo-pill">DEMO DATA</span>
        </div>
        <div class="twin-dashboard-body">
          <div class="twin-dashboard-heading">
            <div>
              <h2>Device overview</h2>
              <p>Mini city · 3 svetlobni tokokrogi</p>
            </div>
            <span class="twin-sync">● Synchronized</span>
          </div>
          <div class="twin-kpis">
            <div>
              <span>Active devices</span>
              <strong id="twin-active">0 / 3</strong>
              <small>Simulated outputs</small>
            </div>
            <div>
              <span>Total power</span>
              <strong id="twin-power">0 W</strong>
              <small>Calculated from light status</small>
            </div>
            <div>
              <span>Ambient light</span>
              <strong id="twin-lux">46 lx</strong>
              <small>Senzor LIGHT_01</small>
            </div>
          </div>
          <div class="twin-rule">
            <span class="twin-rule-icon">i</span>
            <div>
              <strong>Rule: light &lt; 25 lx</strong>
              <p id="twin-rule-status">Waiting for next reading</p>
            </div>
          </div>
          <div class="twin-table-heading">
            <h3>Building status</h3>
            <span>Real-time updates*</span>
          </div>
          <div
            class="twin-table"
            role="table"
            aria-label="Building lighting status"
          >
            <div class="twin-tr twin-th" role="row">
              <span role="columnheader">Device</span>
              <span role="columnheader">Status</span>
              <span role="columnheader">Power</span>
            </div>
            {buildings.map((b) => (
              <div class="twin-tr" role="row" data-row={b.id}>
                <span role="cell">
                  <b>{b.name}</b>
                  <small>{b.id}</small>
                </span>
                <span role="cell" class="twin-state">
                  Off
                </span>
                <span role="cell" class="twin-watts">
                  0 W
                </span>
              </div>
            ))}
          </div>
          <div class="twin-event">
            <h3>Latest event</h3>
            <p id="twin-event">Waiting for a data event …</p>
            <small>
              *Real time within this simulation. Not connected to a live Nexavia
              system.
            </small>
          </div>
        </div>
      </aside>
    </section>
    <p class="twin-footnote">
      This page is a prototype for a possible display model. Values and events
      are simulated; the physical setup and Nexavia connection will be defined
      later.
    </p>
  </div>
  <script src="../../digital-twin/index.js"></script>
</MainLayout>
