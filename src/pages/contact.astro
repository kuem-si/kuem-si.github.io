---
import MainLayout from "../layouts/MainLayout.astro";
import LeadForm from "../components/LeadForm.astro";
---

<MainLayout
  title="Contact us | KUEM"
  description="Contact KUEM to book a presentation or send an inquiry about remote reading, infrastructure monitoring, alarms, dashboards, reports and integrations."
>
  <section class="hero">
    <div class="container split">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Contact us</h1>
        <p>
          Do you have a project for remote reading or infrastructure monitoring?
        </p>
        <div style="display:flex; gap:.75rem; margin-top:1rem; flex-wrap:wrap;">
          <a class="btn btn-primary" href="#contact-form">Book a presentation</a
          >
          <a class="btn btn-secondary" href="#contact-form">Send an inquiry</a>
        </div>
      </div>
      <article class="panel">
        <h2>Direct contact</h2>
        <p>Email: <a href="mailto:info@kuem.eu">info@kuem.eu</a></p>
        <p>Phone: <a href="tel:+38659013416">0038659013416</a></p>
        <p>Address: Ljubljanska cesta 24g, 4000 Kranj, Slovenia</p>
      </article>
    </div>
  </section>

  <section id="contact-form">
    <div class="container">
      <LeadForm
        formId="contact-form"
        heading="Send an inquiry"
        submitLabel="Send inquiry"
        sourcePage="contact"
      />
    </div>
  </section>
</MainLayout>
