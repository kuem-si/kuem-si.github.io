---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/digital-twin.css";
import DigitalTwinCity from "../components/DigitalTwinCity.astro";
import nexaviaLogo from "../assets/brand/nexavia/official/NEXAVIA-web-Black.svg";

const buildings = [
  { id: "HOUSE_01", name: "Hiša z vrtom" },
  { id: "STADIUM_01", name: "Mestni stadion" },
  { id: "TOWER_01", name: "Nebotičnik" },
  { id: "OFFICE_01", name: "Poslovna stavba" },
  { id: "FACTORY_01", name: "Tovarna" },
  { id: "LAMP_01", name: "Ulična svetilka" },
  { id: "LAMP_02", name: "Ulična svetilka 2" },
  { id: "LAMP_03", name: "Ulična svetilka 3" },
  { id: "LAMP_04", name: "Ulična svetilka 4" },
];
---

<MainLayout
  title="Digitalni dvojček mesta | KUEM"
  description="Interaktivni koncept mini mesta in Nexavia nadzorne plošče."
  noindex
>
  <div class="twin-page" data-twin-root>
    <div class="twin-intro">
      <div>
        <p class="twin-path">
          <a href="/nexavia/">Nexavia</a> <span aria-hidden="true">/</span>{" "}
          Koncept digitalnega dvojčka
        </p>
        <h1>Mesto, ki pokaže, kaj se dogaja s podatki.</h1>
        <p class="twin-lead">
          Mesto povezuje upravljanje razsvetljave, števce porabe ter senzorje
          tresljajev mostu, gladine reke, kakovosti zraka in kolesarskega
          prometa. Meritve in dogodki se prikazujejo v Nexavii.
        </p>
      </div>
    </div>

    <section
      class="twin-workspace"
      aria-label="Digitalni dvojček in nadzorna plošča"
    >
      <div class="twin-city-panel">
        <div class="twin-panel-head">
          <div>
            <p>Pogled mesta · povlecite za raziskovanje</p>
          </div>
          <span class="twin-live">
            <span></span> Simulacija teče
          </span>
        </div>
        <div class="twin-scene-wrap">
          <DigitalTwinCity locale="sl" />
        </div>
        <div class="twin-controls">
          <button type="button" data-city-fullscreen aria-pressed="false">
            Odpri celozaslonski pogled
          </button>
          <button type="button" data-overlay-toggle aria-pressed="true">
            Skrij nadzorno ploščo
          </button>
          <button type="button" id="twin-pause" aria-pressed="false">
            Začasno ustavi
          </button>
          <button type="button" id="twin-next">
            Naslednji dogodek
          </button>
          <span id="twin-step" aria-live="polite">
            Senzor bere svetlobo okolice
          </span>
        </div>
      </div>
      <div
        class="xdr-display"
        aria-label="Zaslon Apple Pro Display XDR s prikazom demonstracijskega brskalnika"
      >
        <div class="xdr-overlay-tools" data-overlay-drag>
          <span>Premakni nadzorno ploščo</span>
          <label>Prosojnost <input type="range" min="35" max="100" value="100" data-overlay-opacity aria-label="Prosojnost nadzorne plošče" /></label>
        </div>
        <div class="xdr-bezel" aria-label="Odzivna simulacija nadzorne plošče Nexavia">
          <div class="xdr-screen">
            <aside
              class="twin-dashboard"
              aria-label="Nexavia nadzorna plošča, simulacija"
            >
              <div class="twin-dashboard-top">
                <div class="twin-brand"><img src={nexaviaLogo.src} alt="Nexavia" /><span>Network Operations Center</span></div>
                <span class="twin-demo-pill"><i></i> DEMO</span>
              </div>
              <nav class="nx-demo-nav" aria-label="Razdelki nadzorne plošče Nexavia">
                <span class="is-current"><b>▦</b> Pregled</span><span><b>⌘</b> Naprave</span><span><b>◉</b> Prehodi</span><span><b>▤</b> Alarmi</span>
              </nav>
              <div class="twin-dashboard-body">
                <div class="twin-dashboard-heading">
                  <div>
                    <h2>Pregled naprav</h2>
                    <p>
                      5 stavb · 4 ulične svetilke · demonstracijski podatki
                    </p>
                  </div>
                  <span class="twin-sync"><i></i> Sinhronizirano</span>
                </div>
                <div class="twin-kpis">
                  <div>
                    <span>Aktivne naprave</span>
                    <strong id="twin-active">0 / 9</strong>
                    <small>Po mestu</small>
                  </div>
                  <div>
                    <span>Skupna moč</span>
                    <strong id="twin-power">0 W</strong>
                    <small>Trenutna simulacija</small>
                  </div>
                  <div>
                    <span>Svetloba okolice</span>
                    <strong id="twin-lux">46 lx</strong>
                    <small>Senzor LIGHT_01</small>
                  </div>
                </div>
                <div class="twin-rule">
                  <span class="twin-rule-icon">i</span>
                  <div>
                    <strong>Pravilo: svetloba &lt; 25 lx</strong>
                    <p id="twin-rule-status">Čaka na naslednjo meritev</p>
                  </div>
                </div>
                <div class="twin-table-heading">
                  <h3>Stanje naprav</h3>
                  <span>Simulacija v živo</span>
                </div>
                <div
                  class="twin-table"
                  role="table"
                  aria-label="Stanje razsvetljave stavb"
                >
                  <div class="twin-tr twin-th" role="row">
                    <span role="columnheader">Naprava</span>
                    <span role="columnheader">Stanje</span>
                    <span role="columnheader">Moč</span>
                  </div>
                  {buildings.map((b) => (
                    <div class="twin-tr" role="row" data-row={b.id}>
                      <span role="cell">
                        <b>{b.name}</b>
                        <small>{b.id}</small>
                      </span>
                      <span role="cell" class="twin-state">
                        Izklopljeno
                      </span>
                      <span role="cell" class="twin-watts">
                        0 W
                      </span>
                    </div>
                  ))}
                </div>
                <div class="twin-alerts" aria-live="polite">
                  <h3><span>!</span> Aktivni alarmi <b id="twin-alarm-count">2</b></h3>
                  <p data-alarm="OFFICE_01"><strong>OFFICE_01</strong><span>Senzor se ne odziva · 12 min</span></p>
                  <p data-alarm="FACTORY_01"><strong>FACTORY_01</strong><span>Šibek signal prehoda · 4 min</span></p>
                </div>
                <div class="twin-meter-readings">
                  <div class="twin-meter-heading"><h3>Meritve števcev</h3><span>Telemetrija v živo</span></div>
                  <div><span>Vodomer hiše z vrtom<small>HOUSE_WATER_01</small></span><strong id="meter-house-water">0,84 m³/d</strong></div>
                  <div><span>Vodomer poslovne stavbe<small>OFFICE_WATER_01</small></span><strong id="meter-office-water">12,6 m³/d</strong></div>
                  <div><span>Plinomer tovarne<small>FACTORY_GAS_01</small></span><strong id="meter-factory-gas">34,2 m³/h</strong></div>
                </div>
                <div class="twin-sensor-readings">
                  <div class="twin-meter-heading"><h3>Senzorji infrastrukture</h3><span>Meritve v živo</span></div>
                  <div><span>Tresljaji mostu<small>BRIDGE_VIB_01</small></span><strong id="sensor-vibration">0,42 mm/s<small>Običajno</small></strong></div>
                  <div><span>Gladina reke<small>RIVER_LEVEL_01</small></span><strong id="sensor-water-level">1,36 m<small>Normalno območje</small></strong></div>
                  <div><span>Kakovost zraka<small>AIR_QUALITY_01 · PM10</small></span><strong id="sensor-air-pm10">18 µg/m³<small id="sensor-air-climate">18,7 °C · 56 % RH</small></strong></div>
                  <div><span>Števec kolesarjev<small>CYCLE_COUNT_01</small></span><strong id="sensor-cyclists">124 danes</strong></div>
                </div>
                <div class="twin-event">
                  <h3>Zadnji dogodek</h3>
                  <p id="twin-event">Čakanje na podatkovni dogodek …</p>
                  <small>
                    *V realnem času znotraj te simulacije. Brez povezave z živo
                    Nexavio.
                  </small>
                </div>
              </div>
            </aside>
          </div>
        </div>
        <button type="button" class="xdr-resize-edge xdr-resize-width" data-overlay-resize="width" aria-label="Povlecite levi rob za spremembo širine nadzorne plošče" title="Spremeni širino"></button>
        <button type="button" class="xdr-resize-edge xdr-resize-height" data-overlay-resize="height" aria-label="Povlecite spodnji rob za spremembo višine nadzorne plošče" title="Spremeni višino"></button>
      </div>
    </section>
  </div>
  <script src="../digital-twin/index.js"></script>
</MainLayout>
