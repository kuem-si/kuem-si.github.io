---
import MainLayout from "../layouts/MainLayout.astro";
import {
  ROUTES,
  buildLocalizedPath,
  buildStaticSlugParam,
  getAlternatePaths,
  getRoute,
  type RouteId,
} from "../config/routes";
import { SUPPORTED_LOCALES, type Locale } from "../config/site";
import ContactForm from "../components/ContactForm.astro";

interface Props {
  locale: Locale;
  routeId: RouteId;
}

export function getStaticPaths() {
  return SUPPORTED_LOCALES.flatMap((locale) =>
    ROUTES.map((route) => ({
      params: { slug: buildStaticSlugParam(locale, route.id) },
      props: {
        locale,
        routeId: route.id,
      },
    })),
  );
}

const { locale, routeId } = Astro.props as Props;
const route = getRoute(routeId);

const linkedRouteIds: RouteId[] =
  routeId === "services"
    ? ["service-development", "service-architecture", "service-devops"]
    : routeId === "solutions"
      ? ["solution-nexavia", "solution-nexavia-enterprise", "solution-thynkr"]
      : routeId === "home"
        ? ["services", "solutions", "about", "contact"]
        : ["contact"];
---

<MainLayout
  locale={locale}
  routeId={routeId}
  title={route.title[locale]}
  description={route.description[locale]}
  canonicalPath={buildLocalizedPath(locale, routeId)}
  alternatePaths={getAlternatePaths(routeId)}
>
  <section class="hero">
    <p class="eyebrow">
      {locale === "sl" ? "Digitalni inzeniring" : "Digital engineering"}
    </p>
    <h1>{route.intro[locale]}</h1>
    <p class="lead">{route.description[locale]}</p>
  </section>

  <section
    class="content-grid"
    aria-label={locale === "sl" ? "Poudarki strani" : "Page highlights"}
  >
    {
      route.highlights[locale].map((item) => (
        <article class="card">
          <h2>{item}</h2>
          <p>
            {locale === "sl"
              ? "Pristop je prilagojen vasemu kontekstu, ciljem in tehnicnim omejitvam."
              : "Delivery is adapted to your context, goals, and technical constraints."}
          </p>
        </article>
      ))
    }
  </section>

  <section
    class="related"
    aria-label={locale === "sl" ? "Sorodne strani" : "Related pages"}
  >
    <h2>{locale === "sl" ? "Raziscite naprej" : "Explore further"}</h2>
    <div class="related-links">
      {
        linkedRouteIds.map((id) => {
          const related = getRoute(id);
          return (
            <a
              href={buildLocalizedPath(locale, id)}
              data-astro-prefetch="hover"
            >
              <strong>{related.labels[locale]}</strong>
              <span>{related.description[locale]}</span>
            </a>
          );
        })
      }
    </div>
  </section>
  {routeId === "contact" && <ContactForm />}
</MainLayout>; ---
