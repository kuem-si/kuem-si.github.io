---
import { trustedCompanies } from "../data/trustedCompanies";
import { getLocaleFromPath } from "../lib/i18n";
const en = getLocaleFromPath(Astro.url.pathname) === "en";
---

<div class="trusted">
  <div class="trusted-scroll" tabindex="0" role="region" aria-label={Astro.props.label ?? "Zaupajo nam"}>
    <div class="trusted-track">
      {[false, true].map((duplicate) => (
        <div class="trusted-group" aria-hidden={duplicate ? "true" : undefined}>
          {trustedCompanies.map((name) => <span>{name}</span>)}
        </div>
      ))}
    </div>
  </div>
  {/* WCAG 2.2.2: anything that moves for more than five seconds can be paused. Shown by the script. */}
  <button class="trusted-toggle" type="button" aria-pressed="false" aria-label={en ? "Pause the moving list" : "Ustavi premikanje seznama"} hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path class="trusted-pause" d="M4 3h3v10H4zM9 3h3v10H9z" />
      <path class="trusted-play" d="M5 3l8 5-8 5z" />
    </svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".trusted").forEach((list) => {
    const toggle = list.querySelector<HTMLButtonElement>(".trusted-toggle");
    if (!toggle) return;
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const paused = toggle.getAttribute("aria-pressed") !== "true";
      toggle.setAttribute("aria-pressed", String(paused));
      list.toggleAttribute("data-paused", paused);
    });
  });
</script>

<style>
  .trusted {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    width: 100%;
  }
  .trusted-scroll {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .trusted-scroll::-webkit-scrollbar {
    display: none;
  }
  .trusted-track {
    display: flex;
    width: max-content;
    animation: trusted-drift 65s linear infinite;
  }
  .trusted[data-paused] .trusted-track,
  .trusted-scroll:hover .trusted-track,
  .trusted-scroll:focus-within .trusted-track {
    animation-play-state: paused;
  }
  .trusted-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 48px;
    padding: 12px 48px 12px 0;
  }
  .trusted-group span {
    white-space: nowrap;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 600;
    color: var(--kuem-text-muted);
  }
  .trusted-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--kuem-border);
    border-radius: var(--kuem-radius-control);
    background: transparent;
    color: var(--kuem-text-muted);
    cursor: pointer;
  }
  .trusted-toggle:hover {
    border-color: var(--kuem-data);
    color: var(--kuem-petrol);
  }
  .trusted-toggle[hidden],
  .trusted-toggle[aria-pressed="true"] .trusted-pause,
  .trusted-toggle[aria-pressed="false"] .trusted-play {
    display: none;
  }
  .trusted-toggle svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  @keyframes trusted-drift {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .trusted-track { animation: none; }
    .trusted-group[aria-hidden="true"],
    .trusted-toggle { display: none; }
  }
</style>
