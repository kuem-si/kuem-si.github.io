---
import { trustedCompanies } from "../data/trustedCompanies";
---

<div class="trusted-scroll" tabindex="0" role="region" aria-label={Astro.props.label ?? "Zaupajo nam"}>
  <div class="trusted-track">
    {[false, true].map((duplicate) => (
      <div class="trusted-group" aria-hidden={duplicate ? "true" : undefined}>
        {trustedCompanies.map((name) => <span>{name}</span>)}
      </div>
    ))}
  </div>
</div>

<style>
  .trusted-scroll {
    min-width: 0;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .trusted-scroll::-webkit-scrollbar {
    display: none;
  }
  .trusted-track {
    display: flex;
    width: max-content;
    animation: trusted-drift 65s linear infinite;
  }
  .trusted-group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 48px;
    padding: 12px 48px 12px 0;
  }
  .trusted-group span {
    white-space: nowrap;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 600;
    color: #52636a;
  }
  @keyframes trusted-drift {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .trusted-track { animation: none; }
    .trusted-group[aria-hidden="true"] { display: none; }
  }
</style>
