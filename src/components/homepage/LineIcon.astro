---
const { name } = Astro.props as { name: string };
const paths: Record<string, string> = {
  water:
    "M16 3C13 9 6 16 6 21a10 10 0 0 0 20 0c0-5-7-12-10-18ZM11 21a5 5 0 0 0 5 5",
  energy: "M19 2 6 19h9l-2 11 13-18h-9l2-10Z",
  leaf: "M28 3C9 4 3 13 7 24c11 5 21-4 21-21ZM4 29 22 11",
  bike: "M12 8h5l7 14M8 22l7-10h7M10 7h4M25 5h1",
  building:
    "M5 29h24M8 29V10l14-7v26M22 13h5v16M12 12v3m5-5v3m-5 5v3m5-5v3m-4 10v-5h4v5",
  eye: "M2 16s5-9 14-9 14 9 14 9-5 9-14 9S2 16 2 16Z",
  bell: "M7 23h18l-3-5v-6a6 6 0 0 0-12 0v6l-3 5Zm6 4a3 3 0 0 0 6 0M16 3v3",
  chart: "M6 28V18h4v10H6Zm8 0V11h4v17h-4Zm8 0V4h4v24h-4Z",
  device:
    "M4 19h24v10H4V19Zm5 5h2m4 0h2M23 19V7m-4 0h8M10 19v-6M5 9a8 8 0 0 1 10 0M8 12a4 4 0 0 1 4 0",
  network:
    "M16 12 10 29m6-17 6 17m-10-5h8M9 7a10 10 0 0 0 0 14M23 7a10 10 0 0 1 0 14M12 10a6 6 0 0 0 0 8m8-8a6 6 0 0 1 0 8",
  screen: "M3 5h26v19H3V5Zm13 19v5m-7 0h14",
  database:
    "M5 8c0-6 22-6 22 0S5 14 5 8Zm0 0v16c0 6 22 6 22 0V8M5 16c0 6 22 6 22 0",
  api: "m11 8-8 8 8 8m10-16 8 8-8 8M18 5l-4 22",
  check: "m9 16 5 5 9-10",
  people:
    "M10 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm12-1a4 4 0 1 0 0-8M2 28v-5a8 8 0 0 1 16 0v5H2Zm19-9a7 7 0 0 1 9 7v2h-8",
};
---

<svg
  class="hp-icon"
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.database}></path>
  {name === "eye" && <circle cx="16" cy="16" r="4" />}
  {name === "check" && <circle cx="16" cy="16" r="13" />}
  {name === "network" && <circle cx="16" cy="12" r="2" />}
  {
    name === "bike" && (
      <>
        <>
          <circle cx="7" cy="23" r="6" />
          <circle cx="25" cy="23" r="6" />
          <circle cx="20" cy="4" r="2" />
        </>
      </>
    )
  }
</svg>
