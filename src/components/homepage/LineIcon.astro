---
import KuemIcon from "../KuemIcon.astro";
const { name } = Astro.props as { name: string };
// Homepage, Nexavia and solution names -> KUEM icon set.
const map: Record<string, string> = {
  water: "water",
  energy: "energy",
  leaf: "environment",
  bike: "mobility",
  building: "building",
  eye: "monitoring",
  bell: "alarm",
  chart: "chart",
  device: "sensor",
  network: "gateway",
  screen: "dashboard",
  database: "database",
  api: "code",
  check: "check",
  people: "people",
  location: "location",
  settings: "settings",
  wrench: "maintenance",
};
---

<KuemIcon class="hp-icon" name={map[name] ?? "database"} />
