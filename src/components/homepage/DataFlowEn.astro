---
import Icon from "./LineIcon.astro";
import nexavia from "../../assets/brand/nexavia/official/NEXAVIA-web-Black.svg";
---

<div
  class="hp-flow"
  role="img"
  aria-label="Devices through connectivity and existing systems through API integrations send data directly to Nexavia. Nexavia connects the data with KAI to support action."
>
  <div class="hp-flow-inputs">
    <div class="hp-flow-lane">
      <div class="hp-node">
        <Icon name="device" /><strong>Devices</strong><small
          >Sensors, meters, telemetry</small
        >
      </div>
      <span class="hp-connector" aria-hidden="true"></span>
      <div class="hp-node">
        <Icon name="network" /><strong>Connectivity</strong><small
          >LoRaWAN, NB-IoT, mobile and local networks</small
        >
      </div>
    </div>
    <div class="hp-flow-lane">
      <div class="hp-node">
        <Icon name="database" /><strong>Existing systems</strong><small
          >ERP, SCADA, GIS and other sources</small
        >
      </div>
      <span class="hp-connector" aria-hidden="true"></span>
      <div class="hp-node">
        <Icon name="api" /><strong>API</strong><small
          >Integrations and standard interfaces</small
        >
      </div>
    </div>
  </div>
  <div class="hp-merge" aria-hidden="true">
    <svg viewBox="0 0 40 200" preserveAspectRatio="none"
      ><path
        d="M0 45H10Q18 45 18 55V85Q18 95 27 95H39M0 155H10Q18 155 18 145V115Q18 105 27 105H39"
      ></path><path
        class="hp-flow-pulse"
        d="M0 45H10Q18 45 18 55V85Q18 95 27 95H39M0 155H10Q18 155 18 145V115Q18 105 27 105H39"
      ></path><path d="m34 92 5 3-5 3m0 4 5 3-5 3"></path></svg
    ><span>↓</span>
  </div>
  <div class="hp-flow-output">
    <div class="hp-node hp-platform">
      <div class="hp-nexavia-mark">
        <img class="nexavia-wordmark" src={nexavia.src} width="1200" height="360" alt="Nexavia" />
      </div><small>A platform for data, visualization and management</small>
    </div>
    <span class="hp-connector" aria-hidden="true"></span>
    <div class="hp-node hp-result">
      <Icon name="chart" /><strong>KAI</strong><small
        >Analysis, alerts and recommendations</small
      >
    </div>
    <span class="hp-connector" aria-hidden="true"></span>
    <div class="hp-node hp-result">
      <Icon name="check" /><strong>Action</strong><small
        >Better decisions in practice</small
      >
    </div>
  </div>
</div>
