---
import type { Locale } from "../lib/i18n";
import type { Reference } from "../data/references";
import { t } from "../data/translations";

const { reference, locale = "en" } = Astro.props as {
  reference: Reference;
  locale?: Locale;
};
---

<article
  class="reference-name-card"
  aria-label={`${t(locale, "nameOnlyReference")}: ${reference.name}`}
>
  {reference.name}
</article>
