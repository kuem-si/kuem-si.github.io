---
import { withBase } from "../lib/paths";
import type { Locale } from "../lib/i18n";
import { withLocale } from "../lib/i18n";

const {
  title = "Start with a focused pilot",
  description = "Get a technical discovery session for your utility or industrial site.",
  ctaHref,
  ctaText = "Request a demo",
  locale = "en",
} = Astro.props as {
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaText?: string;
  locale?: Locale;
};
const href = ctaHref ?? `${withLocale("/contact", locale)}#demo-form`;
---

<section class="cta-strip">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <a class="btn btn-primary" href={withBase(href)}>{ctaText}</a>
  </div>
</section>
