        "♧",
        "Timely notifications",
        "Deviations and events reach the responsible person without unnecessary searching.",
      ],
      [
        "▥",
        "Basis for action",
        "History, context and comparisons support better decisions.",
      ],
    ],
    storiesEyebrow: "SUCCESS STORIES",
    storiesH2: "Solutions in real environments.",
    stories: [
      [
        "Brezovica",
        "Overview of water meters and utility infrastructure.",
        "komunala-in-energija",
      ],
      [
        "Gradiška",
        "Air quality, noise, traffic and environmental conditions.",
        "okolje",
      ],
      ["Adria Mobil", "Energy data from the production environment.", "industrija"],
      ["Novo mesto", "Data for sustainable mobility planning.", "mobilnost"],
    ],
    closingH2: "Let’s find the right first step for your environment.",
    closingP:
