  en: {
    title: "Industries | KUEM",
    description:
      "Data for environments that must work. Choose an industry and see what we monitor and what you gain.",
    eyebrow: "INDUSTRIES AND VERTICALS",
    h1: "Data for environments that must work.",
    heroP:
      "From utilities and public infrastructure to industry, mobility and tourism, we adapt solutions to the real environment and way of working.",
