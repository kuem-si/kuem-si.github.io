        "Pravočasno obveščanje",
        "Odstopanja in dogodki dosežejo odgovorno osebo brez nepotrebnega iskanja.",
      ],
      [
        "▥",
        "Podlaga za ukrep",
        "Zgodovina, kontekst in primerjave pomagajo sprejeti boljšo odločitev.",
      ],
    ],
    storiesEyebrow: "USPEŠNE ZGODBE",
    storiesH2: "Rešitve v realnem okolju.",
    stories: [
      [
        "Brezovica",
        "Pregled vodomerov in komunalne infrastrukture.",
        "komunala-in-energija",
      ],
      ["Gradiška", "Kakovost zraka, hrup, promet in stanje okolja.", "okolje"],
      ["Adria Mobil", "Energetski podatki proizvodnega okolja.", "industrija"],
      [
        "Novo mesto",
