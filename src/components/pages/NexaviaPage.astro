  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "KUEM",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Nexavia",
      item: new URL(Astro.url.pathname, Astro.site).href,
