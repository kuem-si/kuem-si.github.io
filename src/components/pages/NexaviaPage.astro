---
import TrustedCompanies from "../TrustedCompanies.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import NexaviaIntegration from "../NexaviaIntegration.astro";
import { getImage, Image } from "astro:assets";
import type { Locale } from "../../lib/i18n";
import logo from "../../assets/brand/nexavia/official/NEXAVIA-web-Black.svg";
import dashboard from "../../assets/brand/nexavia/nexavia-noc-dashboard.png";
import { nexaviaSoftware } from "../../data/organization";
import "../../styles/nexavia.css";

interface Props {
