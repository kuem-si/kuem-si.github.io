---

<MainLayout title={copy.title} description={copy.description}>
  <div class="ab-page">
    <section class="ab-hero" aria-labelledby="ab-title">
      <div class="container ab-hero-grid">
        <div class="ab-hero-copy">
          <p class="ab-eyebrow">{copy.eyebrow}</p><h1 id="ab-title">
            {copy.h1}
          </h1><p>
            {copy.heroP}
          </p><div class="ab-actions">
            <a class="btn btn-primary" href={`#${copy.factsId}`}
              >{copy.meetUs} <span aria-hidden="true">↓</span></a
            ><a class="btn btn-secondary" href={`#${copy.contactId}`}
              >{copy.contactLabel} <span aria-hidden="true">→</span></a
            >
          </div>
        </div>
        <div class="ab-hero-graphic" aria-label={copy.graphicAria}>
          <p>{copy.graphicTagline}</p><svg
            viewBox="0 0 760 420"
            role="img"
            aria-labelledby="ab-flow-title"
            ><title id="ab-flow-title">{copy.flowTitle}</title><g
              class="ab-grid"
              aria-hidden="true"
              ><path
                d="M0 370 120 290 220 338 360 238 490 310 630 214 760 274M0 403 170 315 290 370 410 285 560 348 720 265"
              ></path></g
            ><path class="ab-route" d="M70 300H225L330 190H485L580 76H704"
            ></path><g class="ab-node"
              ><rect x="66" y="296" width="9" height="9"></rect><rect
                x="326"
                y="186"
                width="9"
                height="9"></rect><rect x="576" y="72" width="9" height="9"
              ></rect></g
            ><g class="ab-flow-copy"
              ><text x="68" y="260">{copy.flow.field}</text><text x="68" y="326"
                >{copy.flow.fieldLine1}</text
              ><text x="68" y="344">{copy.flow.fieldLine2}</text><text
                x="328"
                y="150">{copy.flow.systems}</text
              ><text x="328" y="216">{copy.flow.systemsLine1}</text><text
                x="328"
                y="234">{copy.flow.systemsLine2}</text
              ><text x="578" y="38">{copy.flow.management}</text><text
                x="578"
                y="101">{copy.flow.managementLine1}</text
              ><text x="578" y="119">{copy.flow.managementLine2}</text></g
            ><g class="ab-moving"
              ><rect width="8" height="8"
                ><animateMotion
                  begin="indefinite"
                  dur="14s"
                  repeatCount="indefinite"
                  path="M70 300H225L330 190H485L580 76H704"
                ></animateMotion></rect
              ></g
            ></svg
          >
        </div>
      </div>
    </section>

    <section class="ab-facts" id={copy.factsId} aria-labelledby="ab-facts-title">
      <div class="container">
        <p class="ab-eyebrow">{copy.factsEyebrow}</p><h2 id="ab-facts-title">
          {copy.factsH2}
        </h2><div class="ab-fact-grid">
          {
            copy.facts.map(([icon, title, factCopy]) => (
              <article>
                <>
                  <AboutIcon name={icon} />
                  <div>
                    <>
                      <h3>{title}</h3>
                      {icon === "location" && (
                        <a
                          href="https://www.google.com/maps/place/Kuem,+d.o.o./@46.225098,14.3504742,1080m/data=!3m2!1e3!4b1!4m6!3m5!1s0x477b3f5740125f4d:0xd434a9b7180e2ba7!8m2!3d46.225098!4d14.3530491!16s%2Fg%2F11vdn6x3y3?entry=ttu&g_ep=EgoyMDI2MDkxMy4wIKXMDSoASAFQAw%3D%3D"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Ljubljanska cesta 24g
                        </a>
                      )}
                      <p>{factCopy}</p>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ab-team" aria-labelledby="ab-team-title">
      <div class="container ab-team-grid">
        <div>
          <p class="ab-eyebrow">{copy.teamEyebrow}</p><h2 id="ab-team-title">
            {copy.teamH2}
          </h2><p>
            {copy.teamP}
          </p>
        </div><div class="ab-expertise">
          {
            copy.expertise.map(([icon, title, expertiseCopy]) => (
              <article>
                <>
                  <span>
                    <AboutIcon name={icon} />
                  </span>
                  <div>
                    <>
                      <h3>{title}</h3>
                      <p>{expertiseCopy}</p>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ab-growth" aria-labelledby="ab-growth-title">
      <div class="container">
        <p class="ab-eyebrow">{copy.growthEyebrow}</p><h2 id="ab-growth-title">
          {copy.growthH2}
        </h2><p>
          {copy.growthP}
        </p><ol class="ab-timeline">
          {
            copy.growth.map(([number, title, growthCopy], index) => (
              <li>
                <>
                  <div class="ab-step-icon" aria-hidden="true">
                    {index === 0
                      ? "⌁"
                      : index === 1
                        ? "↗"
                        : index === 2
                          ? "▣"
                          : "▥"}
                  </div>
                  <span class="ab-step-node" />
                  <strong>{number}</strong>
                  <h3>{title}</h3>
                  <p>{growthCopy}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ab-principles" aria-labelledby="ab-principles-title">
      <div class="container">
        <p class="ab-eyebrow">{copy.principlesEyebrow}</p><h2
          id="ab-principles-title"
        >
          {copy.principlesH2}
        </h2><div class="ab-principle-grid">
          {
            copy.principles.map(([icon, title, principleCopy]) => (
              <article>
                <>
                  <AboutIcon name={icon} />
                  <h3>{title}</h3>
                  <p>{principleCopy}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ab-region" aria-labelledby="ab-region-title">
      <div class="container ab-region-grid">
        <div>
          <p class="ab-eyebrow">{copy.regionEyebrow}</p><h2
            id="ab-region-title"
          >
            {copy.regionH2}
          </h2><p>
            {copy.regionP}
          </p><a href={copy.referencesHref}
            >{copy.regionLink} <span aria-hidden="true">→</span></a
          >
        </div><div class="ab-map">
          <img
            class="regional-map"
            src={(locale === "en" ? regionalMapEn : regionalMap).src}
            width="1100"
            height="700"
            alt={copy.mapAlt}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section
      class="ab-contact"
      id={copy.contactId}
      aria-labelledby="ab-contact-title"
    >
      <div class="container">
        <h2 id="ab-contact-title">
          {copy.contactH2}
        </h2><p>{copy.contactP}</p><a
          class="btn btn-primary"
          href={copy.contactHref}
          >{copy.contactCta} <span aria-hidden="true">→</span></a
        ><small>{copy.companyLine}</small>
      </div>
    </section>
  </div>
</MainLayout>
<script>
  const graphic = document.querySelector<HTMLElement>(".ab-hero-graphic");
  const svg = graphic?.querySelector<SVGSVGElement>("svg");
  const motion = svg?.querySelector<SVGAnimateMotionElement>("animateMotion");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  let started = false;
  const update = (visible: boolean) => {
    if (!graphic || !svg || reduced.matches) {
      graphic?.classList.remove("is-animated");
      svg?.pauseAnimations();
      return;
    }
    if (!visible || document.hidden) {
      svg.pauseAnimations();
      return;
    }
    if (!started) {
      started = true;
      motion?.beginElement();
      graphic.classList.add("is-animated");
    }
    svg.unpauseAnimations();
  };
  if (graphic) {
    const observer = new IntersectionObserver(
      ([entry]) => update(Boolean(entry?.isIntersecting)),
      { threshold: 0.15 },
    );
    observer.observe(graphic);
  }
</script>
