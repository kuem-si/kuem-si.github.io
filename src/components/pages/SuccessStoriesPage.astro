---
import MainLayout from "../../layouts/MainLayout.astro";
import CTA from "../CTA.astro";
import { publishedSuccessStories } from "../../data/successStories";
import type { Locale } from "../../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const copy = {
  sl: {
    title: "Uspešne zgodbe",
    description:
      "Kako KUEM povezuje naprave, sisteme in podatke v resničnih operativnih okoljih.",
    projects: "Projekti",
  },
  en: {
    title: "Success Stories",
    description:
      "Explore how KUEM connects devices, systems and data across real operating environments.",
    projects: "Projects",
  },
  de: {
    title: "Erfolgsgeschichten",
    description:
      "Wie KUEM Geräte, Systeme und Daten in realen Betriebsumgebungen verbindet.",
    projects: "Projekte",
  },
}[locale];
const { title, description } = copy;
---

<MainLayout {title} {description}>
  <section class="hero" data-scheme="carbon">
    <div class="container">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  </section>
  <section class="section" aria-label={copy.projects}>
    <div class="container grid-3">
      {publishedSuccessStories.map((story) => (
        <article class="card" id={story.slug} data-success-story={story.slug}>
          <p class="story-industry">{story.industry[locale]}</p>
          <h2>{story.customer}</h2>
          <p>{story.summary[locale]}</p>
        </article>
      ))}
    </div>
  </section>
  <CTA {locale} />
</MainLayout>

<style>
  .card h2 { font-size: var(--kuem-type-h3-size); }
  .story-industry { margin-top: 0; font-weight: 600; color: var(--kuem-petrol); }
</style>
