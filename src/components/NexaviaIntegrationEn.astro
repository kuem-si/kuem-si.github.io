---
import logo from "../assets/brand/nexavia/official/NEXAVIA-web-Black.svg";
const sources = ["Devices", "ERP", "SCADA", "GIS", "Weather and public data"];
const outcomes = ["Status overview", "Alerts", "Reports", "KAI analysis"];
---

<section
  class="nx-section nx-integrations"
  aria-labelledby="nx-integrations-title"
>
  <div class="container nx-integration-layout">
    <div class="nx-integration-copy">
      <p class="nx-eyebrow">CONNECTED TO YOUR ENVIRONMENT</p>
      <h2 id="nx-integrations-title">
        Your systems remain. Data connects in Nexavia.
      </h2>
      <p class="nx-integration-lead">
        Devices, business systems and external sources connect through standard
        interfaces in one operational view.
      </p>
      <ul class="nx-integration-checks">
        <li>No unnecessary replacement of existing systems</li><li>
          Phased implementation tailored to your needs
        </li>
      </ul>
      <a href="/en/solutions/integrations" class="nx-integration-link"
        >How integration works <span aria-hidden="true">→</span></a
      >
    </div>
    <div class="nx-integration-card">
      <p class="nx-eyebrow">FROM SOURCES TO USEFUL INFORMATION</p>
      <div class="nx-integration-diagram">
        <svg
          class="nx-connector-lines"
          viewBox="0 0 1000 430"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <g fill="none" stroke="#7daab9" stroke-width="1.5">
            <path d="M205 41H245C280 41 270 198 342 198H365"></path>
            <path d="M205 127H245C282 127 285 205 342 205H365"></path>
            <path d="M205 213H365"></path>
            <path d="M205 299H245C282 299 285 220 342 220H365"></path>
            <path d="M205 385H245C280 385 270 227 342 227H365"></path>
            <path d="M640 205H660C715 205 690 106 745 106H780"></path>
            <path d="M640 216H780"></path>
            <path d="M640 227H660C715 227 690 322 745 322H780"></path>
          </g>
          <g class="nx-static-squares" fill="#f06432">
            <rect x="274" y="71" width="9" height="9"></rect>
            <rect x="276" y="210" width="9" height="9"></rect>
            <rect x="275" y="346" width="9" height="9"></rect>
            <rect x="690" y="111" width="9" height="9"></rect>
            <rect x="693" y="211" width="9" height="9"></rect>
            <rect x="690" y="317" width="9" height="9"></rect>
          </g>
          <g class="nx-moving-squares" fill="#f06432">
            <rect width="9" height="9"
              ><animateMotion
                begin="indefinite"
                dur="8s"
                repeatCount="indefinite"
                path="M205 41H245C280 41 270 198 342 198H365"
              ></animateMotion></rect
            >
            <rect width="9" height="9"
              ><animateMotion
                begin="indefinite"
                dur="9s"
                repeatCount="indefinite"
                path="M205 213H365"></animateMotion></rect
            >
            <rect width="9" height="9"
              ><animateMotion
                begin="indefinite"
                dur="8.5s"
                repeatCount="indefinite"
                path="M205 385H245C280 385 270 227 342 227H365"
              ></animateMotion></rect
            >
            <rect width="9" height="9"
              ><animateMotion
                begin="indefinite"
                dur="8s"
                repeatCount="indefinite"
                path="M640 205H660C715 205 690 106 745 106H780"
              ></animateMotion></rect
            >
            <rect width="9" height="9"
              ><animateMotion
                begin="indefinite"
                dur="9s"
                repeatCount="indefinite"
                path="M640 216H780"></animateMotion></rect
            >
            <rect width="9" height="9"
              ><animateMotion
                begin="indefinite"
                dur="8.5s"
                repeatCount="indefinite"
                path="M640 227H660C715 227 690 322 745 322H780"
              ></animateMotion></rect
            >
          </g>
        </svg>
        <div class="nx-diagram-column nx-diagram-sources">
          <h3>SOURCES</h3>
          <ul>
            {
              sources.map((source, index) => (
                <li>
                  <>
                    <span class="nx-diagram-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 40 40"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {index === 0 && (
                          <>
                            <circle cx="20" cy="20" r="3" />
                            <path d="M14 14a9 9 0 0 0 0 12m12-12a9 9 0 0 1 0 12M9 9a16 16 0 0 0 0 22m22-22a16 16 0 0 1 0 22" />
                          </>
                        )}
                        {index === 1 && (
                          <>
                            <ellipse cx="20" cy="10" rx="11" ry="5" />
                            <path d="M9 10v20c0 3 5 5 11 5s11-2 11-5V10M9 20c0 3 5 5 11 5s11-2 11-5" />
                          </>
                        )}
                        {index === 2 && (
                          <>
                            <circle cx="10" cy="20" r="4" />
                            <circle cx="30" cy="9" r="4" />
                            <circle cx="30" cy="31" r="4" />
                            <path d="m14 18 12-7m-12 11 12 7" />
                          </>
                        )}
                        {index === 3 && (
                          <path d="m5 9 10-5 10 5 10-5v27l-10 5-10-5-10 5V9Zm10-5v27m10-22v27" />
                        )}
                        {index === 4 && (
                          <path d="M11 30h19a7 7 0 0 0 0-14 11 11 0 0 0-21-1 8 8 0 0 0 2 15Z" />
                        )}
                      </svg>
                    </span>
                    <span>{source}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="nx-diagram-column nx-diagram-platform">
          <h3>PLATFORM</h3><div class="nx-platform-box">
            <img src={logo.src} alt="Nexavia" width="280" height="85" /><p>
              Connectivity · processing · rules
            </p>
          </div>
        </div>
        <div class="nx-diagram-column nx-diagram-outcomes">
          <h3>USE</h3><ul>
            {
              outcomes.map((outcome, index) => (
                <li>
                  <>
                    <span class="nx-diagram-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 48 48"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {index === 0 && (
                          <path d="M5 41V24h8v17m5 0V15h8v26m5 0V7h8v34M3 41h42" />
                        )}
                        {index === 1 && (
                          <path d="M24 5c-2 0-3 2-3 4-7 2-10 8-10 16v7l-4 5h34l-4-5v-7c0-8-3-14-10-16 0-2-1-4-3-4ZM19 42c1 3 3 4 5 4s4-1 5-4" />
                        )}
                        {index === 2 && (
                          <path d="M10 4h19l9 9v31H10V4Zm19 0v9h9M16 22h16m-16 7h16m-16 7h11" />
                        )}
                        {index === 3 && (
                          <>
                            <path d="m6 36 10-14 10 8 15-20" />
                            <circle cx="6" cy="36" r="3" />
                            <circle cx="16" cy="22" r="3" />
                            <circle cx="26" cy="30" r="3" />
                            <circle cx="41" cy="10" r="3" />
                          </>
                        )}
                      </svg>
                    </span>
                    <span>{outcome}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="nx-integration-features">
        <div>
          <span aria-hidden="true">♙</span><p>
            <strong>Roles and access</strong><small
              >Controlled access to data and functionality.</small
            >
          </p>
        </div><div>
          <span aria-hidden="true">▤</span><p>
            <strong>Change traceability</strong><small
              >Record of activity and changes.</small
            >
          </p>
        </div><div>
          <span aria-hidden="true">⚙</span><p>
            <strong>Adaptable implementation</strong><small
              >Phased implementation tailored to your needs.</small
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .nx-integrations {
    background: #f7fcff;
    padding: 5.2rem 0;
  }
  .nx-integration-layout {
    width: min(1500px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: minmax(285px, 0.82fr) minmax(0, 1.9fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }
  .nx-integration-copy h2 {
    font-size: clamp(2.2rem, 3.55vw, 4.4rem);
    line-height: 1.16;
    max-width: 12ch;
    margin: 1.4rem 0;
  }
  .nx-integration-lead {
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    color: #607388;
    max-width: 36ch;
  }
  .nx-integration-checks {
    list-style: none;
    padding: 0;
    margin: 2.2rem 0 3rem;
    display: grid;
    gap: 1.1rem;
    color: #586d80;
  }
  .nx-integration-checks li {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .nx-integration-checks li:before {
    content: "✓";
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #156b75;
    color: white;
    font-size: 1.25rem;
  }
  .nx-integration-link {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    color: #156b75;
    border-bottom: 1px solid #156b75;
    padding-bottom: 0.35rem;
    font-size: 1.05rem;
  }
  .nx-integration-link span {
    font-size: 1.5rem;
    line-height: 1;
  }
  .nx-integration-card {
    min-width: 0;
    border: 1px solid #d2e3ee;
    border-radius: 9px;
    padding: clamp(1.4rem, 2.1vw, 2.5rem);
    background: white;
    box-shadow: 0 14px 34px rgba(35, 91, 122, 0.06);
  }
  .nx-integration-card > .nx-eyebrow {
    margin: 0 0 1.5rem !important;
  }
  .nx-integration-diagram {
    position: relative;
    display: grid;
    grid-template-columns: minmax(165px, 1.05fr) minmax(210px, 1.25fr) minmax(
        170px,
        1.15fr
      );
    min-height: 420px;
  }
  .nx-connector-lines {
    position: absolute;
    inset: 31px 0 0;
    width: 100%;
    height: calc(100% - 31px);
    z-index: 0;
    pointer-events: none;
  }
  .nx-moving-squares {
    opacity: 0;
  }
  .nx-integrations.is-animated .nx-moving-squares {
    opacity: 1;
  }
  .nx-integrations.is-animated .nx-static-squares {
    opacity: 0;
  }
  .nx-diagram-column {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .nx-diagram-column + .nx-diagram-column {
    border-left: 1px solid #d3e4ed;
    padding-left: clamp(1rem, 1.6vw, 2rem);
  }
  .nx-diagram-column h3 {
    font:
      700 0.85rem "Source Sans 3",
      sans-serif;
    letter-spacing: 0.13em;
    margin: 0 0 1rem;
    color: #2b3d50;
  }
  .nx-diagram-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .nx-diagram-sources ul {
    gap: 0.55rem;
  }
  .nx-diagram-sources li {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 62px;
    width: 70%;
    border: 1px solid #d4e4ed;
    border-radius: 7px;
    background: #fff;
    padding: 0.65rem 0.85rem;
    font-size: 0.9rem;
    line-height: 1.2;
  }
  .nx-diagram-icon {
    display: grid;
    place-items: center;
    color: #156b75;
    flex: none;
  }
  .nx-diagram-sources .nx-diagram-icon svg {
    width: 32px;
    height: 32px;
  }
  .nx-diagram-platform {
    display: flex;
    flex-direction: column;
  }
  .nx-platform-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 180px;
    margin: auto 0;
    border: 1px solid #c9dff0;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 7px 17px rgba(35, 91, 122, 0.04);
    padding: 1rem;
  }
  .nx-platform-box img {
    display: block;
    width: min(230px, 100%);
    height: auto;
  }
  .nx-platform-box p {
    font-size: 0.82rem;
    color: #526579;
    margin: 1rem 0 0;
  }
  .nx-diagram-outcomes ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .nx-diagram-outcomes li {
    min-height: 138px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    text-align: center;
    border: 1px solid #d4e4ed;
    border-radius: 7px;
    background: #fff;
    padding: 0.75rem;
    font-size: 0.85rem;
  }
  .nx-diagram-outcomes .nx-diagram-icon svg {
    width: 42px;
    height: 42px;
  }
  .nx-integration-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.7rem;
    padding-top: 1.4rem;
    border-top: 1px solid #d3e4ed;
    background: #f8fcfe;
  }
  .nx-integration-features > div {
    display: flex;
    gap: 0.75rem;
    padding: 0.4rem 0.9rem;
  }
  .nx-integration-features > div + div {
    border-left: 1px solid #d3e4ed;
  }
  .nx-integration-features > div > span {
    color: #156b75;
    font-size: 2rem;
    line-height: 1;
  }
  .nx-integration-features p {
    margin: 0;
    font-size: 0.82rem;
  }
  .nx-integration-features small {
    display: block;
    margin-top: 0.2rem;
    color: #607388;
    font-size: 0.8rem;
    line-height: 1.3;
  }
  @media (max-width: 1180px) {
    .nx-integration-layout {
      grid-template-columns: 1fr;
    }
    .nx-integration-copy h2 {
      max-width: 23ch;
    }
    .nx-integration-checks {
      margin: 1.5rem 0;
    }
    .nx-integration-diagram {
      grid-template-columns: minmax(160px, 1.1fr) minmax(200px, 1.25fr) minmax(
          175px,
          1.1fr
        );
    }
  }
  @media (max-width: 700px) {
    .nx-integrations {
      padding: 3.4rem 0;
    }
    .nx-integration-layout {
      width: min(100% - 2rem, 1180px);
    }
    .nx-integration-card {
      padding: 1rem;
    }
    .nx-integration-diagram {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    .nx-connector-lines {
      display: none;
    }
    .nx-diagram-column + .nx-diagram-column {
      padding: 1.2rem 0 0;
      border-left: 0;
      border-top: 1px solid #d3e4ed;
    }
    .nx-diagram-column:not(:last-child):after {
      content: "↓";
      display: block;
      color: #156b75;
      text-align: center;
      font-size: 1.5rem;
      margin: 0.6rem 0 0;
    }
    .nx-diagram-sources li {
      width: 100%;
    }
    .nx-diagram-sources ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nx-platform-box {
      min-height: 150px;
    }
    .nx-diagram-outcomes ul {
      margin-top: 0;
    }
    .nx-diagram-outcomes li {
      min-height: 105px;
    }
    .nx-integration-features {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .nx-integration-features > div + div {
      border-left: 0;
      border-top: 1px solid #d3e4ed;
    }
  }
  @media (max-width: 410px) {
    .nx-diagram-sources ul {
      grid-template-columns: 1fr;
    }
    .nx-integration-copy h2 {
      font-size: 2.2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nx-moving-squares {
      display: none;
    }
    .nx-static-squares {
      opacity: 1 !important;
    }
  }
</style>
<script>
  const section = document.querySelector<HTMLElement>(".nx-integrations");
  const lines = section?.querySelector<SVGSVGElement>(".nx-connector-lines");
  const motions =
    lines?.querySelectorAll<SVGAnimateMotionElement>("animateMotion");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  let started = false;
  const update = (visible: boolean) => {
    if (!section || !lines || reduced.matches) {
      section?.classList.remove("is-animated");
      lines?.pauseAnimations();
      return;
    }
    if (!visible || document.hidden) {
      lines.pauseAnimations();
      return;
    }
    if (!started) {
      started = true;
      motions?.forEach((motion) => motion.beginElement());
      section.classList.add("is-animated");
    }
    lines.unpauseAnimations();
  };
  if (section) {
    const observer = new IntersectionObserver(
      ([entry]) => update(Boolean(entry?.isIntersecting)),
      { threshold: 0.15 },
    );
    observer.observe(section);
    document.addEventListener("visibilitychange", () =>
      update(
        section.getBoundingClientRect().top < innerHeight &&
          section.getBoundingClientRect().bottom > 0,
      ),
    );
    reduced.addEventListener("change", () =>
      update(
        section.getBoundingClientRect().top < innerHeight &&
          section.getBoundingClientRect().bottom > 0,
      ),
    );
  }
</script>
