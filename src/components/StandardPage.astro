---
import MainLayout from "../layouts/MainLayout.astro"; import CTA from "./CTA.astro"; import DataVisual from "./DataVisual.astro"; import SolutionsHero from "./SolutionsHero.astro"; import { industries, solutions } from "../data/site"; import type { Locale } from "../lib/i18n";
const {locale,type}=Astro.props as {locale:Locale;type:"solutions"|"industries"|"company"|"privacy"|"references"|"insights"}; const sl=locale==="sl"; const base=sl?"":"/en";
const copy={solutions:[sl?"Rešitve":"Solutions",sl?"Celotna pot od zajema podatkov do operativnega ukrepa.":"The complete path from data acquisition to operational action."],industries:[sl?"Panoge":"Industries",sl?"Enake tehnične sposobnosti prilagodimo resničnemu operativnemu okolju.":"The same technical capabilities, adapted to the real operating environment."],company:[sl?"O podjetju":"Company",sl?"Tehnološki in izvedbeni partner za celotno podatkovno pot.":"A technology and delivery partner for the complete data path."],privacy:[sl?"Zasebnost":"Privacy",sl?"Osnovne informacije o ravnanju z osebnimi podatki.":"Basic information about personal-data handling."],references:[sl?"Reference":"References",sl?"Primeri izvedb bodo objavljeni po preverjanju dejstev in odobritvi naročnikov.":"Delivery examples will be published after fact-checking and customer approval."],insights:[sl?"Vpogledi":"Insights",sl?"Strokovni zapisi o podatkovnih poteh, integracijah in operativni analitiki.":"Technical notes on data paths, integrations and operational analytics."]}[type];
---
<MainLayout title={copy[0]} description={copy[1]}>{type==="solutions"?<SolutionsHero {locale}/>:<section class="hero"><div class="container hero-grid"><div><p class="eyebrow">KUEM</p><h1>{copy[0]}</h1><p class="lead">{copy[1]}</p></div><DataVisual labels={sl?["Problem","Pot","Rezultat"]:["Problem","Path","Outcome"]}/></div></section>}
{type==="solutions"&&<section class="section" id="solutions-overview"><div class="container"><div class="grid-3">{solutions[locale].map((x,i)=><article class="card"><span class="index">0{i+1}</span><h2>{x.title}</h2><p>{x.summary}</p><a href={`${base}/${sl?"resitve":"solutions"}/${x.slug}`}>{sl?"Podrobnosti →":"Details →"}</a></article>)}</div></div></section>}
{type==="industries"&&<section class="section"><div class="container"><div class="filters" aria-label={sl?"Filtri panog":"Industry filters"}><button aria-pressed="true" data-filter="all">{sl?"Vse":"All"}</button>{industries[locale].slice(0,3).map((x,i)=><button aria-pressed="false" data-filter={String(i)}>{x}</button>)}</div><div class="grid-3">{industries[locale].map((x,i)=><article class="card" data-industry={String(i%3)}><h2>{x}</h2><p>{sl?"Izziv: razpršeni sistemi in omejen pregled. KUEM poveže zajem, integracije ter analitiko za hitrejše, utemeljene odločitve.":"Challenge: distributed systems and limited overview. KUEM connects acquisition, integrations and analytics for faster, evidence-based decisions."}</p><a href={`${base}/${sl?"resitve":"solutions"}`}>{sl?"Povezane rešitve →":"Related solutions →"}</a></article>)}</div></div><script>document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll("[data-filter]").forEach(x=>x.setAttribute("aria-pressed","false"));b.setAttribute("aria-pressed","true");document.querySelectorAll<HTMLElement>("[data-industry]").forEach(c=>c.hidden=b.dataset.filter!=="all"&&c.dataset.industry!==b.dataset.filter)}));</script></section>}
{type==="company"&&<section class="section"><div class="container split"><div><h2>{sl?"Neodvisni od enega proizvajalca ali protokola":"Independent of a single vendor or protocol"}</h2><p>{sl?"KUEM združuje terensko delo, komunikacijska omrežja, platforme, integracije, analitiko in podporo. Izhodišče je operativni problem, cilj pa uporabna in vzdržna podatkovna pot.":"KUEM combines field work, communication networks, platforms, integrations, analytics and support. We start from the operational problem and aim for a useful, maintainable data path."}</p></div><div class="logo-panel"><h3>{sl?"Ključne kompetence":"Core competencies"}</h3><ul><li>{sl?"Arhitektura in integracije":"Architecture and integrations"}</li><li>{sl?"Zajem in prenos podatkov":"Data acquisition and transfer"}</li><li>{sl?"Avtomatizacija in analitika":"Automation and analytics"}</li><li>{sl?"Izvedba in upravljanje":"Delivery and management"}</li></ul></div></div></section>}
{type==="privacy"&&<section class="section"><div class="container legal"><h2>{sl?"Upravljavec in namen":"Controller and purpose"}</h2><p>{sl?"KUEM uporablja podatke, ki jih prostovoljno pošljete prek kontaktnega obrazca, izključno za obravnavo povpraševanja. Obrazec brez nastavljenega produkcijskega priključka podatkov ne pošlje.":"KUEM uses data voluntarily submitted through the contact form solely to handle the inquiry. Without a configured production endpoint, the form does not submit data."}</p><h2>{sl?"Piškotki":"Cookies"}</h2><p>{sl?"Ta različica spletnega mesta ne uporablja nenujnih piškotkov ali analitičnih sledilnikov.":"This website version uses no non-essential cookies or analytics trackers."}</p><h2>{sl?"Vaše pravice":"Your rights"}</h2><p>{sl?"Za vprašanja o osebnih podatkih pišite na info@kuem.si. Končno pravno besedilo mora pred objavo potrditi upravljavec.":"For personal-data questions, contact info@kuem.si. The controller must approve the final legal text before publication."}</p></div></section>}
{(type==="references"||type==="insights")&&<section class="section"><div class="container"><div class="section-head"><h2>{sl?"Preverjena vsebina v pripravi":"Verified content in preparation"}</h2><p>{sl?"Ne objavljamo neodobrenih imen, rezultatov ali trditev. Struktura zbirke je pripravljena za objavo po vsebinskem pregledu.":"We do not publish unapproved names, outcomes or claims. The collection structure is ready for publication after content review."}</p></div></div></section>}<CTA {locale}/></MainLayout>
