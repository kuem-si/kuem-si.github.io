---
import MainLayout from "../layouts/MainLayout.astro";
import type { Locale } from "../lib/i18n";
import LeadForm from "./LeadForm.astro";
import { COMPANY_EMAIL } from "../data/company";

const { locale } = Astro.props as { locale: Locale };
const sl = locale === "sl";
---

<MainLayout
  title={sl ? "Kontakt" : "Contact"}
  description={sl
    ? "Pogovorite se s KUEM o podatkovni poti, integraciji ali operativnem izzivu."
    : "Talk to KUEM about a data path, integration or operational challenge."}
  ><section class="hero contact-hero">
    <div class="container">
      <p class="eyebrow">{sl ? "Kontakt" : "Contact"}</p><h1>
        {
          sl
            ? "Začnimo pri vašem operativnem problemu."
            : "Start with your operational problem."
        }
      </h1><p class="lead">
        {
          sl
            ? "Opišite, kaj želite spremljati, povezati ali izboljšati."
            : "Tell us what you need to monitor, connect or improve."
        }
      </p>
    </div>
  </section><section class="section" id="demo-form">
    <div class="container split">
      <LeadForm
        locale={locale}
        formId="contact-form"
        heading={sl ? "Pošljite povpraševanje" : "Send an inquiry"}
        submitLabel={sl ? "Pošlji povpraševanje" : "Send inquiry"}
        sourcePage={sl ? "kontakt" : "contact"}
      /><aside>
        <h2>{sl ? "Neposreden stik" : "Direct contact"}</h2><a
          href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a
        >
      </aside>
    </div>
  </section></MainLayout
>
