---
import LanguageSelector from "./LanguageSelector.astro";
import wordmark from "../assets/brand/kuem/KUEM_Official_Wordmark.svg";
import { COMPANY_SOCIAL } from "../data/company";
import { footerContent } from "../data/site";
import { localeHome, type Locale } from "../lib/i18n";
import { ensureTrailingSlash } from "../lib/paths";

const { locale } = Astro.props as { locale: Locale };
const content = footerContent[locale];
const currentYear = new Date().getFullYear();
const socialIcons: Record<(typeof COMPANY_SOCIAL)[number]["name"], string> = {
  LinkedIn:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z",
  GitHub:
    "M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z",
};

---

<footer class="site-footer" data-scheme="carbon">
  <div class="container footer-shell">
    <span class="footer-data-node" aria-hidden="true"></span>

    <div class="footer-main">
      <div class="footer-identity">
        <a
          class="footer-logo"
          href={localeHome[locale]}
          aria-label={content.homeLabel}
        >
          <img src={wordmark.src} width="142" height="43" alt="KUEM" />
        </a>
        <p class="footer-slogan">{content.slogan}</p>
        <p class="footer-description">{content.description}</p>
      </div>

      <nav
        class="footer-column footer-products"
        aria-labelledby="footer-products-title"
      >
        <h2 id="footer-products-title">{content.productsTitle}</h2>
        <ul>
          {
            content.products.map((item) => (
              <li>
                <a class="footer-product" href={ensureTrailingSlash(item.href)}>
                  <span>{item.label}</span>
                  <small>{item.description}</small>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="footer-column footer-company"
        aria-labelledby="footer-company-title"
      >
        <h2 id="footer-company-title">{content.companyTitle}</h2>
        <ul>
          {
            content.company.map((item) => (
              <li>
                <a href={ensureTrailingSlash(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* <address> holds only the contact details; its heading sits outside. */}
      <div class="footer-column footer-contact">
        <h2>{content.contactTitle}</h2>
        <address>
          <a class="footer-email" href={`mailto:${content.email}`}
            >{content.email}</a
          >
          <a class="footer-contact-link" href={ensureTrailingSlash(content.contactHref)}>
            {content.contactLabel}<span aria-hidden="true">→</span>
          </a>
        </address>
        <ul class="footer-social" aria-label={content.socialLabel}>
          {
            COMPANY_SOCIAL.map((profile) => (
              <li>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="me noopener"
                  aria-label={`KUEM – ${profile.name}`}
                  title={profile.name}
                >
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path fill="currentColor" d={socialIcons[profile.name]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <p>© {currentYear} KUEM d.o.o. {content.copyright}</p>
      <div class="footer-legal-links">
        <a href={ensureTrailingSlash(content.privacyHref)}>{content.privacyLabel}</a>
        <nav class="footer-languages" aria-label={content.languageLabel}><LanguageSelector {locale} /></nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 4.75rem 0 2.25rem;
    border-top: 2px solid var(--kuem-petrol);
    background: var(--kuem-carbon);
    color: var(--kuem-white);
  }

  .footer-shell {
    position: relative;
  }

  .footer-data-node {
    position: absolute;
    top: calc(-4.75rem - 6px);
    left: 0;
    width: 12px;
    height: 12px;
    background: var(--kuem-copper);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.3fr;
    gap: clamp(1.75rem, 3.2vw, 3rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .footer-identity,
  .footer-column {
    min-width: 0;
  }

  .footer-column {
    position: static;
    display: block;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  .footer-logo {
    display: inline-flex !important;
    margin: 0 !important;
  }

  .footer-logo img {
    display: block;
    width: 142px;
    max-width: 100%;
    filter: brightness(0) invert(1);
  }

  .footer-slogan {
    margin: 1.45rem 0 0;
    color: var(--kuem-text-secondary);
    font-family: var(--kuem-font-heading);
    font-size: var(--kuem-type-body-size);
    font-weight: 600;
    line-height: 1.45;
  }

  .footer-description {
    max-width: 31ch;
    margin: 0.7rem 0 0;
    color: var(--kuem-text-secondary);
    font-size: var(--kuem-type-body-size);
    line-height: 1.55;
  }

  .footer-column h2 {
    margin: 0 0 1.25rem;
    color: var(--kuem-text-muted);
    font-family: var(--kuem-type-label-family);
    font-size: var(--kuem-type-label-size);
    font-weight: var(--kuem-type-label-weight);
    letter-spacing: 0;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .footer-column ul {
    display: grid;
    gap: 0.68rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    margin: 0;
  }

  .footer-column a,
  .footer-legal a {
    width: fit-content;
    color: var(--kuem-text-secondary);
    font-size: var(--kuem-type-small-size);
    line-height: 1.4;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color var(--kuem-duration-fast) var(--kuem-ease-standard),
      text-decoration-color var(--kuem-duration-fast) var(--kuem-ease-standard);
  }

  .footer-column a:hover,
  .footer-legal a:hover {
    color: var(--kuem-white);
    text-decoration-color: var(--kuem-petrol);
  }

  .footer-column a:focus-visible,
  .footer-legal a:focus-visible,
  .footer-logo:focus-visible {
    outline: var(--kuem-focus-width) solid var(--kuem-focus);
    outline-offset: var(--kuem-focus-offset);
    text-decoration-color: var(--kuem-petrol);
  }

  .footer-products ul {
    gap: 1.05rem;
  }

  .footer-product {
    display: grid !important;
    gap: 0.25rem;
  }

  .footer-product > span {
    font-weight: 600;
  }

  .footer-product small {
    max-width: 19ch;
    color: var(--kuem-text-muted);
    font-size: var(--kuem-type-small-size);
    font-weight: 400;
    line-height: 1.35;
  }

  .footer-email {
    display: inline-flex !important;
    color: var(--kuem-white) !important;
    font-size: var(--kuem-type-body-size) !important;
    font-weight: 600;
  }

  .footer-contact,
  .footer-contact address {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .footer-contact address {
    font-style: normal;
  }

  .footer-contact-link {
    display: inline-flex !important;
    gap: 0.45rem;
    align-items: center;
    margin-top: 1rem !important;
  }

  .footer-contact-link span {
    color: var(--kuem-copper);
    transition: transform var(--kuem-duration-base) var(--kuem-ease-standard);
  }

  .footer-contact-link:hover span,
  .footer-contact-link:focus-visible span {
    transform: translateX(3px);
  }

  .footer-social {
    display: flex !important;
    gap: 0.5rem !important;
    margin-top: 1.5rem !important;
  }

  .footer-social a {
    display: inline-grid !important;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--kuem-white) 18%, transparent);
    transition:
      color var(--kuem-duration-fast) var(--kuem-ease-standard),
      border-color var(--kuem-duration-fast) var(--kuem-ease-standard);
  }

  .footer-social a:hover,
  .footer-social a:focus-visible {
    border-color: var(--kuem-petrol);
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem 3rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--kuem-white) 14%, transparent);
  }

  .footer-legal p {
    margin: 0;
    color: var(--kuem-text-muted);
    font-size: var(--kuem-type-small-size);
    line-height: 1.45;
  }

  .footer-legal-links,
  .footer-languages {
    display: flex;
    align-items: center;
  }

  .footer-legal-links {
    gap: 1.5rem;
  }

  .footer-languages {
    gap: 0.4rem;
    position: static;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  .footer-languages i {
    color: var(--kuem-text-muted);
    font-style: normal;
  }

  .footer-languages span[aria-current] {
    color: var(--kuem-white);
    font-size: var(--kuem-type-small-size);
    font-weight: 600;
  }

  @media (max-width: 1100px) {
    .footer-main {
      grid-template-columns: 1.55fr 1fr 1fr;
      gap: 3rem 2.5rem;
    }

    .footer-identity {
      grid-row: span 2;
    }
  }

  @media (max-width: 700px) {
    .site-footer {
      padding: 4.5rem 0 2rem;
    }

    .footer-data-node {
      top: calc(-4.5rem - 6px);
    }

    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.75rem 1.5rem;
      padding-bottom: 3.25rem;
    }

    .footer-identity {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .footer-description {
      max-width: 40ch;
    }

    .footer-legal {
      align-items: flex-start;
      flex-direction: column;
      padding-top: 1.5rem;
    }

    .footer-legal-links {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 390px) {
    .footer-main {
      column-gap: 1.1rem;
    }

    .footer-column a,
    .footer-legal a {
      overflow-wrap: anywhere;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer *,
    .site-footer *::before,
    .site-footer *::after {
      transition: none !important;
    }
  }
</style>
