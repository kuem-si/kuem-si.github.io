---
import nexaviaLogo from "../assets/brand/nexavia/official/NEXAVIA-web-White.svg";
import kaiLogo from "../assets/brand/kai/KAI_by_KUEM_Dark.svg";
const { locale = "sl" } = Astro.props;
const sl=locale==="sl";
const c=sl?{
 field:"TEREN",fieldMain:"Merilniki in senzorji",business:"POSLOVNI SISTEMI",businessMain:"SCADA · ERP · API",connectivity:"POVEZLJIVOST",connectivityMain:"LoRaWAN · NB-IoT · MQTT",
 platform:"OPERATIVNA PODATKOVNA PLATFORMA",intake:"SPREJEM",intakeText:"Preverjen podatek",context:"KONTEKST",contextText:"Povezani sistemi",analysis:"ANALIZA",analysisText:"Odstopanje zaznano",platformStatus:"Povečano odstopanje · potrebna preveritev",
 kai:"KAI · PODPORA ODLOČANJU",explained:"Dogodek pojasnjen",cause:"Možen vzrok:",causeText:"Prekinjena komunikacijska pot",proposal:"Predlog pripravljen →",
 confirmation:"POTRDITEV UPORABNIKA",result:"OPERATIVNI REZULTAT",resultMain:"Delovni nalog ustvarjen",resultText:"Poslano operativni ekipi",
 aria:"Statična topologija podatkovnega toka od terena in poslovnih sistemov prek Nexavie in KAI do operativnega rezultata."
}:{
 field:"FIELD",fieldMain:"Meters and sensors",business:"BUSINESS SYSTEMS",businessMain:"SCADA · ERP · API",connectivity:"CONNECTIVITY",connectivityMain:"LoRaWAN · NB-IoT · MQTT",
 platform:"OPERATIONAL DATA PLATFORM",intake:"INTAKE",intakeText:"Verified data",context:"CONTEXT",contextText:"Connected systems",analysis:"ANALYSIS",analysisText:"Deviation detected",platformStatus:"Increased deviation · verification required",
 kai:"KAI · DECISION SUPPORT",explained:"Event explained",cause:"Possible cause:",causeText:"Interrupted communication path",proposal:"Proposal ready →",
 confirmation:"USER CONFIRMATION",result:"OPERATIONAL RESULT",resultMain:"Work order created",resultText:"Sent to operations team",
 aria:"Static data-flow topology from field and business systems through Nexavia and KAI to an operational result."
};
---
<figure class="topology" aria-label={c.aria}>
 <svg class="links" viewBox="0 0 1200 750" preserveAspectRatio="none" aria-hidden="true">
  <path d="M205 170H285"/><path d="M330 210V285H415"/><path d="M205 555H340V480H415"/><path d="M835 370H918"/><path d="M1025 390V458"/><path d="M1025 505V565"/><path class="feedback" d="M1025 665V700H145V225"/>
  <g class="ports"><rect x="197" y="164" width="12" height="12"/><rect x="279" y="164" width="12" height="12"/><rect x="409" y="279" width="12" height="12"/><rect x="197" y="549" width="12" height="12"/><rect x="409" y="474" width="12" height="12"/><rect x="829" y="364" width="12" height="12"/><rect x="912" y="364" width="12" height="12"/><rect class="violet" x="1019" y="384" width="12" height="12"/><rect class="orange" x="1019" y="499" width="12" height="12"/><rect class="white" x="1019" y="659" width="12" height="12"/></g>
 </svg>

 <section class="input field-input"><div class="input-symbol sensor"><i></i><b></b></div><div><small>{c.field}</small><h2>{c.fieldMain}</h2></div></section>
 <section class="input business-input"><div class="input-symbol systems"><i></i><i></i></div><div><small>{c.business}</small><h2>{c.businessMain}</h2></div></section>
 <section class="connectivity"><div class="diamond"><i></i><i></i><b></b></div><small>{c.connectivity}</small><strong>{c.connectivityMain}</strong></section>

 <section class="nexavia-core">
  <header><div><small>{c.platform}</small><img class="nexavia-wordmark" src={nexaviaLogo.src} width="112" height="31" alt="Nexavia"/></div><span aria-hidden="true"></span></header>
  <div class="stations">
   <article><i></i><small>{c.intake}</small><strong>{c.intakeText}</strong></article>
   <article><i></i><small>{c.context}</small><strong>{c.contextText}</strong></article>
   <article class="analysis"><i></i><small>{c.analysis}</small><strong>{c.analysisText}</strong></article>
  </div>
  <div class="core-status"><i></i><p>{c.platformStatus}</p></div>
 </section>

 <section class="kai-node"><div class="kai-symbol"><i></i><i></i><i></i><span><img src={kaiLogo.src} width="160" height="48" alt="KAI by KUEM"/></span></div></section>
 <section class="kai-copy"><small>{c.kai}</small><h2>{c.explained}</h2><p><span>{c.cause}</span>{c.causeText}</p><strong>{c.proposal}</strong></section>
 <section class="confirmation"><i></i><small>{c.confirmation}</small></section>
 <section class="result"><div class="result-symbol">✓</div><div><small>{c.result}</small><h2>{c.resultMain}</h2><p>{c.resultText}</p></div></section>
</figure>

<style>
.topology{position:relative;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:repeat(10,minmax(0,1fr));gap:16px;width:min(100%,850px);aspect-ratio:16/10;margin:0;isolation:isolate}.topology::before{content:"";position:absolute;inset:-5%;z-index:-2;background:radial-gradient(circle at 55% 48%,rgba(20,95,106,.25),transparent 59%),linear-gradient(rgba(60,120,128,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(60,120,128,.045) 1px,transparent 1px);background-size:auto,30px 30px,30px 30px;mask-image:radial-gradient(ellipse,#000 30%,transparent 76%)}
.links{position:absolute;inset:0;z-index:0;width:100%;height:100%;overflow:visible;pointer-events:none}.links path{fill:none;stroke:rgba(73,154,164,.55);stroke-width:1.3;vector-effect:non-scaling-stroke}.links .feedback{stroke-dasharray:4 7;opacity:.45}.ports rect{fill:#75cbd3}.ports .violet{fill:#9989e0}.ports .orange{fill:#f06432}.ports .white{fill:#e7ffff}
.input{position:relative;z-index:1;display:flex;min-width:0;align-items:center;gap:14px;padding-left:9px}.input::before{content:"";position:absolute;left:0;top:18%;width:1px;height:64%;background:#4c9aa3}.input small,.connectivity small,.nexavia-core small,.kai-copy small,.confirmation small,.result small{display:block;color:#84aeb2;font-size:11px;font-weight:700;line-height:1.3;letter-spacing:.12em}.input h2,.kai-copy h2,.result h2{margin:6px 0 0;color:#f2f6f6;font-family:"Space Grotesk",sans-serif;font-size:17px;line-height:1.25}.field-input{grid-area:2/1/4/4}.business-input{grid-area:7/1/9/4}.input-symbol{position:relative;flex:0 0 43px;width:43px;height:43px}.sensor i{position:absolute;inset:7px 11px;border:1px solid #69bdc5}.sensor b{position:absolute;left:16px;right:16px;bottom:3px;border-top:1px solid #69bdc5}.systems i{position:absolute;left:7px;right:7px;height:10px;border:1px solid #69bdc5}.systems i:first-child{top:7px}.systems i:last-child{bottom:7px}
.connectivity{grid-area:2/4/4/6;z-index:1;display:grid;grid-template-columns:55px 1fr;grid-template-rows:auto auto;align-content:center;gap:4px 12px;min-width:0}.connectivity small{align-self:end}.connectivity strong{color:#e2eeee;font-size:14px;line-height:1.35}.diamond{grid-row:1/3;position:relative;width:48px;height:48px;border:1px solid rgba(75,159,168,.65);transform:rotate(45deg);background:#102329}.diamond>*{transform:rotate(-45deg)}.diamond b{position:absolute;left:22px;top:10px;width:3px;height:27px;background:#72c8d0}.diamond i{position:absolute;width:5px;height:5px;background:#72c8d0}.diamond i:first-child{left:8px;bottom:8px}.diamond i:nth-child(2){right:8px;top:8px}
.nexavia-core{grid-area:3/5/9/10;z-index:2;min-width:0;padding:24px 26px;border:1px solid rgba(67,139,181,.42);border-right-color:#5d91d0;border-radius:8px;background:radial-gradient(circle at 72% 30%,rgba(60,105,153,.16),transparent 35%),linear-gradient(145deg,#0c2432,#0a1924);box-shadow:0 28px 60px rgba(0,0,0,.27),inset 0 0 35px rgba(46,105,147,.06);overflow:hidden}.nexavia-core::before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(84,131,166,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(84,131,166,.045) 1px,transparent 1px);background-size:22px 22px;pointer-events:none}.nexavia-core header{position:relative;display:flex;justify-content:space-between;align-items:flex-start}.nexavia-core header img{display:block;width:104px;margin-top:12px}.nexavia-core header span{width:8px;height:8px;margin-top:2px;background:#6d9bd1}.stations{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;margin-top:35px}.stations::before{content:"";position:absolute;left:12px;right:12px;top:8px;border-top:1px solid rgba(85,152,189,.5)}.stations article{position:relative;min-width:0;padding-top:27px}.stations article>i{position:absolute;left:4px;top:2px;width:13px;height:13px;border:1px solid #74a4d9;background:#102b3c}.stations article small{color:#779fc9}.stations article strong{display:block;margin-top:7px;color:#e3edf5;font-size:14px;line-height:1.35}.stations .analysis>i{border-color:#f06432;background:#f06432}.stations .analysis strong{color:#fff}.core-status{position:relative;display:flex;align-items:center;gap:11px;margin-top:32px;padding-top:17px;border-top:1px solid rgba(83,133,169,.25)}.core-status i{flex:0 0 8px;width:8px;height:8px;background:#f06432}.core-status p{margin:0;color:#dce8ed;font-size:15px;line-height:1.4}.core-status p::first-letter{color:#f06432}
.kai-node{grid-area:2/10/6/12;z-index:2;display:grid;place-items:center}.kai-symbol{position:relative;display:grid;place-items:center;width:142px;height:142px}.kai-symbol>i{position:absolute;right:50%;width:92px;border-top:1px solid rgba(142,125,218,.65);transform-origin:right}.kai-symbol>i:first-child{transform:translateY(-32px) rotate(22deg)}.kai-symbol>i:nth-child(2){transform:none}.kai-symbol>i:nth-child(3){transform:translateY(32px) rotate(-22deg)}.kai-symbol span{display:grid;place-items:center;width:108px;height:108px;border:1px solid #8172ca;border-radius:50%;background:radial-gradient(circle,#242044,#14162a 68%);box-shadow:0 18px 38px rgba(0,0,0,.28)}.kai-symbol img{width:74px}.kai-copy{grid-area:2/12/6/14;z-index:2;align-self:center;min-width:200px;padding-left:4px}.kai-copy small{color:#a99de5}.kai-copy h2{font-size:17px}.kai-copy p{margin:15px 0 0;color:#d4d2dc;font-size:14px;line-height:1.4}.kai-copy p span{display:block;margin-bottom:3px;color:#9997a3}.kai-copy strong{display:block;margin-top:16px;color:#f08660;font-size:15px}
.confirmation{grid-area:6/10/8/14;z-index:2;display:flex;align-items:center;gap:12px;align-self:center}.confirmation>i{width:18px;height:18px;border:1px solid #f06432;background:linear-gradient(135deg,transparent 45%,#f06432 46% 55%,transparent 56%)}.confirmation small{color:#c99a89;font-size:11px}.result{grid-area:8/10/11/14;z-index:2;display:flex;align-items:center;gap:15px;min-width:0}.result-symbol{display:grid;place-items:center;flex:0 0 50px;width:50px;height:50px;border:1px solid #f06432;border-radius:50%;color:#f0845e;font-size:20px}.result h2{font-size:18px}.result p{margin:7px 0 0;color:#a6b4b6;font-size:14px;line-height:1.35}
@media(min-width:1180px){:global(.home-hero-grid){grid-template-columns:minmax(480px,.78fr) minmax(0,1.22fr);column-gap:clamp(42px,3vw,64px)}}
@media(max-width:1100px) and (min-width:768px){:global(.home-hero-grid){grid-template-columns:1fr!important}.topology{width:min(100%,850px);margin:1.5rem auto 0}}
@media(max-width:767px){.topology{display:flex;flex-direction:column;gap:28px;width:100%;aspect-ratio:auto;margin-top:2rem;padding-left:28px}.topology::before{inset:-2rem -1rem}.links{left:0;width:28px;height:100%;overflow:visible}.links path,.links .ports{display:none}.links::before{content:"";position:absolute;left:14px;top:55px;bottom:55px;border-left:1px solid rgba(73,154,164,.55)}.input,.connectivity,.nexavia-core,.kai-node,.kai-copy,.confirmation,.result{grid-area:auto;min-width:0}.input{min-height:95px}.connectivity{min-height:105px}.business-input{order:3;margin-left:28px}.nexavia-core{order:4;min-height:360px;padding:22px 18px}.field-input{order:1}.connectivity{order:2}.kai-node{order:5;min-height:150px}.kai-copy{order:6;min-width:0;padding:0 10px}.confirmation{order:7;min-height:75px}.result{order:8;min-height:125px}.input small,.connectivity small,.nexavia-core small,.kai-copy small,.confirmation small,.result small{font-size:14px}.input h2,.kai-copy h2,.result h2{font-size:18px}.connectivity strong,.stations article strong,.kai-copy p,.kai-copy strong,.result p{font-size:14px}.stations{gap:12px}.core-status p{font-size:14px}}
@media(min-width:768px){.nexavia-core{grid-column:4/10}.kai-node{grid-column:9/10;transform:translateX(48%)}.kai-copy{grid-column:10/13;min-width:0;padding-left:12px}.confirmation,.result{grid-column:10/13}}
@media(min-width:768px){.kai-node{transform:translateX(-42%)}}
</style>
