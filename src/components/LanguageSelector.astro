---
import { localeAlternates, locales, type Locale } from "../lib/i18n";
const { locale, pathname = Astro.url.pathname } = Astro.props as {
  locale: Locale;
  pathname?: string;
};
const alternates = localeAlternates(pathname);
const groupLabel = { sl: "Jezik", en: "Language", de: "Sprache" }[locale];
// Each link is labelled in its own language, so a reader finds theirs.
const viewIn: Record<Locale, string> = {
  sl: "Ogled strani v slovenščini",
  en: "View site in English",
  de: "Website auf Deutsch ansehen",
};
---

<span class="language-selector" role="group" aria-label={groupLabel}>
  {
    locales.map((code, index) => (
      <>
        {index > 0 && <span aria-hidden="true">|</span>}
        {code === locale ? (
          <span aria-current="true">{code.toUpperCase()}</span>
        ) : (
          <a
            href={alternates[code]}
            lang={code}
            hreflang={code}
            aria-label={viewIn[code]}
          >
            {code.toUpperCase()}
          </a>
        )}
      </>
    ))
  }
</span>

<style>
  .language-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }
  .language-selector a {
    color: inherit;
  }
  .language-selector [aria-current] {
    font-weight: 600;
  }
</style>
