---
import wordmark from "../../assets/brand/kuem/KUEM_Official_Wordmark.svg";
import Header from "../Header.astro";
import { homeNavigation, homeNavigationEn } from "../../data/homepage";
import { footerContent } from "../../data/site";
import type { Locale } from "../../lib/i18n";
const { footer = false, locale = "sl" } = Astro.props as {
  footer?: boolean;
  locale?: Locale;
};
const sl = locale === "sl";
const navigation = (sl ? homeNavigation : homeNavigationEn).map(
  ([label, href]) => [label, href.startsWith("#") ? `${sl ? "" : "/en"}/${href}` : href],
);
const copy = {
  sl: {
    homeAria: "KUEM – domača stran",
    homeHref: "/",
    region: "Kranj, Slovenija",
    footerNav: "Navigacija v nogi",
    footerHome: "Zasebnost",
    rights: "Vse pravice pridržane.",
    solutionsHref: "/resitve",
    otherLocale: "/en/solutions",
    otherLabel: "EN",
    otherAria: "View solutions in English",
    cta: "Dogovorite se za predstavitev",
    menuOpen: "Odpri meni",
    menuClose: "Zapri meni",
    mainNav: "Glavna navigacija",
    privacyHref: footerContent.sl.privacyHref,
    email: footerContent.sl.email,
  },
  en: {
    homeAria: "KUEM – home page",
    homeHref: "/en/",
    region: "Kranj, Slovenia",
    footerNav: "Footer navigation",
    footerHome: "Privacy",
    rights: "All rights reserved.",
    solutionsHref: "/en/solutions",
    otherLocale: "/resitve",
    otherLabel: "SL",
    otherAria: "View solutions in Slovenian",
    cta: "Book a presentation",
    menuOpen: "Open menu",
    menuClose: "Close menu",
    mainNav: "Main navigation",
    privacyHref: footerContent.en.privacyHref,
    email: footerContent.en.email,
  },
}[locale];
---

{
  footer ? (
    <footer class="hp-footer">
      <div class="hp-wrap">
        <>
          <div class="hp-footer-main">
            <>
              <a href={copy.homeHref} aria-label={copy.homeAria}>
                <img
                  class="hp-wordmark"
                  src={wordmark.src}
                  width="140"
                  height="42"
                  alt="KUEM"
                  loading="lazy"
                />
              </a>
              <address>
                <>
                  <span>{copy.region}</span>
                  <span aria-hidden="true">|</span>
                  <a href={`mailto:${copy.email}`}>{copy.email}</a>
                </>
              </address>
              <nav aria-label={copy.footerNav}>
                {navigation.map(([label, href]) => (
                  <a href={href}>{label}</a>
                ))}
                <a href={copy.otherLocale} lang={sl ? "en" : "sl"}>
                  {copy.otherLabel}
                </a>
              </nav>
            </>
          </div>
          <div class="hp-footer-legal">
            <>
              <a href={copy.privacyHref}>{copy.footerHome}</a>
              <p>© {new Date().getFullYear()} KUEM. {copy.rights}</p>
            </>
          </div>
        </>
      </div>
    </footer>
  ) : (
    <>
      <Header locale={locale} pathname={copy.solutionsHref} />
      <header class="hp-header legacy-site-header" aria-hidden="true">
        <div class="hp-wrap hp-header-inner">
          <>
            <a href={copy.homeHref} aria-label={copy.homeAria}>
              <img
                class="hp-wordmark"
                src={wordmark.src}
                width="158"
                height="48"
                alt="KUEM"
              />
            </a>
            <button
              class="hp-menu"
              type="button"
              aria-expanded="false"
              aria-controls="solutions-main-nav"
              aria-label={copy.menuOpen}
            >
              <>
                <span />
                <span />
                <span />
              </>
            </button>
            <nav id="solutions-main-nav" aria-label={copy.mainNav}>
              {navigation.map(([label, href]) => (
                <a
                  href={href}
                  aria-current={href === copy.solutionsHref ? "page" : undefined}
                >
                  {label}
                </a>
              ))}
              <a href={copy.otherLocale} lang={sl ? "en" : "sl"} aria-label={copy.otherAria}>
                {copy.otherLabel}
              </a>
              <a class="hp-button" href={sl ? "/#kontakt" : "/en/contact"}>
                {copy.cta} <span aria-hidden="true">→</span>
              </a>
            </nav>
          </>
        </div>
      </header>
    </>
  )
}
<script is:inline define:vars={{ menuOpen: copy.menuOpen, menuClose: copy.menuClose }}>
  const menu = document.querySelector(".hp-menu");
  const nav = document.querySelector("#solutions-main-nav");
  const close = () => {
    menu?.setAttribute("aria-expanded", "false");
    menu?.setAttribute("aria-label", menuOpen);
    nav?.classList.remove("is-open");
  };
  menu?.addEventListener("click", () => {
    const open = menu.getAttribute("aria-expanded") !== "true";
    menu.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-label", open ? menuClose : menuOpen);
    nav?.classList.toggle("is-open", open);
  });
  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.getAttribute("aria-expanded") === "true") {
      close();
      menu.focus();
    }
  });
  for (const eventName of ["click", "focusin"])
    document.addEventListener(eventName, (event) => {
      if (
        event.target instanceof Node &&
        !nav?.contains(event.target) &&
        !menu?.contains(event.target)
      )
        close();
    });
  matchMedia("(min-width: 1201px)").addEventListener("change", close);
</script>
