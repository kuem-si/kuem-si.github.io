---
import Icon from "./ServiceIcon.astro";
const {
  items,
  compact = false,
  horizontal = false,
} = Astro.props as {
  items: { icon: string; title: string; text?: string }[];
  compact?: boolean;
  horizontal?: boolean;
};
---

<div
  class:list={[
    "sol-cards",
    { "sol-cards-compact": compact, "sol-cards-horizontal": horizontal },
  ]}
  style={`--card-count:${items.length}`}
>
  {
    items.map((item) => (
      <article class="hp-card">
        <>
          <Icon name={item.icon} />
          <div>
            <h3>{item.title}</h3>
            {item.text && <p>{item.text}</p>}
          </div>
        </>
      </article>
    ))
  }
</div>
