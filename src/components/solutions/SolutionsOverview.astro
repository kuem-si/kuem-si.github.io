---
import TrustedCompanies from "../TrustedCompanies.astro";
import SeoHead from "../SeoHead.astro";
import Chrome from "./SiteChrome.astro";
import Architecture from "./SolutionsArchitecture.astro";
import Panel from "./SolutionExplorerPanel.astro";
import Icon from "./ServiceIcon.astro";
import type { Locale } from "../../lib/i18n";
import {
  explorerBenefits,
  explorerBenefitsEn,
  explorerExamples,
  explorerExamplesEn,
} from "../../data/solutionExplorer";
import "../../styles/homepage.css";
import "../../styles/solution-explorer.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  sl: {
    lang: "sl",
    seoTitle: "Rešitve | KUEM – Od zajema podatka do upravljane storitve",
    seoDescription:
      "Raziščite celotno KUEM rešitev: od naprav in obstoječih sistemov prek Nexavie do odločitev in upravljanih storitev.",
    pathname: "/resitve",
    skip: "Preskoči na vsebino",
    eyebrow: "REŠITVE KUEM",
    h1: "Od zajema podatka do upravljane storitve.",
    heroP:
      "Povežemo naprave, komunikacijska omrežja, obstoječe sisteme in podatke v rešitev, ki deluje kot celota.",
    cta: "Pogovorimo se",
    dataFlow: "Oglejte si tok podatka",
    trustAria: "Zaupajo nam",
    trustEyebrow: "ZAUPAJO NAM",
    trustLabel: "Zaupajo nam",
    benefitsEyebrow: "KAJ UPORABNIK PRIDOBI",
    benefitsH2: "Manj iskanja podatkov. Več časa za ukrepanje.",
    examplesEyebrow: "PRIMERI IZ PRAKSE",
    examplesH2: "Od podatka do konkretnega rezultata.",
    storiesEyebrow: "USPEŠNE ZGODBE",
    storiesHref: "/reference/",
    closingH2: "Začnimo z enim konkretnim izzivom.",
    closingP:
      "Izberemo primer uporabe, preverimo razpoložljive podatke in predlagamo izvedljiv prvi korak.",
    closingCta: "Dogovorite se za uvodni sestanek",
    ctaHref: "/#kontakt",
  },
  en: {
    lang: "en",
    seoTitle: "Solutions | KUEM – From data acquisition to managed service",
    seoDescription:
      "Explore the complete KUEM solution: from devices and existing systems through Nexavia to decisions and managed services.",
    pathname: "/en/solutions",
    skip: "Skip to content",
    eyebrow: "KUEM SOLUTIONS",
    h1: "From data acquisition to managed service.",
    heroP:
      "We connect devices, communication networks, existing systems and data into a solution that works as a whole.",
    cta: "Let’s talk",
    dataFlow: "Explore the data flow",
    trustAria: "Trusted by",
    trustEyebrow: "TRUSTED BY",
    trustLabel: "Trusted by",
    benefitsEyebrow: "USER BENEFITS",
    benefitsH2: "Less time searching for data. More time to act.",
    examplesEyebrow: "REAL-WORLD EXAMPLES",
    examplesH2: "From data to a concrete result.",
    storiesEyebrow: "SUCCESS STORIES",
    storiesHref: "/en/references/",
    closingH2: "Let’s start with one concrete challenge.",
    closingP:
      "We select a use case, review the available data and propose a feasible first step.",
    closingCta: "Book an introductory meeting",
    ctaHref: "/en/contact",
  },
}[locale];
const benefits = locale === "sl" ? explorerBenefits : explorerBenefitsEn;
const examples = locale === "sl" ? explorerExamples : explorerExamplesEn;
const stories = ["Domplan", "Brezovica", "Adria Mobil", "Gradiška", "Novo mesto"];
---

<!doctype html>
<html lang={copy.lang}>
  <head
    ><SeoHead
      title={copy.seoTitle}
      description={copy.seoDescription}
      pathname={copy.pathname}
    /></head
  >
  <body class="kuem-home solutions-page">
    <div class="solutions-shell">
      <a class="skip-link" href="#main">{copy.skip}</a>
      <Chrome locale={locale} />
      <main id="main">
        <section class="explorer-hero">
          <div class="hp-wrap explorer-hero-grid">
            <div class="explorer-copy">
              <p class="hp-eyebrow">{copy.eyebrow}</p><h1>
                {copy.h1}
              </h1><p>
                {copy.heroP}
              </p><div class="hp-actions">
                <a class="hp-button" href={copy.ctaHref}
                  >{copy.cta} <span aria-hidden="true">→</span></a
                ><button
                  type="button"
                  class="hp-button hp-outline"
                  data-solution-step="0"
                  aria-controls="solution-panel"
                  aria-haspopup="dialog"
                  aria-expanded="false"
                  ><svg viewBox="0 0 24 24" aria-hidden="true"
                    ><path
                      d="m8 5 11 7-11 7Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"></path></svg
                  >{copy.dataFlow}</button
                >
              </div>
            </div>
            <Architecture locale={locale} />
          </div>
        </section>
        <section class="explorer-trust" aria-label={copy.trustAria}>
          <div class="hp-wrap">
            <h2 class="hp-eyebrow">{copy.trustEyebrow}</h2
            ><TrustedCompanies label={copy.trustLabel} />
          </div>
        </section>
        <section class="explorer-benefits">
          <div class="hp-wrap">
            <p class="hp-eyebrow">{copy.benefitsEyebrow}</p><h2>
              {copy.benefitsH2}
            </h2><div class="explorer-cards">
              {
                benefits.map((item) => (
                  <button
                    type="button"
                    class="hp-card"
                    data-solution-step={item.step}
                    aria-controls="solution-panel"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                  >
                    <>
                      <Icon name={item.icon} />
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                      <span class="card-chevron" aria-hidden="true">
                        ›
                      </span>
                    </>
                  </button>
                ))
              }
            </div>
          </div>
        </section>
        <section class="explorer-examples">
          <div class="hp-wrap">
            <p class="hp-eyebrow">{copy.examplesEyebrow}</p><h2>
              {copy.examplesH2}
            </h2><div class="explorer-cards">
              {
                examples.map((item) => (
                  <button
                    type="button"
                    class="hp-card example-card"
                    data-solution-step={item.step}
                    aria-controls="solution-panel"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                  >
                    <>
                      <div class="example-drawing">
                        <>
                          <Icon name={item.icon} />
                          <svg
                            viewBox="0 0 180 64"
                            aria-hidden="true"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.2"
                          >
                            <path d="M2 60h176M14 60V34h22v26M44 60V15h24v45M80 60V28h23v32M116 60V5l28-4v59M153 60V39h18v21M20 40h8v7h-8zM50 22h9v8h-9zM50 37h9v8h-9zM86 36h9v7h-9zM122 12h8v8h-8zM132 30h7v7h-7zM159 45h6v6h-6z" />
                          </svg>
                        </>
                      </div>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                      <span class="card-chevron" aria-hidden="true">
                        ›
                      </span>
                    </>
                  </button>
                ))
              }
            </div><div class="explorer-stories">
              <h2 class="hp-eyebrow">{copy.storiesEyebrow}</h2><ul>
                {
                  stories.map((name) => (
                    <li>
                      <span class="story-customer">{name}</span>
                    </li>
                  ))
                }
              </ul>
              <a href={copy.storiesHref}>{locale === "sl" ? "Poglejte uspešne zgodbe" : "View success stories"} →</a>
            </div>
          </div>
        </section>
        <section class="hp-closing">
          <div class="hp-wrap">
            <div>
              <h2>{copy.closingH2}</h2><p>
                {copy.closingP}
              </p>
            </div><a class="hp-button" href={copy.ctaHref}
              >{copy.closingCta} <span aria-hidden="true">→</span></a
            >
          </div>
        </section>
      </main>
      <Chrome footer locale={locale} />
    </div>
    <Panel locale={locale} />
  </body>
</html>
