---
import KuemIcon from "../KuemIcon.astro";
const { name } = Astro.props as { name: string };
// Architecture diagram names -> KUEM icon set.
const map: Record<string, string> = {
  devices: "water-meter",
  radio: "gateway",
  systems: "database",
  api: "integration",
  action: "check",
  kai: "chart",
  noc: "dashboard",
};
---

<KuemIcon name={map[name] ?? name} />
