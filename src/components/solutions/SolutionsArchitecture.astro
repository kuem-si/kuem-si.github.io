---
import Icon from "./ArchitectureIcon.astro";
import logo from "../../assets/brand/nexavia/official/NEXAVIA-web-Black.svg";
import type { Locale } from "../../lib/i18n";

const { locale = "sl" } = Astro.props as { locale?: Locale };
const copy = {
  sl: {
    sectionAria: "Arhitektura rešitve: od podatka do odločitve",
    intro: "IZBERITE DEL REŠITVE",
    introHint: "Kliknite posamezen korak za podrobnosti.",
    micro: "OD PODATKA DO ODLOČITVE",
    srOnly:
      "Naprave in senzorji prek povezljivosti v Nexavio. Ločena pot: obstoječi sistemi prek API-integracij v Nexavio. KAI je analitični sloj Nexavie. Iz Nexavie do odločitve in ukrepa. NOC spremlja vse sloje in ni postaja podatkovnega toka.",
    cards: [
      { id: "devices", icon: "devices", title: "Naprave in senzorji", sub: "Števci · senzorji · telemetrija" },
      { id: "radio", icon: "radio", title: "Povezljivost", sub: "LoRaWAN · NB-IoT · wM-Bus · LAN" },
      { id: "systems", icon: "systems", title: "Obstoječi sistemi", sub: "ERP · SCADA · GIS · zunanji viri" },
      { id: "api", icon: "api", title: "API-integracije", sub: "Standardni vmesniki" },
    ],
    platformSub: "Zajem · obdelava · prikaz",
    kaiSub: "Analitika · opozorila · priporočila",
    action: "Odločitev in ukrep",
    actionSub: "Človek ali avtomatizacija",
    noc: "NOC in upravljane storitve",
    nocSub: "Nadzor naprav · povezljivosti · alarmov · podpora",
    nocSmall: "STALEN NADZOR<br />CELOTNE REŠITVE",
  },
  en: {
    sectionAria: "Solution architecture: from data to decision",
    intro: "CHOOSE A SOLUTION LAYER",
    introHint: "Select a step for details.",
    micro: "FROM DATA TO DECISION",
    srOnly:
      "Devices and sensors connect to Nexavia. Existing systems connect through API integrations. KAI is Nexavia’s analytics layer. Nexavia supports decisions and action, while NOC monitors every layer.",
    cards: [
      { id: "devices", icon: "devices", title: "Devices and sensors", sub: "Meters · sensors · telemetry" },
      { id: "radio", icon: "radio", title: "Connectivity", sub: "LoRaWAN · NB-IoT · wM-Bus · LAN" },
      { id: "systems", icon: "systems", title: "Existing systems", sub: "ERP · SCADA · GIS · external sources" },
      { id: "api", icon: "api", title: "API integrations", sub: "Standard interfaces" },
    ],
    platformSub: "Acquisition · processing · visualization",
    kaiSub: "Analytics · alerts · recommendations",
    action: "Decision and action",
    actionSub: "Person or automation",
    noc: "NOC and managed services",
    nocSub: "Device · connectivity · alarm monitoring · support",
    nocSmall: "CONTINUOUS MONITORING<br />OF THE ENTIRE SOLUTION",
  },
}[locale];
const cards = copy.cards;
---

<section class="architecture" data-scheme="white" aria-label={copy.sectionAria}>
  <div class="architecture-intro">
    <div>
      <strong>{copy.intro}</strong><p>
        {copy.introHint}
      </p>
    </div><div class="micro">{copy.micro}</div>
  </div>
  <p class="sr-only">
    {copy.srOnly}
  </p>
  <div class="architecture-grid">
    <svg class="wires" aria-hidden="true"
      ><defs
        ><marker
          id="architecture-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
          ><path
            d="m2 1 4 4-4 4"
            fill="none"
            style="stroke: var(--kuem-data)"
            stroke-width="1.5"></path></marker
        ></defs
      ><g class="monitor-links"></g><g class="data-links"></g><g class="packets"
      ></g></svg
    >
    {
      cards.map((card) => (
        <button
          type="button"
          class={`node ${card.id}`}
          data-node={card.id}
          data-solution-step={
            card.id === "devices" ? 0 : card.id === "radio" ? 1 : 2
          }
          aria-controls="solution-panel"
          aria-expanded="false"
          aria-haspopup="dialog"
        >
          <>
            <Icon name={card.icon} />
            <strong>{card.title}</strong>
            <span>{card.sub}</span>
          </>
          <small class="node-open" aria-hidden="true">
            ›
          </small>
        </button>
      ))
    }
    <div class="node platform" data-node="platform">
      <button
        type="button"
        class="platform-open"
        data-solution-step="3"
        aria-controls="solution-panel"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span class="logo"
          ><img class="nexavia-wordmark" src={logo.src} alt="Nexavia" width="1200" height="360" /></span
        >
        <strong>NEXAVIA</strong><span>{copy.platformSub}</span><small
          class="node-open"
          aria-hidden="true">›</small
        >
      </button>
      <button
        type="button"
        class="kai"
        data-solution-step="3"
        aria-controls="solution-panel"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <Icon name="kai" /><span
          ><strong>KAI</strong><span>{copy.kaiSub}</span
          ></span
        ><small class="node-open" aria-hidden="true">›</small>
      </button>
    </div>
    <button
      type="button"
      class="node action"
      data-node="action"
      data-solution-step="4"
      aria-controls="solution-panel"
      aria-expanded="false"
      aria-haspopup="dialog"
    >
      <Icon name="action" /><strong>{copy.action}</strong><span
        >{copy.actionSub}</span
      ><small class="node-open" aria-hidden="true">›</small>
    </button>
    <button
      type="button"
      class="noc"
      data-scheme="carbon"
      data-node="noc"
      data-solution-step="5"
      aria-controls="solution-panel"
      aria-expanded="false"
      aria-haspopup="dialog"
    >
      <Icon name="noc" /><div>
        <strong>{copy.noc}</strong><span>{copy.nocSub}</span>
      </div><svg class="network" viewBox="0 0 260 40" aria-hidden="true"
        ><path class="network-line" d="M12 20h236"></path><g class="network-node"
          ><rect x="9" y="17" width="6" height="6"></rect><rect
            x="87"
            y="17"
            width="6"
            height="6"></rect><rect x="245" y="17" width="6" height="6"
          ></rect></g
        ><g class="network-gateway"
          ><path d="m50 12 8 8-8 8-8-8zM130 12l8 8-8 8-8-8zM210 12l8 8-8 8-8-8z"
          ></path></g
        ><rect class="network-event" x="161" y="11" width="18" height="18"
        ></rect><text class="network-event-mark" x="170" y="25" text-anchor="middle"
          >!</text
        ></svg
      ><small set:html={copy.nocSmall}></small>
    </button>
  </div>
</section>
<style>
  .architecture {
    container-type: inline-size;
    color: var(--kuem-carbon);
    position: relative;
    width: 100%;
  }
  .micro {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    font-size: var(--kuem-type-label-size);
    letter-spacing: 0;
    color: var(--kuem-text-muted);
    font-weight: var(--kuem-type-label-weight);
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .micro:before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--kuem-border-strong);
  }
  .architecture-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1.38fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 36px 28px;
  }
  .node {
    position: relative;
    z-index: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    background: var(--kuem-white);
    border: 1px solid var(--kuem-border);
    border-radius: var(--kuem-radius-card);
    padding: 18px 8px;
    box-shadow: 0 4px 16px #161a1d04;
  }
  .node > :global(svg) {
    width: 66px;
    height: 56px;
    color: var(--kuem-petrol);
    margin-bottom: 12px;
  }
  .architecture strong {
    display: block;
    font-size: var(--kuem-type-small-size);
    line-height: 1.35;
  }
  .architecture span {
    display: block;
    font-size: var(--kuem-type-small-size);
    line-height: 1.5;
    margin-top: 5px;
    color: var(--kuem-text-muted);
  }
  .devices {
    grid-area: 1/1;
  }
  .radio {
    grid-area: 1/2;
  }
  .systems {
    grid-area: 2/1;
  }
  .api {
    grid-area: 2/2;
  }
  .platform {
    grid-area: 1/3/3/4;
    align-self: start;
    padding: 20px 12px;
  }
  .action {
    grid-area: 1/4;
  }
  .logo {
    width: 100%;
    height: 74px;
    overflow: hidden;
    position: relative;
    margin-bottom: 10px;
  }
  .logo img {
    position: absolute;
    max-width: none;
    width: 190%;
    height: auto;
    left: -8%;
    top: -8%;
  }
  .platform > strong {
    font-size: var(--kuem-type-lead-size);
  }
  .kai {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--kuem-petrol);
    width: 100%;
    border-radius: var(--kuem-radius-card);
    padding: 18px 10px;
    margin-top: 20px;
    text-align: left;
    color: var(--kuem-white);
  }
  .kai :global(svg) {
    width: 40px;
    flex-shrink: 0;
  }
  .kai strong {
    font-size: var(--kuem-type-lead-size);
  }
  .kai span {
    color: var(--kuem-white);
  }
  .noc {
    grid-area: 3/1/4/5;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--kuem-background);
    color: var(--kuem-text-primary);
    padding: 20px;
    border-radius: var(--kuem-radius-card);
    min-width: 0;
  }
  .noc > :global(svg:first-child) {
    width: 44px;
    flex-shrink: 0;
  }
  .noc span {
    color: var(--kuem-text-secondary);
  }
  .network-line {
    stroke: var(--kuem-data);
    stroke-width: 2;
  }
  .network-node {
    fill: var(--kuem-data);
  }
  .network-gateway {
    fill: var(--kuem-background);
    stroke: var(--kuem-data);
    stroke-width: 2;
  }
  .network-event {
    fill: var(--kuem-event);
  }
  .network-event-mark {
    fill: var(--kuem-on-action);
    font-size: 14px;
    font-weight: 700;
  }
  .network {
    flex: 1;
    min-width: 60px;
    max-width: 300px;
  }
  .noc small {
    font-size: var(--kuem-type-label-size);
    font-weight: var(--kuem-type-label-weight);
    line-height: 1.6;
    color: var(--kuem-text-muted);
    border-left: 1px solid var(--kuem-data);
    padding-left: 16px;
    margin-left: auto;
  }
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  @container (min-width:1000px) {
    .architecture-grid {
      gap: 42px 54px;
    }
    .node {
      padding: 25px 12px;
    }
    .architecture strong {
      font-size: var(--kuem-type-body-size);
    }
    .architecture span {
      font-size: var(--kuem-type-small-size);
    }
    .node > :global(svg) {
      width: 90px;
      height: 70px;
    }
    .logo {
      height: 100px;
    }
    .platform > strong {
      font-size: var(--kuem-type-lead-size);
    }
    .kai {
      padding: 22px 16px;
    }
    .noc small {
      font-size: var(--kuem-type-label-size);
    }
  }
  @container (max-width:480px) {
    .architecture-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 38px 24px;
      padding: 0 16px;
    }
    .devices {
      grid-area: 1/1;
    }
    .radio {
      grid-area: 2/1;
    }
    .systems {
      grid-area: 1/2;
    }
    .api {
      grid-area: 2/2;
    }
    .platform {
      grid-area: 3/1/4/3;
      justify-self: center;
      width: 100%;
      max-width: 360px;
    }
    .action {
      grid-area: 4/1/5/3;
      justify-self: center;
      width: 100%;
      max-width: 360px;
    }
    .noc {
      grid-area: 5/1/6/3;
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      padding: 18px 12px;
      gap: 12px;
    }
    .noc > div {
      flex: 1;
    }
    .network {
      grid-column: 1 / -1;
      width: 100%;
      max-width: none;
      height: 36px;
    }
    .noc small {
      grid-column: 1 / -1;
      font-size: var(--kuem-type-label-size);
    }
    .node {
      padding: 16px 7px;
    }
    .architecture strong {
      font-size: var(--kuem-type-small-size);
    }
    .architecture span {
      font-size: var(--kuem-type-small-size);
    }
    .logo {
      width: 230px;
      height: 82px;
    }
    .kai {
      justify-content: center;
    }
    .micro {
      font-size: var(--kuem-type-label-size);
    }
    .platform > strong {
      font-size: var(--kuem-type-lead-size);
    }
  }

  .architecture-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
  }
  .architecture-intro > div > strong {
    font-size: var(--kuem-type-label-size);
    color: var(--kuem-text-muted);
    font-weight: var(--kuem-type-label-weight);
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .architecture-intro p {
    font-size: var(--kuem-type-small-size) !important;
    margin: 6px 0 0 !important;
  }
  .architecture-intro .micro {
    font-size: var(--kuem-type-label-size);
    margin: 0;
    white-space: nowrap;
  }
  button {
    font-family: inherit;
    cursor: pointer;
    line-height: inherit;
    color: inherit;
  }
  .node,
  .noc,
  .platform-open,
  .kai {
    transition:
      background-color var(--kuem-duration-base),
      border-color var(--kuem-duration-base),
      box-shadow var(--kuem-duration-base),
      opacity var(--kuem-duration-base);
  }
  .node:hover,
  .platform-open:hover {
    border-color: var(--kuem-petrol);
    box-shadow: 0 4px 16px #161a1d0c;
  }
  .architecture button:focus-visible {
    outline: var(--kuem-focus-width) solid var(--kuem-focus);
    outline-offset: var(--kuem-focus-offset);
  }
  .node-open {
    position: absolute;
    right: 12px;
    bottom: 6px;
    font-size: 22px;
    line-height: 1;
    color: var(--kuem-petrol);
  }
  .node {
    padding-bottom: 26px;
  }
  .platform {
    padding: 10px;
    gap: 10px;
  }
  .platform-open {
    position: relative;
    width: 100%;
    border: 1px solid transparent;
    border-radius: var(--kuem-radius-card);
    background: var(--kuem-white);
    padding: 8px 4px 22px;
  }
  .platform-open .logo {
    display: block;
    margin: 0 auto 8px;
    height: 70px;
  }
  .platform-open > strong {
    font-size: var(--kuem-type-lead-size);
  }
  .kai {
    position: relative;
    border: 1px solid var(--kuem-petrol);
    margin: 0;
    padding-bottom: 22px;
  }
  .kai .node-open {
    color: var(--kuem-white);
  }
  .kai > span {
    margin: 0;
    color: var(--kuem-white);
  }
  .noc {
    position: relative;
    border: 1px solid var(--kuem-carbon);
    text-align: left;
  }
  .is-muted {
    opacity: 0.85;
  }
  .architecture .is-selected {
    border-color: var(--kuem-event);
    box-shadow: 0 0 0 1px var(--kuem-event);
    background: var(--kuem-white);
  }
  .architecture .kai.is-selected {
    color: var(--kuem-white);
    background: var(--kuem-petrol);
  }
  .architecture .noc.is-selected {
    background: var(--kuem-carbon);
    color: var(--kuem-white);
  }
  .architecture:lang(en) .is-selected:before {
    content: "Selected step";
  }
  .is-selected:before {
    content: "Izbrani korak";
    position: absolute;
    right: 8px;
    top: -29px;
    background: var(--kuem-copper);
    color: var(--kuem-carbon);
    padding: 4px 8px;
    border-radius: var(--kuem-radius-control);
    font-size: var(--kuem-type-label-size);
    font-weight: 600;
    line-height: 20px;
    z-index: 5;
  }
  .platform:has(.is-selected) {
    border-color: var(--kuem-event);
  }
  .platform .kai.is-selected:before {
    display: none;
  }
  .node.is-selected,
  .noc.is-selected {
    z-index: 3;
  }
  @container (max-width:650px) {
    .architecture-grid {
      gap: 32px 18px;
    }
    .architecture strong {
      font-size: var(--kuem-type-small-size);
    }
    .architecture span {
      font-size: var(--kuem-type-small-size);
    }
    .node > :global(svg) {
      width: 56px;
      height: 48px;
    }
    .platform-open > strong {
      font-size: var(--kuem-type-body-size);
    }
    .platform-open .logo {
      height: 48px;
    }
    .kai {
      gap: 5px;
      padding: 12px 6px 24px;
    }
    .kai :global(svg) {
      width: 28px;
    }
    .kai strong {
      font-size: var(--kuem-type-body-size);
    }
    .noc {
      gap: 10px;
      padding: 16px 12px;
    }
    .noc small {
      font-size: var(--kuem-type-label-size);
    }
    .architecture-intro {
      flex-wrap: wrap;
      margin-bottom: 32px;
    }
    .architecture-intro .micro {
      margin-left: auto;
    }
  }
  @container (max-width:480px) {
    .architecture-grid {
      gap: 36px 24px;
    }
    .architecture strong {
      font-size: var(--kuem-type-small-size);
    }
    .architecture span {
      font-size: var(--kuem-type-small-size);
    }
    .platform-open .logo {
      height: 78px;
      width: 230px;
      max-width: 100%;
    }
    .platform-open > strong {
      font-size: var(--kuem-type-lead-size);
    }
    .kai {
      padding: 18px 14px 24px;
      gap: 12px;
    }
    .kai strong {
      font-size: var(--kuem-type-lead-size);
    }
    .kai :global(svg) {
      width: 40px;
    }
    .noc {
      padding: 18px 12px;
    }
    .noc small {
      font-size: var(--kuem-type-label-size);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .architecture * {
      transition: none !important;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".architecture").forEach((root) => {
    const grid = root.querySelector<HTMLElement>(".architecture-grid")!;
    const svg = root.querySelector<SVGSVGElement>(".wires")!;
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;
    let selected = -1;
    const highlight = () => {
      root.classList.toggle("has-selection", selected >= 0);
      root.querySelectorAll<HTMLElement>("[data-node]").forEach((el) => {
        const step =
          el.dataset.node === "platform" ? 3 : Number(el.dataset.solutionStep);
        el.classList.toggle("is-muted", selected >= 0 && step !== selected);
      });
      svg.querySelectorAll<SVGElement>("[data-route-steps]").forEach((el) => {
        const active =
          selected < 0 ||
          el.dataset.routeSteps?.split(" ").includes(String(selected));
        if (el.tagName !== "rect") el.style.opacity = active ? "1" : "0.18";
        if (el.tagName === "rect")
          el.style.visibility = active ? "visible" : "hidden";
      });
      svg.querySelector<SVGGElement>(".monitor-links")!.style.opacity =
        selected === 5 ? "1" : "0.55";
    };
    document.addEventListener("solution-step-change", (event) => {
      selected = (event as CustomEvent<number>).detail;
      highlight();
    });
    const ns = "http://www.w3.org/2000/svg";
    const make = (
      tag: string,
      attrs: Record<string, string>,
      parent: Element,
    ) => {
      const el = document.createElementNS(ns, tag);
      Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
      parent.append(el);
      return el;
    };
    const draw = () => {
      const bounds = grid.getBoundingClientRect();
      const mobile = root.clientWidth <= 480;
      const box = (id: string) => {
        const r = root
          .querySelector<HTMLElement>(`[data-node="${id}"]`)!
          .getBoundingClientRect();
        return {
          x: r.x - bounds.x,
          y: r.y - bounds.y,
          w: r.width,
          h: r.height,
        };
      };
      const links = svg.querySelector(".data-links")!;
      const packets = svg.querySelector(".packets")!;
      const monitors = svg.querySelector(".monitor-links")!;
      links.replaceChildren();
      packets.replaceChildren();
      monitors.replaceChildren();
      const routes = [
        ["devices", "radio", 0],
        ["radio", "platform", 0.8],
        ["systems", "api", 0],
        ["api", "platform", 0.8],
        ["platform", "action", 1.6],
      ] as const;
      // One pass of the data marker takes 2.4 s (duration.marker); it runs
      // twice and stops, inside the 5 s autoplay limit.
      const markerPass = 2.4;
      const segment = markerPass / 3;
      routes.forEach(([from, to, delay]) => {
        const a = box(from),
          b = box(to);
        let d: string;
        if (mobile) {
          const x = a.x + a.w / 2,
            y = a.y + a.h;
          const endX =
            to === "platform"
              ? b.x + b.w * (from === "radio" ? 0.28 : 0.72)
              : b.x + b.w / 2;
          const endY = b.y;
          const mid = (y + endY) / 2;
          d = `M${x} ${y}V${mid}H${endX}V${endY}`;
        } else {
          const x = a.x + a.w,
            y = from === "platform" ? b.y + b.h / 2 : a.y + a.h / 2;
          const endY = from === "api" ? b.y + b.h - 35 : y;
          d = `M${x} ${y}H${(x + b.x) / 2}V${endY}H${b.x}`;
        }
        const relevant =
          from === "systems" || from === "api"
            ? "2 3"
            : from === "platform"
              ? "3 4"
              : "0 1 3";
        make(
          "path",
          {
            d,
            fill: "none",
            style: "stroke: var(--kuem-data)",
            "stroke-width": "2",
            "marker-end": "url(#architecture-arrow)",
            "data-route-steps": relevant,
          },
          links,
        );
        const size = 6;
        const rect = make(
          "rect",
          {
            x: String(-size / 2),
            y: String(-size / 2),
            width: String(size),
            height: String(size),
            "data-route-steps": relevant,
            style: "fill: var(--kuem-event)",
          },
          packets,
        );
        if (motion.matches) {
          const p = make(
            "path",
            { d },
            document.createElementNS(ns, "g"),
          ) as SVGPathElement;
          const point = p.getPointAtLength(p.getTotalLength() * 0.5);
          rect.setAttribute("transform", `translate(${point.x} ${point.y})`);
        } else {
          rect.setAttribute("opacity", "0");
          make(
            "animateMotion",
            {
              path: d,
              dur: `${segment}s`,
              begin: `${delay}s;${delay + markerPass}s`,
              calcMode: "linear",
            },
            rect,
          );
          make(
            "animate",
            {
              attributeName: "opacity",
              values: "0;1;1;0",
              keyTimes: "0;0.1;0.9;1",
              dur: `${segment}s`,
              begin: `${delay}s;${delay + markerPass}s`,
            },
            rect,
          );
        }
      });
      const noc = box("noc");
      ["devices", "radio", "api", "platform"].forEach((id) => {
        const a = box(id);
        let d: string;
        if (mobile) {
          const left = id === "devices" || id === "radio";
          const side = left ? 5 : bounds.width - 5;
          d = `M${a.x + (left ? 0 : a.w)} ${a.y + a.h * 0.7}H${side}V${noc.y}`;
        } else {
          const x = a.x + a.w * 0.88;
          d = `M${x} ${a.y + a.h}V${noc.y}`;
        }
        make(
          "path",
          {
            d,
            fill: "none",
            style: "stroke: var(--kuem-border-strong)",
            "stroke-width": "1",
            "stroke-dasharray": "2 4",
          },
          monitors,
        );
      });
      highlight();
      svg.setCurrentTime(0);
      if (visible && !motion.matches) svg.unpauseAnimations();
      else svg.pauseAnimations();
    };
    new ResizeObserver(draw).observe(grid);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible && !motion.matches) svg.unpauseAnimations();
      else svg.pauseAnimations();
    }).observe(root);
    motion.addEventListener("change", draw);
    document.fonts.ready.then(draw);
  });
</script>
