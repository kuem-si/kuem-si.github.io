---
import { localeHome, localizedPath, type Locale } from "../lib/i18n";
import type { SolutionDetailKey } from "../data/solutionDetails";
import { solutionDetails } from "../data/solutionDetails";
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "./SectionHeader.astro";
import FeatureList from "./FeatureList.astro";
import ReferenceNameCard from "./ReferenceNameCard.astro";
import CTASection from "./CTASection.astro";
import { organization } from "../data/organization";

const { locale = "en", solutionKey } = Astro.props as {
  locale?: Locale;
  solutionKey: SolutionDetailKey;
};
const page = solutionDetails[solutionKey][locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
const solutionsHref = localizedPath("/resitve", locale);
const labels = {
  sl: {
    country: "Slovenija",
    home: "Domov",
    solutions: "Rešitve",
    eyebrow: "Rešitev",
    focus: "Kaj pokriva rešitev",
    references: "Povezane reference",
    keyMessage: "Ključno sporočilo",
    platform: "Nadzor, alarmi in integracije",
    platformText:
      "Podatki se zbirajo v platformi Nexavia, kjer so na voljo nadzorne plošče, zgodovina meritev, alarmiranje, poročila in povezave z obstoječimi sistemi.",
    ctaDescription:
      "KUEM lahko pomaga pripraviti pilot, arhitekturo in integracijski načrt.",
  },
  en: {
    country: "Slovenia",
    home: "Home",
    solutions: "Solutions",
    eyebrow: "Solution",
    focus: "What the solution covers",
    references: "Related references",
    keyMessage: "Key message",
    platform: "Dashboards, alarms and integrations",
    platformText:
      "Data is collected in the Nexavia platform, where dashboards, measurement history, alarms, reports and links to existing systems are available.",
    ctaDescription:
      "KUEM can help define the pilot, architecture and integration plan.",
  },
  de: {
    country: "Slowenien",
    home: "Startseite",
    solutions: "Lösungen",
    eyebrow: "Lösung",
    focus: "Was die Lösung abdeckt",
    references: "Zugehörige Referenzen",
    keyMessage: "Kernaussage",
    platform: "Dashboards, Alarme und Integrationen",
    platformText:
      "Die Daten werden in der Plattform Nexavia gesammelt, wo Dashboards, Messhistorie, Alarmierung, Berichte und Anbindungen an bestehende Systeme zur Verfügung stehen.",
    ctaDescription:
      "KUEM unterstützt Sie bei der Planung von Pilotprojekt, Architektur und Integrationskonzept.",
  },
}[locale];
const jsonLd = [
  {
    "@type": "Service",
    name: page.seoTitle.replace(/ \| KUEM$/, ""),
    description: page.metaDescription,
    serviceType: page.title,
    url: canonical.href,
    provider: { "@id": organization["@id"] },
    areaServed: {
      "@type": "Country",
      name: labels.country,
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: labels.home,
        item: new URL(localeHome[locale], Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: labels.solutions,
        item: new URL(solutionsHref, Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: page.title,
        item: canonical.href,
      },
    ],
  },
];
---

<MainLayout
  title={page.seoTitle}
  description={page.metaDescription}
  jsonLd={jsonLd}
>
  <section class="hero" data-scheme="carbon">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1>{page.heroHeadline ?? page.title}</h1>
        <p>{page.subtitle}</p>
      </div>
      {/* What the solution covers, listed once and in full. */}
      <aside class="panel">
        <h2>{labels.focus}</h2>
        <FeatureList items={page.focus} />
      </aside>
    </div>
  </section>

  <section>
    <div class="container">
      <article class="card">
        <h2>{labels.platform}</h2>
        <p>{labels.platformText}</p>
        {
          page.keyMessage && (
            <>
              <h3>{labels.keyMessage}</h3>
              <p>{page.keyMessage}</p>
            </>
          )
        }
      </article>
    </div>
  </section>

  {
    page.references.length > 0 && (
      <section>
        <div class="container">
          <SectionHeader title={labels.references} />
          <div class="reference-name-grid">
            {page.references.map((name) => (
              <ReferenceNameCard reference={{ name }} locale={locale} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTASection
    locale={locale}
    title={page.ctaTitle}
    description={labels.ctaDescription}
    ctaHref={page.ctaHref}
    ctaText={page.ctaText}
  />
</MainLayout>
