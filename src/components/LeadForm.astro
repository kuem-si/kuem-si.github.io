---
import { PUBLIC_CONTACT_ENDPOINT, PUBLIC_ODOO_URL } from "astro:env/client";
import type { Locale } from "../lib/i18n";
import { countries } from "../lib/countries";
import { COMPANY_EMAIL } from "../data/company";

const {
  heading = "Contact us",
  submitLabel = "Send request",
  sourcePage = "unknown",
  formId,
  locale = "en",
} = Astro.props as {
  heading?: string;
  submitLabel?: string;
  sourcePage?: string;
  formId?: string;
  locale?: Locale;
};
const statusId = `${formId || "lead"}-status`;
const countryListId = `${formId || "lead"}-countries`;
const errorId = (name: string) => `${formId || "lead"}-${name}-error`;
const endpoint = PUBLIC_CONTACT_ENDPOINT ?? null;
// Odoo's public website form route creates a crm.lead without an API key.
const odooFormUrl = PUBLIC_ODOO_URL
  ? `${new URL(PUBLIC_ODOO_URL.trim()).origin}/website/form/crm.lead`
  : null;
const copy = {
  sl: {
        firstName: "Ime",
        lastName: "Priimek",
        email: "E-pošta",
        subject: "Zadeva",
        customSubject: "Prilagojena zadeva",
        country: "Država",
        message: "Sporočilo",
        consent:
          "Soglašam, da KUEM hrani moje podatke za odgovor na povpraševanje v skladu z GDPR.",
        subjectPlaceholder: "Izberite zadevo",
        subjectPartnership: "Partnerstvo",
        subjectDemo: "Predstavitev",
        subjectInquiry: "Povpraševanje",
        subjectCustom: "Drugo",
        blocked: "Oddaja je blokirana.",
        submitting: "Pošiljanje …",
        success: "Hvala. Kmalu vas bomo kontaktirali.",
        failed: `Oddaja ni uspela. Prosimo, pišite na ${COMPANY_EMAIL}.`,
        errors: {
          firstName: "Vpišite ime.",
          lastName: "Vpišite priimek.",
          emailMissing: "Vpišite e-poštni naslov.",
          emailInvalid: "Vpišite e-poštni naslov v obliki ime@podjetje.si.",
          subject: "Izberite zadevo.",
          customSubject: "Vnesite prilagojeno zadevo.",
          message: "Napišite, kaj vas zanima.",
          consent: "Za odgovor potrebujemo vaše soglasje.",
        },
      },
  en: {
        firstName: "First name",
        lastName: "Last name",
        email: "Email",
        subject: "Subject",
        customSubject: "Custom subject",
        country: "Country",
        message: "Message",
        consent:
          "I consent to KUEM storing my data to respond to this inquiry in line with GDPR.",
        subjectPlaceholder: "Select subject",
        subjectPartnership: "Partnership",
        subjectDemo: "Presentation",
        subjectInquiry: "Inquiry",
        subjectCustom: "Other",
        blocked: "Submission blocked.",
        submitting: "Sending …",
        success: "Thank you. We will contact you shortly.",
        failed: `We could not submit the form. Please email ${COMPANY_EMAIL}.`,
        errors: {
          firstName: "Enter your first name.",
          lastName: "Enter your last name.",
          emailMissing: "Enter your email address.",
          emailInvalid: "Enter an email address like name@company.com.",
          subject: "Choose a subject.",
          customSubject: "Enter a custom subject.",
          message: "Tell us what you are interested in.",
          consent: "We need your consent to reply.",
        },
      },
  de: {
        firstName: "Vorname",
        lastName: "Nachname",
        email: "E-Mail",
        subject: "Betreff",
        customSubject: "Eigener Betreff",
        country: "Land",
        message: "Nachricht",
        consent:
          "Ich willige ein, dass KUEM meine Daten zur Beantwortung dieser Anfrage gemäß DSGVO speichert.",
        subjectPlaceholder: "Betreff auswählen",
        subjectPartnership: "Partnerschaft",
        subjectDemo: "Präsentation",
        subjectInquiry: "Anfrage",
        subjectCustom: "Sonstiges",
        blocked: "Übermittlung blockiert.",
        submitting: "Wird gesendet …",
        success: "Vielen Dank. Wir melden uns in Kürze bei Ihnen.",
        failed: `Das Formular konnte nicht gesendet werden. Bitte schreiben Sie an ${COMPANY_EMAIL}.`,
        errors: {
          firstName: "Geben Sie Ihren Vornamen ein.",
          lastName: "Geben Sie Ihren Nachnamen ein.",
          emailMissing: "Geben Sie Ihre E-Mail-Adresse ein.",
          emailInvalid: "Geben Sie eine E-Mail-Adresse wie name@firma.de ein.",
          subject: "Wählen Sie einen Betreff.",
          customSubject: "Geben Sie einen eigenen Betreff ein.",
          message: "Schreiben Sie uns, worum es geht.",
          consent: "Für eine Antwort benötigen wir Ihre Einwilligung.",
        },
      },
}[locale];
---

<form
  class="lead-form"
  id={formId}
  data-lead-form
  data-source-page={sourcePage}
  novalidate
>
  <h2>{heading}</h2>
  <div class="form-grid">
    <div class="form-field">
      <label>
        {copy.firstName}
        <input type="text" name="firstName" required autocomplete="given-name" aria-describedby={errorId("firstName")} />
      </label>
      <p class="field-error" id={errorId("firstName")} hidden></p>
    </div>
    <div class="form-field">
      <label>
        {copy.lastName}
        <input type="text" name="lastName" required autocomplete="family-name" aria-describedby={errorId("lastName")} />
      </label>
      <p class="field-error" id={errorId("lastName")} hidden></p>
    </div>
    <div class="form-field">
      <label>
        {copy.email}
        <input type="email" name="email" required autocomplete="email" aria-describedby={errorId("email")} />
      </label>
      <p class="field-error" id={errorId("email")} hidden></p>
    </div>
    <div class="form-field">
      <label>
        {copy.subject}
        <select name="subject" required aria-describedby={errorId("subject")}>
          <option value="" selected disabled>{copy.subjectPlaceholder}</option>
          <option value="partnership">{copy.subjectPartnership}</option>
          <option value="demo">{copy.subjectDemo}</option>
          <option value="inquiry">{copy.subjectInquiry}</option>
          <option value="custom">{copy.subjectCustom}</option>
        </select>
      </label>
      <p class="field-error" id={errorId("subject")} hidden></p>
    </div>
    <div class="form-field">
      <label>
        {copy.customSubject}
        <input type="text" name="customSubject" autocomplete="off" disabled aria-describedby={errorId("customSubject")} />
      </label>
      <p class="field-error" id={errorId("customSubject")} hidden></p>
    </div>
    <label>
      {copy.country}
      <input
        type="text"
        name="country"
        autocomplete="country-name"
        list={countryListId}
      />
    </label>
  </div>
  <datalist id={countryListId}>
    {countries.map((country) => <option value={country} />)}
  </datalist>
  <div class="form-field">
    <label>
      {copy.message}
      <textarea name="message" rows="5" required aria-describedby={errorId("message")}></textarea>
    </label>
    <p class="field-error" id={errorId("message")} hidden></p>
  </div>
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    class="hp"
    aria-hidden="true"
  />
  <div class="form-field">
    <label class="consent-check">
      <input type="checkbox" name="consent" value="yes" required aria-describedby={errorId("consent")} />
      {copy.consent}
    </label>
    <p class="field-error" id={errorId("consent")} hidden></p>
  </div>
  <button class="btn btn-primary" type="submit">{submitLabel}</button>
  <p id={statusId} class="form-status" role="status" aria-live="polite"></p>
</form>

<script is:inline define:vars={{ copy, endpoint, odooFormUrl }}>
  const forms = document.querySelectorAll("[data-lead-form]");

  // Inline errors in the page language (identity decision 0015): shown after
  // a field is left or on submit, cleared as soon as the value is valid.
  const ALERT_ICON =
    '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M7 17V11A5 5 0 0 1 17 11V17"/><path d="M5 17H19"/><path d="M11 20H13"/></svg>';
  const CHECK_ICON =
    '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="3" width="18" height="18"/><path d="M7 12L10 15L17 8"/></svg>';
  const errorFor = (field) => {
    if (field.disabled || field.checkValidity()) return "";
    if (field.name === "email") {
      return field.validity.valueMissing ? copy.errors.emailMissing : copy.errors.emailInvalid;
    }
    return copy.errors[field.name] || "";
  };
  const showError = (field) => {
    const message = errorFor(field);
    const box = document.getElementById(field.getAttribute("aria-describedby"));
    if (message) field.setAttribute("aria-invalid", "true");
    else field.removeAttribute("aria-invalid");
    if (!box) return !message;
    box.hidden = !message;
    box.innerHTML = message ? `${ALERT_ICON}<span></span>` : "";
    if (message) box.querySelector("span").textContent = message;
    return !message;
  };
  const setStatus = (status, text, kind) => {
    if (!status) return;
    status.className = `form-status${kind ? ` is-${kind}` : ""}`;
    status.innerHTML = kind === "ok" ? CHECK_ICON : kind === "failed" ? ALERT_ICON : "";
    status.append(text);
  };
  const setBusy = (form, busy, label) => {
    const button = form.querySelector('button[type="submit"]');
    form.toggleAttribute("aria-busy", busy);
    if (!button) return;
    if (busy) {
      button.dataset.label = button.textContent;
      button.textContent = label;
      button.setAttribute("aria-disabled", "true");
    } else {
      if (button.dataset.label) button.textContent = button.dataset.label;
      button.removeAttribute("aria-disabled");
    }
  };

  forms.forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    const checked = form.querySelectorAll("[aria-describedby]");
    checked.forEach((field) => {
      field.addEventListener("blur", () => {
        if (field.value || field.hasAttribute("aria-invalid")) showError(field);
      });
      field.addEventListener(field.type === "checkbox" || field.tagName === "SELECT" ? "change" : "input", () => {
        if (field.hasAttribute("aria-invalid") || field.type === "checkbox" || field.tagName === "SELECT") showError(field);
      });
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const target = event.currentTarget;
      const status = target.querySelector(".form-status");
      if (target.getAttribute("aria-busy") === "true") return;
      const invalid = [...checked].filter((field) => !showError(field));
      if (invalid.length) {
        setStatus(status, "", "");
        invalid[0].focus();
        return;
      }
      const data = new FormData(target);
      const subject = String(data.get("subject") || "");
      const customSubject = String(data.get("customSubject") || "").trim();

      if (data.get("website")) {
        setStatus(status, copy.blocked, "failed");
        return;
      }

      const payload = {
        sourcePage: target.dataset.sourcePage,
        firstName: String(data.get("firstName") || ""),
        lastName: String(data.get("lastName") || ""),
        email: String(data.get("email") || ""),
        subject,
        customSubject,
        country: String(data.get("country") || ""),
        message: String(data.get("message") || ""),
        consent: data.get("consent") === "yes",
      };

      setStatus(status, "", "");
      setBusy(target, true, copy.submitting);

      if (odooFormUrl) {
        const subjectSelect = target.querySelector('select[name="subject"]');
        const subjectLabel =
          subject === "custom"
            ? customSubject
            : subjectSelect?.selectedOptions[0]?.text || subject;
        // Whitelisted crm.lead fields; any other field is appended by Odoo
        // to the lead description.
        const odooData = new FormData();
        odooData.append("name", `${subjectLabel} – ${payload.firstName} ${payload.lastName}`);
        odooData.append("contact_name", `${payload.firstName} ${payload.lastName}`);
        odooData.append("email_from", payload.email);
        odooData.append("description", payload.message);
        if (payload.country) odooData.append("Country", payload.country);
        odooData.append("Source page", payload.sourcePage || "");
        odooData.append("GDPR consent", payload.consent ? "yes" : "no");

        try {
          // Odoo sends no CORS headers, so the response is opaque; a network
          // error is the only failure that can be detected here.
          await fetch(odooFormUrl, {
            method: "POST",
            mode: "no-cors",
            body: odooData,
          });
          setBusy(target, false);
          setStatus(status, copy.success, "ok");
          target.reset();
        } catch (error) {
          setBusy(target, false);
          setStatus(status, copy.failed, "failed");
        }
        return;
      }

      if (!endpoint) {
        setBusy(target, false);
        setStatus(status, copy.failed, "failed");
        return;
      }

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Request failed");
        }

        setBusy(target, false);
        setStatus(status, copy.success, "ok");
        target.reset();
      } catch (error) {
        setBusy(target, false);
        setStatus(status, copy.failed, "failed");
      }
    });

    const subjectField = form.querySelector('select[name="subject"]');
    const customSubjectField = form.querySelector(
      'input[name="customSubject"]',
    );
    const syncCustomSubjectState = () => {
      if (!subjectField || !customSubjectField) return;
      const isCustom = subjectField.value === "custom";
      customSubjectField.disabled = !isCustom;
      customSubjectField.required = isCustom;
      if (!isCustom) {
        customSubjectField.value = "";
        showError(customSubjectField);
      }
    };
    if (subjectField && customSubjectField) {
      subjectField.addEventListener("change", syncCustomSubjectState);
      syncCustomSubjectState();
    }
  });
</script>
