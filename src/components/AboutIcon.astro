---
import KuemIcon from "./KuemIcon.astro";
const { name } = Astro.props as { name: string };
// About page names -> KUEM icon set.
const map: Record<string, string> = {
  software: "software",
  connectivity: "gateway",
  integration: "integration",
  field: "sensor",
  location: "location",
  presence: "presence",
  knowledge: "knowledge",
  people: "people",
  document: "document",
  dialog: "dialog",
  shield: "shield",
  infinity: "continuity",
};
---

<KuemIcon name={map[name] ?? name} />
