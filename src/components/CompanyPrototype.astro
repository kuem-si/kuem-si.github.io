---
import { buildLocalizedPath, type RouteId } from "../config/routes";
import type { Locale } from "../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const isSlovenian = locale === "sl";
const href = (routeId: RouteId) => buildLocalizedPath(locale, routeId);

const partners = [
  "CMC Group",
  "Domplan",
  "Kolektor",
  "Senzemo",
  "Sparkasse",
  "TELE Group",
  "Telekom Slovenije",
];

const services = isSlovenian
  ? [
      {
        number: "01",
        title: "Razvoj programske opreme",
        description: "Skalabilne spletne, mobilne in zaledne rešitve, razvite okoli vaših poslovnih ciljev.",
        route: "service-development" as RouteId,
      },
      {
        number: "02",
        title: "Arhitektura in svetovanje",
        description: "Tehnične odločitve, modernizacija sistemov in načrtovanje robustnih platform.",
        route: "service-architecture" as RouteId,
      },
      {
        number: "03",
        title: "DevOps in platforme",
        description: "Avtomatizirane, opazljive in varne platforme za hitrejšo dostavo programske opreme.",
        route: "service-devops" as RouteId,
      },
    ]
  : [
      {
        number: "01",
        title: "Software development",
        description: "Scalable web, mobile, and backend solutions designed around your business goals.",
        route: "service-development" as RouteId,
      },
      {
        number: "02",
        title: "Architecture and consulting",
        description: "Technical decisions, system modernization, and the design of robust platforms.",
        route: "service-architecture" as RouteId,
      },
      {
        number: "03",
        title: "DevOps and platforms",
        description: "Automated, observable, and secure platforms for faster software delivery.",
        route: "service-devops" as RouteId,
      },
    ];

const processSteps = isSlovenian
  ? [
      ["Razumevanje", "Najprej uskladimo cilje, uporabnike in tehnične omejitve."],
      ["Načrt", "Določimo arhitekturo, obseg in jasne korake izvedbe."],
      ["Izvedba", "Rešitev razvijamo iterativno, pregledno in merljivo."],
      ["Rast", "Po uvedbi sistem spremljamo, izboljšujemo in nadgrajujemo."],
    ]
  : [
      ["Discover", "We align goals, users, and technical constraints first."],
      ["Design", "We define the architecture, scope, and clear delivery steps."],
      ["Deliver", "We build iteratively with transparent, measurable progress."],
      ["Evolve", "After launch, we monitor, improve, and extend the system."],
    ];
---

<div class="company-home">
  <section class="hero-panel" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">KUEM / {isSlovenian ? "Digitalni inženiring" : "Digital engineering"}</p>
      <h1 id="home-title">
        {
          isSlovenian ? (
            <>Od ideje do <span>zanesljive digitalne rešitve.</span></>
          ) : (
            <>From an idea to a <span>reliable digital solution.</span></>
          )
        }
      </h1>
      <p class="hero-lead">
        {
          isSlovenian
            ? "Načrtujemo, razvijamo in povezujemo programske sisteme, ki poenostavijo kompleksne procese in rastejo skupaj z vašim podjetjem."
            : "We design, build, and connect software systems that simplify complex processes and grow with your business."
        }
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={href("services")}>
          {isSlovenian ? "Oglejte si storitve" : "Explore our services"}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-secondary" href={href("contact")}>
          {isSlovenian ? "Pogovorimo se" : "Let's talk"}
        </a>
      </div>
    </div>

    <div class="hero-logo" aria-label="KUEM">
      <span>KUEM</span>
      <small>{isSlovenian ? "Programski inženiring" : "Software engineering"}</small>
    </div>
  </section>

  <section class="partner-strip" aria-label={isSlovenian ? "Poslovni partnerji" : "Business partners"}>
    <p>{isSlovenian ? "Zaupajo nam" : "Trusted by"}</p>
    <ul>
      {partners.map((partner) => <li>{partner}</li>)}
    </ul>
  </section>

  <section class="about-section section-shell" aria-labelledby="about-title">
    <div class="section-heading">
      <p class="eyebrow">KUEM / 01</p>
      <h2 id="about-title">{isSlovenian ? "O nas" : "About us"}</h2>
      <p class="heading-note">
        {
          isSlovenian
            ? "Tehnologija ima največjo vrednost takrat, ko ljudem omogoči boljše delo."
            : "Technology creates the most value when it enables people to work better."
        }
      </p>
    </div>

    <div class="about-body">
      {
        isSlovenian ? (
          <>
            <p>Smo strokovna ekipa inženirjev programske opreme z bogatimi izkušnjami pri vodenju in sodelovanju na zahtevnih projektih v različnih panogah, med drugim na področjih telekomunikacij, bančništva, zavarovalništva, proizvodnih informacijskih sistemov, pametnih mest ter številnih drugih.</p>
            <p>Naša specializacija je usmerjena v razvoj visoko skalabilnih in robustnih programskih rešitev ter njihovo učinkovito integracijo z obstoječimi in novimi sistemi.</p>
            <p>Z obsežnim znanjem in dolgoletnimi izkušnjami našim strankam pomagamo razvijati kakovostne, sodobne in zanesljive programske rešitve, ki jim omogočajo večjo učinkovitost ter ohranjanje konkurenčnosti na globalnem trgu.</p>
          </>
        ) : (
          <>
            <p>We are a professional team of software engineers with extensive experience in leading and collaborating on demanding projects across various industries, including telecommunications, banking, insurance, manufacturing information systems, smart cities, and many others.</p>
            <p>We specialize in developing highly scalable and robust software solutions and integrating them effectively with both existing and new systems.</p>
            <p>With broad expertise and many years of experience, we help our clients develop high-quality, modern, and reliable software solutions that improve efficiency and maintain competitiveness in the global market.</p>
          </>
        )
      }

      <div class="strengths" aria-label={isSlovenian ? "Naše prednosti" : "Our strengths"}>
        <div><strong>{isSlovenian ? "Več panog" : "Cross-industry"}</strong><span>{isSlovenian ? "Širok pogled" : "Broad perspective"}</span></div>
        <div><strong>{isSlovenian ? "Od ideje do produkcije" : "Idea to production"}</strong><span>{isSlovenian ? "Celovita izvedba" : "End-to-end delivery"}</span></div>
        <div><strong>{isSlovenian ? "Dolgoročno" : "Long-term"}</strong><span>{isSlovenian ? "Zanesljivo partnerstvo" : "Reliable partnership"}</span></div>
      </div>
    </div>
  </section>

  <section class="services-section section-shell" aria-labelledby="services-title">
    <div class="services-intro">
      <div>
        <p class="eyebrow">KUEM / 02</p>
        <h2 id="services-title">{isSlovenian ? "Kaj gradimo" : "What we build"}</h2>
      </div>
      <p>
        {
          isSlovenian
            ? "Prava kombinacija razvoja, arhitekture in avtomatizacije za stabilne digitalne produkte."
            : "The right combination of development, architecture, and automation for dependable digital products."
        }
      </p>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <a class="service-card" href={href(service.route)}>
          <span class="service-number">{service.number}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <span class="card-link">{isSlovenian ? "Več o storitvi" : "Explore service"} <b aria-hidden="true">↗</b></span>
        </a>
      ))}
    </div>
  </section>

  <section class="solutions-section section-shell" aria-labelledby="solutions-title">
    <div class="solution-copy">
      <p class="eyebrow">KUEM / 03</p>
      <h2 id="solutions-title">{isSlovenian ? "Rešitve za resnične izzive" : "Solutions for real challenges"}</h2>
      <p>
        {
          isSlovenian
            ? "Poleg razvoja po meri ustvarjamo osredotočene produkte, ki kompleksne podatke in delovne tokove spreminjajo v jasne odločitve."
            : "Alongside custom development, we create focused products that turn complex data and workflows into clear decisions."
        }
      </p>
      <a class="text-link" href={href("solutions")}>{isSlovenian ? "Raziščite vse rešitve" : "Explore all solutions"} <span aria-hidden="true">→</span></a>
    </div>

    <div class="solution-stack">
      <a href={href("solution-nexavia")} class="solution-card solution-card-primary">
        <small>{isSlovenian ? "Digitalna platforma" : "Digital platform"}</small>
        <strong>Nexavia</strong>
        <span>{isSlovenian ? "Povezani procesi, podatki in ekipe." : "Connected processes, data, and teams."}</span>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </section>

  <section class="process-section section-shell" aria-labelledby="process-title">
    <div class="process-heading">
      <p class="eyebrow">KUEM / 04</p>
      <h2 id="process-title">{isSlovenian ? "Od vprašanja do delujočega sistema" : "From a question to a working system"}</h2>
    </div>
    <ol class="process-list">
      {processSteps.map(([title, description], index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><strong>{title}</strong><p>{description}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="contact-section" aria-labelledby="contact-title">
    <div class="contact-message">
      <p class="eyebrow">KUEM / 05</p>
      <h2 id="contact-title">{isSlovenian ? "Imate idejo ali tehnični izziv?" : "Have an idea or a technical challenge?"}</h2>
      <p>{isSlovenian ? "Povejte nam, kaj želite zgraditi. Skupaj bomo poiskali pravo pot do izvedbe." : "Tell us what you want to build. Together, we will find the right path to delivery."}</p>
      <a class="button button-light" href={href("contact")}>{isSlovenian ? "Začnimo pogovor" : "Start a conversation"} <span aria-hidden="true">↗</span></a>
    </div>

    <address class="contact-details">
      <p>{isSlovenian ? "Najdete nas" : "Find us"}</p>
      <strong>KUEM d.o.o.</strong>
      <span>Ljubljanska cesta 24g</span>
      <span>4000 Kranj, Slovenija</span>
      <a href="tel:+38659013416">+386 5 901 34 16</a>
      <a href="mailto:info@kuem.si">info@kuem.si</a>
      <a class="directions-link" href="https://www.google.com/maps/search/?api=1&query=Ljubljanska+cesta+24g+4000+Kranj" target="_blank" rel="noreferrer">
        {isSlovenian ? "Prikaži pot ↗" : "Get directions ↗"}
      </a>
    </address>
  </section>

  <details class="chat-widget">
    <summary aria-label={isSlovenian ? "Odpri pomoč" : "Open help"}>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 5h14v10H9l-4 4V5Z"></path></svg>
    </summary>
    <div>
      <strong>{isSlovenian ? "Kako vam lahko pomagamo?" : "How can we help?"}</strong>
      <p>{isSlovenian ? "Pišite nam in odgovorili vam bomo v najkrajšem možnem času." : "Send us a message and we will reply as soon as possible."}</p>
      <a href="mailto:info@kuem.si">info@kuem.si</a>
    </div>
  </details>
</div>

<style>
  .company-home {
    --ink: #0c2145;
    --muted: #526b98;
    --blue: #1268eb;
    --cyan: #49b9ff;
    --line: rgba(176, 205, 248, 0.8);
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 8vw, 7rem);
    padding: 1.2rem 0 4rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--blue);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-shell {
    padding-inline: clamp(0rem, 2vw, 1.5rem);
  }

  .hero-panel {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: 39rem;
    padding: clamp(2rem, 6vw, 5rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 95% 0%, rgba(78, 157, 255, 0.23), transparent 34%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(237, 246, 255, 0.94));
    box-shadow: 0 35px 90px rgba(37, 79, 145, 0.15);
  }

  .hero-panel::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.35;
    background-image:
      linear-gradient(rgba(61, 126, 221, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 126, 221, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(90deg, transparent, #000);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3rem, 6.2vw, 5.5rem);
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .hero-copy h1 span {
    color: var(--blue);
  }

  .hero-lead {
    max-width: 57ch;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 3.25rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 650;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #176fee, #0955c5);
    color: #fff;
    box-shadow: 0 14px 30px rgba(18, 104, 235, 0.24);
  }

  .button-secondary {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.72);
    color: var(--ink);
  }

  .hero-logo {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 24rem;
    align-content: center;
    color: var(--ink);
    text-align: center;
  }

  .hero-logo::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: min(30rem, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(66, 148, 255, 0.2), rgba(113, 180, 255, 0.06) 45%, transparent 70%);
  }

  .hero-logo span {
    font-size: clamp(4.5rem, 10vw, 8.25rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.9;
    text-shadow: 0 18px 48px rgba(28, 77, 151, 0.16);
  }

  .hero-logo small {
    margin-top: 1.25rem;
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .partner-strip {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1rem;
  }

  .partner-strip > p {
    margin: 0;
    color: var(--blue);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .partner-strip ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partner-strip li {
    color: #4b628b;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(13rem, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .section-heading {
    position: static;
  }

  .section-heading h2,
  .services-intro h2,
  .solution-copy h2,
  .process-heading h2,
  .contact-message h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 4.6rem);
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .heading-note {
    max-width: 25rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .about-body > p {
    margin: 0;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.8;
  }

  .about-body > p:first-child {
    padding-top: 0;
    color: #2c4877;
    font-weight: 560;
  }

  .strengths {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .strengths div {
    min-height: 8rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.66);
  }

  .strengths strong,
  .strengths span {
    display: block;
  }

  .strengths strong {
    color: var(--ink);
    line-height: 1.25;
  }

  .strengths span {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .services-section {
    display: grid;
    gap: 2rem;
  }

  .services-intro {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 0.72fr);
    align-items: end;
    gap: 2rem;
  }

  .services-intro > p,
  .solution-copy > p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }

  .service-card {
    position: relative;
    display: flex;
    min-height: 23rem;
    flex-direction: column;
    padding: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.72);
    color: inherit;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .service-card::before {
    content: "";
    position: absolute;
    right: -4rem;
    bottom: -5rem;
    width: 12rem;
    height: 12rem;
    border: 1px solid rgba(69, 145, 245, 0.24);
    border-radius: 50%;
    box-shadow: 0 0 0 2.2rem rgba(48, 128, 238, 0.04), 0 0 0 4.4rem rgba(48, 128, 238, 0.03);
  }

  .service-card:hover {
    border-color: #84b2f5;
    transform: translateY(-6px);
    box-shadow: 0 22px 50px rgba(37, 79, 145, 0.13);
  }

  .service-number {
    color: var(--blue);
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .service-card h3 {
    max-width: 12ch;
    margin: 3.6rem 0 1rem;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .service-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .card-link {
    z-index: 1;
    margin-top: auto;
    color: var(--blue);
    font-size: 0.84rem;
    font-weight: 650;
  }

  .card-link b {
    margin-left: 0.35rem;
  }

  .solutions-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(22rem, 1.2fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .solution-copy h2 {
    margin-bottom: 1.5rem;
  }

  .text-link {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 1.6rem;
    color: var(--blue);
    font-weight: 650;
    text-decoration: none;
  }

  .solution-stack {
    display: grid;
    min-height: 27rem;
    place-items: center;
  }

  .solution-card {
    position: relative;
    display: flex;
    width: min(100%, 29rem);
    min-height: 23rem;
    flex-direction: column;
    padding: 1.6rem;
    border-radius: 1.5rem;
    text-decoration: none;
    box-shadow: 0 28px 65px rgba(22, 57, 112, 0.2);
    transition: transform 220ms ease;
  }

  .solution-card:hover {
    transform: translateY(-6px) rotate(0deg);
  }

  .solution-card-primary {
    background: linear-gradient(145deg, #0f2d59, #071a37);
    color: #fff;
    transform: rotate(-1.5deg);
  }

  .solution-card small {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0.68;
    text-transform: uppercase;
  }

  .solution-card strong {
    margin-top: auto;
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    letter-spacing: -0.05em;
  }

  .solution-card span {
    max-width: 22ch;
    margin-top: 0.5rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  .solution-card b {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    font-size: 1.2rem;
  }

  .process-section {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .process-heading {
    max-width: 48rem;
  }

  .process-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    position: relative;
    padding: 1.3rem;
    border-left: 1px solid var(--line);
  }

  .process-list li:last-child {
    border-right: 1px solid var(--line);
  }

  .process-list > li > span {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 700;
  }

