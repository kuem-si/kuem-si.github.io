---
import { Image } from "astro:assets";
import type { Locale } from "../lib/i18n";
import flowSl from "../../assets/diagrams/nexavia-flow-sl.png";
import flowEn from "../../assets/diagrams/nexavia-flow-en.png";

const { locale = "en" } = Astro.props as { locale?: Locale };

const images = {
  sl: {
    src: flowSl,
    alt: "Shema platforme Nexavia: števci, senzorji in naprave se povežejo prek komunikacijskih tehnologij v platformo Nexavia, kjer nastanejo nadzorne plošče, alarmi, poročila in integracije.",
    openLabel: "Povečaj shemo platforme Nexavia",
    closeLabel: "Zapri povečano shemo platforme Nexavia",
    modalLabel: "Povečana shema platforme Nexavia",
  },
  en: {
    src: flowEn,
    alt: "Nexavia platform diagram: meters, sensors and devices connect through communication technologies into the Nexavia platform, producing dashboards, alarms, reports and integrations.",
    openLabel: "Enlarge the Nexavia platform diagram",
    closeLabel: "Close enlarged Nexavia platform diagram",
    modalLabel: "Enlarged Nexavia platform diagram",
  },
};

const image = images[locale];
const modalId = `nexavia-flow-lightbox-${locale}`;
---

<figure class="nexavia-architecture-visual" data-nexavia-lightbox>
  <button
    class="nexavia-architecture-trigger"
    type="button"
    aria-label={image.openLabel}
    aria-haspopup="dialog"
    aria-controls={modalId}
    data-nexavia-open
  >
    <Image
      src={image.src}
      alt={image.alt}
      width="1448"
      height="1086"
      loading="eager"
      decoding="async"
      format="avif"
      quality="90"
    />
  </button>

  <div
    class="nexavia-lightbox"
    id={modalId}
    role="dialog"
    aria-modal="true"
    aria-label={image.modalLabel}
    hidden
    data-nexavia-modal
  >
    <button
      class="nexavia-lightbox-backdrop"
      type="button"
      aria-label={image.closeLabel}
      data-nexavia-close></button>
    <div class="nexavia-lightbox-content">
      <button
        class="nexavia-lightbox-close"
        type="button"
        aria-label={image.closeLabel}
        data-nexavia-close>×</button
      >
      <Image
        src={image.src}
        alt={image.alt}
        width="1448"
        height="1086"
        decoding="async"
        format="avif"
        quality="90"
      />
    </div>
  </div>
</figure>

<script>
  (() => {
    const lightboxWindow = window as Window & {
      __nexaviaLightboxInitialized?: boolean;
    };
    if (lightboxWindow.__nexaviaLightboxInitialized) return;
    lightboxWindow.__nexaviaLightboxInitialized = true;

    let activeModal: HTMLElement | null = null;
    let activeTrigger: HTMLButtonElement | null = null;

    const closeModal = () => {
      if (!activeModal) return;

      activeModal.hidden = true;
      document.body.classList.remove("is-lightbox-open");
      activeTrigger?.focus();
      activeModal = null;
      activeTrigger = null;
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const openButton = target.closest("[data-nexavia-open]");
      const closeButton = target.closest("[data-nexavia-close]");

      if (openButton instanceof HTMLButtonElement) {
        const wrapper = openButton.closest("[data-nexavia-lightbox]");
        const modal = wrapper?.querySelector<HTMLElement>(
          "[data-nexavia-modal]",
        );

        if (modal) {
          activeModal = modal;
          activeTrigger = openButton;
          modal.hidden = false;
          document.body.classList.add("is-lightbox-open");
          modal
            .querySelector<HTMLButtonElement>("[data-nexavia-close]")
            ?.focus();
        }
      }

      if (closeButton) {
        closeModal();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeModal();
      }
    });
  })();
</script>
