---
import type { Locale } from "../lib/i18n";
import { getEquivalentLocalePath } from "../data/routes";
import { withBase } from "../lib/paths";

const {
  locale = "en",
  pathname = Astro.url.pathname,
  compact = false,
} = Astro.props as { locale?: Locale; pathname?: string; compact?: boolean };

const languages = [
  {
    code: "sl",
    label: "Slovenian",
    nativeLabel: "Slovenščina",
    available: true,
  },
  { code: "en", label: "English", nativeLabel: "English", available: true },
  { code: "de", label: "German", nativeLabel: "Deutsch", available: false },
  { code: "hr", label: "Croatian", nativeLabel: "Hrvatski", available: false },
  { code: "it", label: "Italian", nativeLabel: "Italiano", available: false },
];
---

<div
  class:list={["language-switcher", { "language-switcher-compact": compact }]}
  data-language-switcher
>
  <button
    type="button"
    class="language-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={locale === "sl" ? "Izberi jezik" : "Choose language"}
    data-language-trigger
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20"></path>
      <path d="M12 2a15.3 15.3 0 0 1 0 20"></path>
      <path d="M12 2a15.3 15.3 0 0 0 0 20"></path>
    </svg>
    <span>{locale.toUpperCase()}</span>
  </button>
  <div class="language-menu" hidden data-language-menu>
    {
      languages.map((item) =>
        item.available ? (
          <a
            href={withBase(
              getEquivalentLocalePath(pathname, item.code as Locale),
            )}
            aria-current={item.code === locale ? "true" : undefined}
            lang={item.code}
          >
            <span>{item.nativeLabel}</span>
            <small>{item.label}</small>
          </a>
        ) : (
          <span
            class="language-option-disabled"
            aria-disabled="true"
            lang={item.code}
          >
            <span>{item.nativeLabel}</span>
            <small>{item.label}</small>
          </span>
        ),
      )
    }
  </div>
</div>
