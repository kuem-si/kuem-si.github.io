---
interface Props {
  to: string;
}
const { to } = Astro.props;
const target = new URL(to, Astro.site ?? "https://www.kuem.si");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting…</title>
    <link rel="canonical" href={target.href} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${target.href}`} />
    <script is:inline define:vars={{ target: to }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p>This page has moved to <a href={target.href}>{target.href}</a>.</p>
  </body>
</html>
