---
import logo from "../assets/brand/nexavia/official/NEXAVIA-web-Black.svg";
import Icon from "./homepage/LineIcon.astro";
import type { Locale } from "../lib/i18n";
import "../styles/flow-primitives.css";

const { locale } = Astro.props as { locale: Locale };
const copy = {
  sl: {
    eyebrow: "POVEZLJIVA Z VAŠIM OKOLJEM",
    title: ["Vaši sistemi ostanejo.", "Podatki se povežejo."],
    lead: "Naprave, poslovni sistemi in zunanji viri se prek standardnih vmesnikov združijo v enoten operativni pogled.",
    checks: ["Brez nepotrebne zamenjave obstoječih sistemov", "Postopna uvedba glede na vaše potrebe"],
    link: "Kako poteka integracija",
    linkHref: "/resitve/integracije",
    sourcesLabel: "VIRI",
    platformTagline: "Povezovanje · obdelava · pravila · enoten podatkovni model",
    outcomesLabel: "UPORABA",
    sources: [
      ["device", "Naprave", "Senzorji, števci in telemetrija"],
      ["database", "Obstoječi sistemi", "ERP, SCADA in GIS"],
      ["api", "Zunanji viri", "Vreme in javni podatki"],
    ],
    outcomes: [
      ["eye", "Pregled stanja", "Enoten operativni pogled"],
      ["bell", "Opozorila", "Dogodki, ki zahtevajo pozornost"],
      ["screen", "Poročila", "Podatki za načrtovanje"],
      ["chart", "KAI analiza", "Odstopanja in priporočila"],
    ],
    features: [
      ["Vloge in dostopi", "Nadzorovan dostop do podatkov in funkcionalnosti."],
      ["Sledljivost sprememb", "Evidenca aktivnosti in sprememb."],
      ["Prilagodljiva uvedba", "Postopna uvedba glede na vaše potrebe."],
    ],
  },
  en: {
    eyebrow: "CONNECTED TO YOUR ENVIRONMENT",
    title: ["Your systems remain.", "Your data comes together in Nexavia."],
    lead: "Devices, business systems and external sources connect through standard interfaces in one operational view.",
    checks: ["No unnecessary replacement of existing systems", "Phased implementation tailored to your needs"],
    link: "How integration works",
    linkHref: "/en/solutions/integrations",
    sourcesLabel: "SOURCES",
    platformTagline: "Connectivity · processing · rules · unified data model",
    outcomesLabel: "USE",
    sources: [
      ["device", "Devices", "Sensors, meters and telemetry"],
      ["database", "Existing systems", "ERP, SCADA and GIS"],
      ["api", "External sources", "Weather and public data"],
    ],
    outcomes: [
      ["eye", "Status overview", "One operational view"],
      ["bell", "Alerts", "Events that require attention"],
      ["screen", "Reports", "Data for planning"],
      ["chart", "KAI analysis", "Deviations and recommendations"],
    ],
    features: [
      ["Roles and access", "Controlled access to data and functionality."],
      ["Audit trail", "Record of activity and changes."],
      ["Adaptable implementation", "Phased implementation tailored to your needs."],
    ],
  },
}[locale];
---

<section class="nx-section nx-integrations" aria-labelledby="nx-integrations-title">
  <div class="container nx-integration-layout">
    <div class="nx-integration-copy">
      <p class="nx-eyebrow">{copy.eyebrow}</p>
      <h2 id="nx-integrations-title">{copy.title.map((line) => <span>{line}</span>)}</h2>
      <p class="nx-integration-lead">{copy.lead}</p>
      <ul class="nx-integration-checks">
        {copy.checks.map((check) => <li><Icon name="check" /><span>{check}</span></li>)}
      </ul>
      <a href={copy.linkHref} class="nx-integration-link">{copy.link} <span aria-hidden="true">→</span></a>
    </div>
    <div class="nx-integration-content">
      <div class="nx-integration-flow">
        <div class="nx-flow-group nx-flow-sources">
          <h3 class="nx-eyebrow">{copy.sourcesLabel}</h3>
          <ul>
            {copy.sources.map(([icon, title, detail]) => (
              <li class="nx-flow-card"><Icon name={icon} /><div><strong>{title}</strong><small>{detail}</small></div></li>
            ))}
          </ul>
        </div>
        <span class="nx-integration-connector" aria-hidden="true"></span>
        <div class="nx-flow-group nx-flow-platform">
          <h3 class="nx-eyebrow">NEXAVIA</h3>
          <div class="nx-flow-card nx-platform-box">
            <img src={logo.src} width="1200" height="360" alt="Nexavia" loading="lazy" decoding="async" />
            <p>{copy.platformTagline}</p>
          </div>
        </div>
        <span class="nx-integration-connector nx-integration-output" aria-hidden="true"></span>
        <div class="nx-flow-group nx-flow-outcomes">
          <h3 class="nx-eyebrow">{copy.outcomesLabel}</h3>
          <ul>
            {copy.outcomes.map(([icon, title, detail]) => (
              <li class="nx-flow-card"><Icon name={icon} /><strong>{title}</strong><small>{detail}</small></li>
            ))}
          </ul>
        </div>
      </div>
      <ul class="nx-integration-features">
        {copy.features.map(([title, detail]) => <li><strong>{title}</strong><small>{detail}</small></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .nx-integrations { background: #f7fcff; }
  .nx-integration-layout {
    width: min(1500px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
    align-items: center;
  }
  .nx-integration-copy h2 {
    font-size: clamp(25px, 2.6vw, 38px);
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .nx-integration-copy h2 span { display: block; }
  .nx-integration-lead { color: var(--muted); max-width: 43ch; }
  .nx-integrations ul { list-style: none; margin: 0; padding: 0; }
  .nx-integrations .nx-integration-checks { display: grid; gap: 1rem; margin: 2rem 0; }
  .nx-integration-checks li { display: flex; gap: 0.75rem; align-items: center; }
  .nx-integrations :global(.hp-icon) { width: 26px; height: 26px; flex: none; color: var(--kuem-petrol); }
  .nx-integration-link { display: inline-flex; gap: 1rem; color: var(--kuem-petrol); border-bottom: 1px solid currentColor; padding-bottom: 0.35rem; }
  .nx-integration-content { min-width: 0; }
  .nx-integration-flow {
    --flow-link-size: 24px;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) var(--flow-link-size) minmax(0, 1fr) var(--flow-link-size) minmax(0, 1.35fr);
    align-items: stretch;
  }
  .nx-flow-group { display: grid; grid-template-rows: auto 1fr; min-width: 0; }
  .nx-flow-group h3 { font-family: inherit; line-height: 1.5; }
  .nx-flow-group ul { display: grid; gap: 0.75rem; }
  .nx-flow-card { min-width: 0; padding: 1rem; }
  .nx-flow-card strong { display: block; font-size: 16px; line-height: 1.3; }
  .nx-flow-card small,
  .nx-platform-box p,
  .nx-integration-features small { display: block; font-size: 14px; line-height: 1.35; color: var(--muted); margin-top: 0.4rem; }
  .nx-flow-sources li { display: flex; gap: 0.75rem; align-items: center; min-height: 90px; }
  .nx-platform-box { align-self: center; text-align: center; padding: 1.5rem 1rem; min-height: 210px; display: flex; flex-direction: column; justify-content: center; border-color: var(--kuem-petrol); }
  .nx-platform-box img { display: block; width: 100%; height: auto; }
  .nx-platform-box p { margin: 1rem 0 0; }
  .nx-flow-outcomes ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .nx-flow-outcomes li { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .nx-flow-outcomes :global(.hp-icon) { margin-bottom: 0.75rem; }
  .nx-integration-connector { align-self: center; margin-top: 2rem; width: var(--flow-link-size); }
  .nx-integration-connector:before { opacity: 0; animation: nx-integration-travel 10s linear infinite paused; }
  .nx-integration-output:before { animation-delay: 5s; }
  .nx-integrations[data-flow-running="true"] .nx-integration-connector:before { animation-play-state: running; }
  @keyframes nx-integration-travel {
    0%, 50%, 100% { opacity: 0; transform: translateX(0); }
    5% { opacity: 1; transform: translateX(0); }
    40% { opacity: 1; transform: translateX(calc(var(--flow-link-size) - 4px)); }
    45% { opacity: 0; transform: translateX(calc(var(--flow-link-size) - 4px)); }
  }
  .nx-integrations .nx-integration-features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; border-top: 1px solid var(--line); margin-top: 1.5rem; padding-top: 1.5rem; }
  .nx-integration-features strong { display: block; font-size: 14px; line-height: 1.35; }
  @media (max-width: 1180px) {
    .nx-integration-layout { grid-template-columns: 1fr; }
    .nx-integration-copy { max-width: 65ch; }
    .nx-integration-lead { max-width: none; }
  }
  @media (max-width: 700px) {
    .nx-integration-layout { width: calc(100% - 2rem); }
    .nx-integration-flow { display: flex; flex-direction: column; }
    .nx-integration-connector { align-self: center; transform: rotate(90deg); margin: 1.5rem 0; }
    .nx-flow-sources li { min-height: 0; }
    .nx-platform-box { align-self: stretch; min-height: 180px; }
    .nx-platform-box img { width: min(230px, 100%); margin-inline: auto; }
    .nx-flow-outcomes li { min-height: 138px; }
    .nx-integrations .nx-integration-features { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nx-integration-connector:before { animation: none; opacity: 1; transform: translateX(calc(var(--flow-link-size) / 2)); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".nx-integrations").forEach((section) => {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let visible = false;
    const update = () => { section.dataset.flowRunning = String(visible && !document.hidden && !reduced.matches); };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }, { threshold: 0.15 }).observe(section);
    document.addEventListener("visibilitychange", update);
    reduced.addEventListener("change", update);
  });
</script>
