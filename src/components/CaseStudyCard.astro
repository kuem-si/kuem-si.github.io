---
import type { CaseStudy } from "../lib/content";
import type { Locale } from "../lib/i18n";

const { item, locale = "en" } = Astro.props as {
  item: CaseStudy;
  locale?: Locale;
};
const labels = {
  sl: ["Izziv:", "Rešitev:", "Uvedba:"],
  en: ["Challenge:", "Solution:", "Deployment:"],
  de: ["Herausforderung:", "Lösung:", "Umsetzung:"],
}[locale];
---

<article class="card">
  <p class="eyebrow">{item.vertical}</p>
  <h3>{item.title}</h3>
  <p>
    <strong>{labels[0]}</strong>
    {item.challenge}
  </p>
  <p>
    <strong>{labels[1]}</strong>
    {item.solution}
  </p>
  <p>
    <strong>{labels[2]}</strong>
    {item.deployment}
  </p>
  <ul>
    {item.results.map((result) => <li>{result}</li>)}
  </ul>
</article>
