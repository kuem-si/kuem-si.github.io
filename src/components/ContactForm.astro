<form id="contact-form">
  <label>
    Name
    <input type="text" name="name" required />
  </label>
  <label>
    Email
    <input type="email" name="email" required />
  </label>
  <label>
    Message
    <textarea name="message" rows="6" required></textarea>
  </label>

  <div class="cf-turnstile" data-sitekey="YOUR_TURNSTILE_SITEKEY"></div>

  <button type="submit">Send message</button>
</form>

<div id="status" aria-live="polite"></div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>
<script>
  (() => {
    const workerUrl = "https://YOUR_WORKER_URL_HERE/submit";
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const status = document.querySelector<HTMLElement>("#status");

    if (!form || !status) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const token = document.querySelector<HTMLInputElement>(
        'input[name="cf-turnstile-response"]',
      )?.value;

      if (!token) {
        status.textContent = "Please complete the captcha.";
        return;
      }

      status.textContent = "Sending...";

      try {
        const response = await fetch(workerUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: formData.get("name")?.toString().trim(),
            email: formData.get("email")?.toString().trim(),
            message: formData.get("message")?.toString().trim(),
            cf_turnstile_response: token,
          }),
        });
        const data = await response.json();

        if (response.ok) {
          status.textContent = "Message sent - thank you.";
          form.reset();
        } else {
          status.textContent = data?.error || "Failed to send message.";
        }
      } catch {
        status.textContent = "Network error.";
      }
    });
  })();
</script>
