---
interface Props {
  locale: "sl" | "en";
}

const { locale } = Astro.props as Props;
const contactFormBaseUrl =
  import.meta.env.PUBLIC_CONTACT_FORM_URL || "https://contactform.kuem.si/";
const contactFormEnglishUrl =
  import.meta.env.PUBLIC_CONTACT_FORM_URL_EN ||
  new URL("/en", contactFormBaseUrl).toString();
const contactFormUrl =
  locale === "en" ? contactFormEnglishUrl : contactFormBaseUrl;
---

{
  contactFormUrl ? (
    <section class="contact-form" aria-label="Contact form">
      <iframe
        src={contactFormUrl}
        title="KUEM contact form"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      />
    </section>
  ) : (
    <p class="contact-form-error" role="alert">
      The contact form is temporarily unavailable.
    </p>
  )
}

<style>
  .contact-form {
    width: min(100% - 2rem, 1180px);
    margin: 2rem auto;
    overflow: hidden;
    border: 1px solid rgba(91, 141, 239, 0.25);
    border-radius: 1rem;
    background: var(--surface);
  }

  .contact-form iframe {
    display: block;
    width: 100%;
    height: 850px;
    border: 0;
  }

  .contact-form-error {
    width: min(100% - 2rem, 1180px);
    margin: 2rem auto;
  }

  @media (max-width: 640px) {
    .contact-form iframe {
      height: 1000px;
    }
  }
</style>
