---
const { type } = Astro.props as { type: "ecosystem" | "deployment" | "network" | "integration" | "overview" };
---
<svg class="capability-icon" viewBox="0 0 28 28" aria-hidden="true">
  {type === "ecosystem" && <><rect x="3.5" y="3.5" width="7" height="7"></rect><rect x="17.5" y="3.5" width="7" height="7"></rect><rect x="10.5" y="17.5" width="7" height="7"></rect><path d="M10.5 7h7M7 10.5l5 7M21 10.5l-5 7"></path></>}
  {type === "deployment" && <><rect x="3.5" y="14.5" width="9" height="9"></rect><path d="M6.5 18h3M6.5 21h3M15 21.5h7.5a3 3 0 0 0 .4-6 5 5 0 0 0-9.6-1.2"></path></>}
  {type === "network" && <><circle cx="5" cy="14" r="2.5"></circle><circle cx="14" cy="5" r="2.5"></circle><circle cx="23" cy="14" r="2.5"></circle><circle cx="14" cy="23" r="2.5"></circle><path d="M7 12l5-5M16 7l5 5M21 16l-5 5M12 21l-5-5"></path></>}
  {type === "integration" && <><path d="M11 9H8a5 5 0 0 0 0 10h3M17 9h3a5 5 0 0 1 0 10h-3M9.5 14h9"></path><circle cx="14" cy="14" r="2.5"></circle></>}
  {type === "overview" && <><rect x="3.5" y="4.5" width="21" height="18" rx="1"></rect><path d="M7 17l4-4 3 2 5-6 2 2M7 8h4"></path></>}
</svg>
