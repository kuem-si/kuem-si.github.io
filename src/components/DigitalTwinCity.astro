      <circle cx="813" cy="599" r="7" class="city-sensor-glow" />
      <circle cx="959" cy="580" r="10" class="city-sensor-wave city-sensor-wave-secondary" />
      <circle cx="959" cy="580" r="10" class="city-sensor-wave city-sensor-wave-secondary city-sensor-wave-delayed" />
      <circle cx="959" cy="580" r="7" class="city-sensor-glow city-sensor-glow-secondary" />
      <path d="M813 606v18m0-18 7-5m144-23v18m0-18-7-5" class="city-sensor-mount" />
      <rect x="805" y="591" width="17" height="15" rx="2" class="city-counter-housing" />
      <rect x="808" y="594" width="11" height="7" rx="1" class="city-counter-display" />
      <text x="813.5" y="599.5" class="city-counter-digits">124</text>
      <circle cx="817" cy="603" r="1.2" class="city-sensor-led" />
      <rect x="951" y="572" width="17" height="15" rx="2" class="city-counter-housing" />
      <rect x="954" y="575" width="11" height="7" rx="1" class="city-counter-display" />
