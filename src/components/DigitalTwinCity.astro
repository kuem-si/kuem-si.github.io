---
interface Props {
  locale: "sl" | "en";
}

const { locale } = Astro.props;
const en = locale === "en";

// Controllable lighting devices, in photo pixels (1536 × 1024). `off` is the
// unlit patch made by scripts/generate-twin-lighting.mjs, `shape` outlines the
// asset for hover and focus, and `hit` is a larger invisible target for lamps.
const lamp = (x: number, top: number, bottom: number) => ({
  shape: `M${x - 6} ${top}h12v${bottom - top}h-12z`,
  hit: `M${x - 22} ${top - 8}h44v${bottom - top + 16}h-44z`,
  anchor: [x, top + 7],
});
type LightingDevice = {
  id: string;
  label: string;
  off: number[];
  shape: string;
  hit?: string;
  anchor: number[];
};
const lightingDevices: LightingDevice[] = [
  {
    id: "HOUSE_01",
    label: en ? "Garden house lighting" : "Razsvetljava hiše z vrtom",
    off: [404, 104, 158, 124],
    shape: "M406 144 442 124 507 100 545 141 540 150 557 168 553 195 540 207 480 221 415 213 410 160Z",
    anchor: [476, 120],
  },
  {
    id: "OFFICE_01",
    label: en ? "Office building lighting" : "Razsvetljava poslovne stavbe",
    off: [972, 144, 190, 90],
    shape: "M984 95 1162 101 1173 142 1171 233 972 230 973 150Z",
    anchor: [1074, 122],
  },
  {
    id: "FACTORY_01",
    label: en ? "Factory lighting" : "Razsvetljava tovarne",
    off: [340, 424, 290, 124],
    shape: "M335 436 412 358 623 386 622 540 560 540 430 528 335 512Z",
    anchor: [604, 468],
  },
  { id: "LAMP_01", label: en ? "Street light 1" : "Ulična svetilka 1", off: [612, 280, 72, 116], ...lamp(646.5, 294, 380) },
  { id: "LAMP_02", label: en ? "Street light 2" : "Ulična svetilka 2", off: [986, 304, 70, 76], ...lamp(1018.5, 316, 364) },
  { id: "LAMP_03", label: en ? "Street light 3" : "Ulična svetilka 3", off: [668, 392, 84, 98], ...lamp(703, 401, 465) },
  { id: "LAMP_04", label: en ? "Street light 4" : "Ulična svetilka 4", off: [1172, 504, 74, 100], ...lamp(1207.5, 518, 585) },
];
// Asphalt copied from further down the lane, covering the figure baked into
// the southbound lane so animated traffic never drives through it.
const lanePatch =
  "data:image/webp;base64,";
---

<div class="city-art city-art--modular" data-city-art>
  <img
    class="city-photo"
    src="/images/digital-twin-city-modular.png"
    width="1536"
    height="1024"
    alt={
      en
        ? "Photorealistic 60 by 60 centimetre miniature city maquette assembled from four 30 by 30 centimetre modules: homes, civic square, factory, river and bridge"
        : "Fotorealistična maketa mesta velikosti 60 × 60 cm, sestavljena iz štirih modulov velikosti 30 × 30 cm: hiše, javni trg, tovarna, reka in most"
    }
    fetchpriority="high"
  />
  <svg class="city-traffic" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <image href={lanePatch} x="703" y="498" width="21" height="32" />
    <g data-traffic-layer></g>
  </svg>
  <svg class="city-lighting" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    {lightingDevices.map(({ id, off: [x, y, width, height] }) => (
      <image class="city-light-off" data-light-off={id} href={`/images/digital-twin/lights/${id.toLowerCase()}-off.webp`} x={x} y={y} width={width} height={height} />
    ))}
  </svg>
  <svg class="city-devices" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMid slice" role="group" aria-label={en ? "Remotely controlled lighting" : "Daljinsko upravljana razsvetljava"}>
    {lightingDevices.map(({ id, label, shape, hit, anchor }) => (
      <g class="city-device" data-device={id} data-anchor={anchor.join(" ")} role="button" tabindex="0" aria-pressed="false" aria-label={`${label}, ${id}`}>
        {hit && <path class="city-device-hit" d={hit} />}
        <path class="city-device-shape" d={shape} />
      </g>
    ))}
  </svg>
  <div class="city-device-chip" aria-hidden="true" data-device-chip><b></b><i></i><span></span></div>
  <div class="city-module-guides" aria-hidden="true">
    <span class="city-module-label city-module-label--a">A <small>{en ? "RESIDENTIAL" : "STANOVANJSKI"}</small></span>
    <span class="city-module-label city-module-label--b">B <small>{en ? "PUBLIC SPACE" : "JAVNI PROSTOR"}</small></span>
    <span class="city-module-label city-module-label--c">C <small>{en ? "INDUSTRY" : "INDUSTRIJA"}</small></span>
    <span class="city-module-label city-module-label--d">D <small>{en ? "WATER & INFRASTRUCTURE" : "VODA IN INFRASTRUKTURA"}</small></span>
  </div>
  <div class="city-scene-controls" aria-label={en ? "Interactive module sensors" : "Interaktivni senzorji modulov"}>
    <button class="city-scene-control city-scene-sensor city-scene-water-level" type="button" data-scene-sensor="water-level" aria-describedby="city-popover-water"><span>↕</span><small>{en ? "LEVEL" : "GLADINA"}</small></button>
    <button class="city-scene-control city-scene-sensor city-scene-air" type="button" data-scene-sensor="air" aria-describedby="city-popover-air"><span>PM</span><small>{en ? "AIR" : "ZRAK"}</small></button>
    <button class="city-scene-control city-scene-sensor city-scene-water" type="button" data-scene-sensor="water-meter" aria-describedby="city-popover-house-water"><span>H₂O</span><small>{en ? "METER" : "VODOMER"}</small></button>
    <button class="city-scene-control city-scene-sensor city-scene-gas" type="button" data-scene-sensor="gas-meter" aria-describedby="city-popover-factory-gas"><span>GAS</span><small>{en ? "METER" : "PLINOMER"}</small></button>
    <button class="city-scene-control city-scene-sensor city-scene-electricity" type="button" data-scene-sensor="electricity" aria-describedby="city-popover-electricity"><span>kWh</span><small>{en ? "POWER" : "ELEKTRIKA"}</small></button>
    <button class="city-scene-control city-scene-sensor city-scene-cyclists" type="button" data-scene-sensor="cyclists" aria-describedby="city-popover-cyclists"><span>↗</span><small>{en ? "CYCLE" : "KOLESARJI"}</small></button>
  </div>

  <div class="city-sensor-popover city-popover-vibration" id="city-popover-vibration" role="tooltip" data-sensor-popover="vibration">
    <div class="city-popover-top"><i></i>{en ? "LIVE SENSOR" : "TIPALO V ŽIVO"}<span>BRIDGE_VIB_01</span></div>
    <strong>{en ? "Bridge vibration" : "Tresljaji mostu"}</strong>
    <div class="city-popover-reading"><b id="city-popover-vibration-value">0.42 mm/s</b><small>{en ? "Normal range" : "Običajno območje"}</small></div>
  </div>
  <div class="city-sensor-popover city-popover-house-water" id="city-popover-house-water" role="tooltip" data-sensor-popover="house-water">
    <div class="city-popover-top"><i></i>{en ? "LIVE METER" : "MERILNIK V ŽIVO"}<span>HOUSE_WATER_01</span></div>
    <strong>{en ? "Garden house water" : "Poraba vode · hiša"}</strong>
    <div class="city-popover-reading"><b id="city-popover-house-water-value">0.84 m³/d</b><small>{en ? "Daily flow" : "Dnevni pretok"}</small></div>
  </div>
  <div class="city-sensor-popover city-popover-office-water" id="city-popover-office-water" role="tooltip" data-sensor-popover="office-water">
    <div class="city-popover-top"><i></i>{en ? "LIVE METER" : "MERILNIK V ŽIVO"}<span>OFFICE_WATER_01</span></div>
    <strong>{en ? "Office water" : "Poraba vode · pisarna"}</strong>
    <div class="city-popover-reading"><b id="city-popover-office-water-value">12.6 m³/d</b><small>{en ? "Daily flow" : "Dnevni pretok"}</small></div>
  </div>
  <div class="city-sensor-popover city-popover-factory-gas" id="city-popover-factory-gas" role="tooltip" data-sensor-popover="factory-gas">
    <div class="city-popover-top"><i></i>{en ? "LIVE METER" : "MERILNIK V ŽIVO"}<span>FACTORY_GAS_01</span></div>
    <strong>{en ? "Factory gas" : "Poraba plina · tovarna"}</strong>
    <div class="city-popover-reading"><b id="city-popover-factory-gas-value">34.2 m³/h</b><small>{en ? "Current flow" : "Trenutni pretok"}</small></div>
  </div>
  <div class="city-sensor-popover city-popover-electricity" id="city-popover-electricity" role="tooltip" data-sensor-popover="electricity">
    <div class="city-popover-top"><i></i>{en ? "LIVE METER" : "MERILNIK V ŽIVO"}<span>FACTORY_POWER_01</span></div>
    <strong>{en ? "Electricity use · factory" : "Poraba elektrike · tovarna"}</strong>
    <div class="city-popover-reading"><b id="city-popover-electricity-value">18.6 kWh</b><small>{en ? "Current day" : "Danes"}</small></div>
  </div>
  <div class="city-sensor-popover city-popover-water" id="city-popover-water" role="tooltip" data-sensor-popover="water">
    <div class="city-popover-top"><i></i>{en ? "LIVE SENSOR" : "TIPALO V ŽIVO"}<span>RIVER_LEVEL_01</span></div>
    <strong>{en ? "River level" : "Gladina reke"}</strong>
    <div class="city-popover-reading"><b id="city-popover-water-value">1.36 m</b><small>{en ? "Current level" : "Trenutna gladina"}</small></div>
  </div>
  <div class="city-sensor-popover city-popover-air" id="city-popover-air" role="tooltip" data-sensor-popover="air">
    <div class="city-popover-top"><i></i>{en ? "LIVE SENSOR" : "TIPALO V ŽIVO"}<span>AIR_QUALITY_01</span></div>
    <strong>{en ? "Air quality" : "Kakovost zraka"}</strong>
    <div class="city-popover-grid"><span>PM10<b id="city-popover-air-pm10">18 µg/m³</b></span><span>{en ? "Temperature" : "Temperatura"}<b id="city-popover-air-temp">18.7 °C</b></span><span>{en ? "Humidity" : "Vlaga"}<b id="city-popover-air-humidity">56 %</b></span></div>
  </div>
  <div class="city-sensor-popover city-popover-cyclists" id="city-popover-cyclists" role="tooltip" data-sensor-popover="cyclists">
    <div class="city-popover-top"><i></i>{en ? "LIVE SENSOR" : "TIPALO V ŽIVO"}<span>CYCLE_COUNT_01</span></div>
    <strong>{en ? "Cyclist counter" : "Števec kolesarjev"}</strong>
    <div class="city-popover-reading"><b id="city-popover-cyclists-value">124</b><small>{en ? "Passages today" : "Prehodov danes"}</small></div>
  </div>
</div>
