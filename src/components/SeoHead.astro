---
import JsonLd from "./JsonLd.astro";
import { PUBLIC_CONTACT_ENDPOINT } from "astro:env/client";
import { alternatePath, getLocaleFromPath } from "../lib/i18n";
import { ensureTrailingSlash } from "../lib/paths";
import { organization, website } from "../data/organization";
import sourceSansLatin from "../assets/brand/fonts/SourceSans3-latin-variable.woff2";
import sourceSansLatinExt from "../assets/brand/fonts/SourceSans3-latin-ext-variable.woff2";
import spaceGroteskLatin from "../assets/brand/fonts/SpaceGrotesk-latin-variable.woff2";
import spaceGroteskLatinExt from "../assets/brand/fonts/SpaceGrotesk-latin-ext-variable.woff2";
import globalCssUrl from "../styles/global.css?url";
import criticalCss from "../styles/critical.css?raw";
const {
  title,
  description,
  pathname = Astro.url.pathname,
  image = "/og-image.png",
  noindex = false,
  jsonLd = [] as unknown[],
} = Astro.props;
const locale = getLocaleFromPath(pathname);
const canonical = new URL(ensureTrailingSlash(pathname), Astro.site);
const alternate = new URL(ensureTrailingSlash(alternatePath(pathname)), Astro.site);
const fullTitle = title.includes("KUEM") ? title : `${title} | KUEM`;
const otherLocale = locale === "sl" ? "en" : "sl";
const langTag = locale === "sl" ? "sl-SI" : "en-GB";
const otherLangTag = otherLocale === "sl" ? "sl-SI" : "en-GB";
// Each family ships as the two @fontsource-variable 5.3.0 subsets: Latin
// (a–z, digits, punctuation) and Latin Extended (č, š, ž). The unicode-range
// values are fontsource's, so a browser downloads a subset only for pages
// that use its characters. scripts/check-fonts.mjs checks the coverage.
const latinRange =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const latinExtRange =
  "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF";
const fonts = [
  {
    family: "Space Grotesk",
    weight: "300 700",
    latin: spaceGroteskLatin,
    latinExt: spaceGroteskLatinExt,
  },
  {
    family: "Source Sans 3",
    weight: "200 900",
    latin: sourceSansLatin,
    latinExt: sourceSansLatinExt,
  },
];
const fontFaces = fonts
  .flatMap(({ family, weight, latin, latinExt }) =>
    [
      [latinExt, latinExtRange],
      [latin, latinRange],
    ].map(
      ([src, range]) =>
        `\n@font-face{font-family:"${family}";src:url("${src}") format("woff2");font-weight:${weight};font-display:swap;unicode-range:${range}}`,
    ),
  )
  .join("");
// Slovenian pages draw č, š and ž on first paint, so they preload both subsets.
const preloadFonts = fonts.flatMap(({ latin, latinExt }) =>
  locale === "sl" ? [latin, latinExt] : [latin],
);
const criticalStyle = fontFaces + criticalCss;
const endpointOrigin = PUBLIC_CONTACT_ENDPOINT
  ? new URL(PUBLIC_CONTACT_ENDPOINT).origin
  : null;
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self'${endpointOrigin ? ` ${endpointOrigin}` : ""}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join("; ");
const pageNode: Record<string, unknown> = {
  "@type": "WebPage",
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: fullTitle,
  description,
  inLanguage: langTag,
  isPartOf: { "@id": website["@id"] },
  primaryImageOfPage: new URL(image, Astro.site).href,
};
const firstEntity = jsonLd[0] as { "@id"?: string } | undefined;
if (firstEntity?.["@id"]) {
  pageNode.mainEntity = { "@id": firstEntity["@id"] };
}
const structuredData = [
  organization,
  {
    ...website,
    url: canonical.href,
    inLanguage: langTag,
  },
  pageNode,
  ...jsonLd,
];
---

<meta charset="UTF-8" /><meta
  name="viewport"
  content="width=device-width, initial-scale=1"
/><meta http-equiv="Content-Security-Policy" content={csp} /><meta
  name="color-scheme"
  content="light"
/><meta
  name="theme-color"
  content="#161a1d"
/><title>{fullTitle}</title><meta name="description" content={description} /><meta
  name="robots"
  content={noindex
    ? "noindex,follow"
    : "index,follow,max-image-preview:large,max-snippet:-1"}
/><link
  rel="canonical"
  href={canonical}
/><link rel="alternate" hreflang={langTag} href={canonical} />{
  !noindex && (
    <><link rel="alternate" hreflang={otherLangTag} href={alternate} /><link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.site)}
    /></>
  )
}
<meta property="og:type" content="website" /><meta
  property="og:site_name"
  content="KUEM"
/><meta property="og:title" content={fullTitle} /><meta
  property="og:description"
  content={description}
/><meta property="og:url" content={canonical} /><meta
  property="og:image"
  content={new URL(image, Astro.site)}
/><meta property="og:image:alt" content={fullTitle} /><meta
  property="og:image:width"
  content="1200"
/><meta property="og:image:height" content="630" /><meta
  property="og:image:type"
  content="image/png"
/><meta
  property="og:locale"
  content={locale === "sl" ? "sl_SI" : "en_GB"}
/><meta
  property="og:locale:alternate"
  content={otherLocale === "sl" ? "sl_SI" : "en_GB"}
/><meta name="twitter:card" content="summary_large_image" /><meta
  name="twitter:title"
  content={fullTitle}
/><meta name="twitter:description" content={description} /><meta
  name="twitter:image"
  content={new URL(image, Astro.site)}
/><meta name="twitter:image:alt" content={fullTitle} /><style is:inline set:html={criticalStyle}></style
><link rel="preload" as="style" href={globalCssUrl} /><link
  rel="stylesheet"
  href={globalCssUrl}
  media="print"
  onload="this.media='all'"
/><noscript><link rel="stylesheet" href={globalCssUrl} /></noscript><link
  rel="icon"
  href="/favicon.svg"
/>{
  preloadFonts.map((href) => (
    <link
      rel="preload"
      href={href}
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
  ))
}<JsonLd data={structuredData} />
