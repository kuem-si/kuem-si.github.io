# Optional production form endpoint. It must accept JSON POST requests.
PUBLIC_CONTACT_ENDPOINT=

# Odoo base URL; the contact form creates leads in Odoo CRM. Defaults to
# https://contactform.kuem.si (Cloudflare DNS record pointing at the Odoo
# instance; keeps the form on the kuem.si domain). Requires the Odoo Website and CRM apps.
# PUBLIC_ODOO_URL=https://contactform.kuem.si
